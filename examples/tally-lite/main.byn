import money
import ledger

/// The sample trip: four friends, eight shared expenses, in MYR.
List<ledger.Expense> sampleTrip() fails money.MoneyError {
    var trip = List<ledger.Expense>()
    trip.append(try expense("360.00", from: "alice", for: ["alice", "bob", "chen", "dina"]))
    trip.append(try expense("85.50", from: "bob", for: ["alice", "bob", "chen", "dina"]))
    trip.append(try expense("42.75", from: "chen", for: ["alice", "chen", "dina"]))
    trip.append(try expense("36.10", from: "dina", for: ["alice", "bob", "chen", "dina"]))
    trip.append(try expense("48.00", from: "alice", for: ["alice", "bob", "dina"]))
    trip.append(try expense("99.26", from: "bob", for: ["alice", "bob"]))
    trip.append(try expense("65.54", from: "chen", for: ["alice", "chen"]))
    trip.append(try expense("45.44", from: "dina", for: ["alice", "dina"]))
    return trip
}

ledger.Expense expense(string amount, from string payer, for move List<string> among) fails money.MoneyError {
    return {
        payer: payer,
        amount: try money.parseAmount(amount),
        participants: move among,
    }
}

void main() fails money.MoneyError {
    using var arena = Arena()
    provide allocator: arena {
        let trip = try sampleTrip()
        let owed = ledger.balances(trip)
        for t in ledger.settle(owed) {
            let paid: money.Money = { cents: t.cents, currency: "MYR" }
            print($"{t.from} pays {t.to} {paid}")
        }
    }
}
