import parser

enum MemberRefKind {
    none
    field
    propertyKeyword
    method
}

// The C# `Symbol?` `lookupMember` returns: a field, property or method of a type, by its arena id.
struct MemberRef {
    MemberRefKind kind
    i64 id = -1
}

