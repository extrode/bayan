// The shared state of the self-hosted checker: handles into the arenas, the per-file and per-module
// records, the diagnostic bag, the deferred-work item and the binder's cursors. Every type another
// semantics file names lives here; T3/T4 extend `Ctx` with arenas and the file is frozen after T4.
//
// The C# keeps this state in `Compilation` (`src/Bayan.Semantics/Compilation.cs`: the module list,
// the diagnostic bag, the sinks, the options), in `FileContext` (`Symbols/Symbols.cs:69-80`: the
// tree, the module, the imports) and in `Binder`. A handle is an index into an arena; -1 is C#'s
// `null`. `Type` and the bound handles encode `(kind << 32) | index`.

import lexer
import parser

type TextSpan = lexer.TextSpan
type CompilationUnit = parser.CompilationUnit

// ── Handles ─────────────────────────────────────────────────────────────────────

/// A `Ctx.files` index.
type FileId = i64
/// A `Ctx.modules` index.
type ModId = i64
type StructId = i64
type InterfaceId = i64
type ErrorSetId = i64
type EnumId = i64
type UnionId = i64
type FuncId = i64
type LocalId = i64
type ConstId = i64
type TypeParamId = i64
type FieldId = i64
type PropertyId = i64
type VariantId = i64
type TestId = i64
type ConformanceId = i64
type AliasId = i64
type EnumFieldId = i64
type EnumMemberId = i64
/// `(TypeKind << 32) | index`; canonical, so C#'s structural equality is handle equality.
type Type = i64
/// `(BoundKind << 32) | index` into T4's bound arenas.
type BExpr = i64
type BStmt = i64
type BPattern = i64

// ── Files and modules ───────────────────────────────────────────────────────────

/// One source the checker reads: a `.byn` file, a parsed `"<builtin>"` source, or `"package.byn"`.
/// The C# `FileContext`: one file's tree and the imports visible in it (Q521).
struct SourceFile {
    /// The path the loader opened.
    string path
    /// The path diagnostics print, relative to the project root.
    string displayPath
    /// The bytes the parser read.
    List<u8> text
    CompilationUnit unit
    /// The module whose files this one belongs to.
    ModId module = -1
    /// The entry module's files, which hold `main` or the top-level statements.
    bool isEntry = false
    /// A `tests/*.test.byn` file; the C# `FileContext.IsTestFile`.
    bool isTestFile = false
    /// The modules this file imports, by the name it uses (the C# `FileContext.Imports`).
    Map<string, ModId> imports
}

/// A directory of files that one `import` names.
struct Mod {
    string name
    List<FileId> files
    /// The directory the module's files came from (the C# `ModuleSymbol.Directory`).
    string directory = ""
    /// The name used in emitted C identifiers (the C# `ModuleSymbol.CName`).
    string cName = ""
    /// Named types by their declared name (the C# `ModuleSymbol.Types`).
    Map<string, Type> types = []
    /// Functions by name; one name may be overloaded (the C# `ModuleSymbol.Functions`).
    Map<string, List<FuncId>> functions = []
    /// Constants by name (the C# `ModuleSymbol.Constants`).
    Map<string, ConstId> constants = []
    List<StructId> structs = List<StructId>()
    List<ErrorSetId> errorSets = List<ErrorSetId>()
    List<EnumId> enums = List<EnumId>()
    List<UnionId> unions = List<UnionId>()
    List<InterfaceId> interfaces = List<InterfaceId>()
    List<FuncId> allFunctions = List<FuncId>()
    List<TestId> tests = List<TestId>()
    List<ConstId> allConstants = List<ConstId>()
    /// The implicit `main` built from top-level statements, or an explicit `main`; -1 when absent.
    FuncId main = -1
}

// ── Diagnostics ─────────────────────────────────────────────────────────────────

/// A secondary span under a diagnostic, underlined with `---` (the C# `RelatedSpan`).
struct Related {
    TextSpan span
    string label
}

/// A compiler diagnostic (the C# `Diagnostic`): a code, a place, an optional fix and related spans.
/// An empty `label` or `help` is C#'s `null`; `file` is -1 for a diagnostic with no location.
struct Diag {
    string code = ""
    FileId file = -1
    TextSpan span
    string message
    string label = ""
    string help = ""
    bool isWarning = false
    bool hasFix = false
    TextSpan fixSpan
    string fixReplacement = ""
    List<Related> related
}

/// A nested diagnostic sink (the C# `PushBag`): its items and the bag it was pushed over.
struct DiagBag {
    List<Diag> items
    /// The `Ctx.bags` index of the enclosing bag, or -1 for the outermost.
    i64 previous = -1
}

// ── Deferred work ──────────────────────────────────────────────────────────────

/// What T11's `drain` does with a `Work` item.
enum WorkKind {
    /// A `where` clause to check; drained by `declare`.
    where
    keyCheck
    constraint
    interfaceMembers
    members
    unionVariants
    conform
    fieldDefault
    bindFunction
}

/// One deferred check (the C# `Work` record): a kind, the type it is about and where it came from.
struct Work {
    WorkKind kind
    Type subject = -1
    List<Type> args
    /// The instantiated function a `bindFunction` item binds, or -1.
    FuncId instance = -1
    FileId file = -1
    TextSpan span
    i64 declIndex = -1
    i64 memberIndex = -1
    /// C# `AfterMembersDeclared` wraps the check in `Instantiating(site, span, check)` when `_instantiationSite` is
    /// set (Compilation.cs:1550): `atSite` says it was, `siteFile`/`siteSpan` hold that site (Q716, dispatcher 2026-10-31).
    bool atSite = false
    FileId siteFile = -1
    TextSpan siteSpan = TextSpan { start: 0, length: 0 }
}

/// A `break`/`continue` target: a label if it has one, and whether it belongs to a loop.
struct JumpTarget {
    string? label = null
    bool isLoop = false
    i64 id = -1
}

// ── The 128-bit integer ────────────────────────────────────────────────────────

/// A 128-bit two's-complement integer, as `lo` (low 64 bits) and `hi` (high 64 bits). Bayan has no
/// `i128`, and `PrimitiveType.Range` returns one (Q540); T5 owns the operations.
struct Big {
    u64 lo
    u64 hi
}

/// A parsed `Big`, or why it is not one: `ok` is false for a syntax error, `overflow` for a value
/// outside the 128-bit range.
struct BigParse {
    Big value
    bool ok = false
    bool overflow = false
}

// ── Constructed-type data (T3) ────────────────────────────────────────────────

/// The parts of a `Span<T>` / `ReadOnlySpan<T>`.
struct SpanData {
    Type element
    bool readOnly
}

/// The parts of a `dyn ref [readonly] I`.
struct DynRefData {
    InterfaceId iface
    bool readOnly
}

/// The key and value of a `Map<K, V>`.
struct MapData {
    Type key
    Type value
}

/// The element and length of a `T[N]`.
struct ArrayData {
    Type element
    i64 length
}

/// One field of a tuple type; `name` is null for an unnamed element.
struct TupleField {
    string? name = null
    Type type
}

/// The parts of a function type `(A, B) -> R fails E uses net`.
struct FunctionData {
    List<Type> parameters
    Type ret
    List<ErrorSetId> errorSets
    List<string> effects
}

/// The value and error of a `Result<T, E>`.
struct ResultData {
    Type value
    Type error
}

/// The struct and known states of a state type.
struct StateData {
    StructId s
    List<VariantId> states
}

/// The sets and excluded variants of an error union.
struct ErrorUnionData {
    List<ErrorSetId> sets
    List<VariantId> excluded
}

// ── The checker's state ────────────────────────────────────────────────────────

/// Everything a pass reads and writes. T3 adds the symbol/type arenas and their caches, T4 the bound
/// arenas; one owner per field.
/// Where a piece of syntax lives, for state the C# keeps as syntax references (Q714): `c.files[file].unit.members[declIndex]`,
/// then member `memberIndex`, item `itemIndex` and sub-item `subIndex` as the owning task documents; -1 where unused.
struct SyntaxRef {
    FileId file = -1
    i64 declIndex = -1
    i64 memberIndex = -1
    i64 itemIndex = -1
    i64 subIndex = -1
}

/// C# `_exitCodes` entry: a variant and its `@exitCode` attribute (Q714).
struct ExitCodeRef {
    VariantId variant = -1
    SyntaxRef attribute
}

/// C# `_testBodies` value: the test's declaration and, for a `@cases` test, the case whose values it binds (Q714).
struct TestBody {
    SyntaxRef decl
    bool hasValues = false
    SyntaxRef values
}

struct Ctx {
    List<SourceFile> files
    List<Mod> modules
    List<Diag> diagnostics
    /// Nested sinks; empty for the outermost.
    List<DiagBag> bags
    /// The bag index new diagnostics go to, or -1 for `diagnostics`.
    i64 sink = -1
    /// Whether diagnostics are dropped rather than kept (the C# `_quiet`).
    bool quiet = false
    /// A library has no `main`, so none is required.
    bool library = false
    /// The package's `capabilities`, the upper bound on its effects (§13); null for no bound.
    List<string>? capabilities = null
    /// The package's name, for BYN6004; empty when there is none.
    string packageName = ""

    // ── T3: symbol arenas (one per `Symbols.cs` class plus `AliasPlaceholder`) ──
    List<StructSymbol> structs = List<StructSymbol>()
    List<FieldSymbol> fields = List<FieldSymbol>()
    List<PropertySymbol> properties = List<PropertySymbol>()
    List<FunctionSymbol> functions = List<FunctionSymbol>()
    List<InterfaceSymbol> interfaces = List<InterfaceSymbol>()
    List<Conformance> conformances = List<Conformance>()
    List<LocalSymbol> locals = List<LocalSymbol>()
    List<ConstSymbol> consts = List<ConstSymbol>()
    List<ErrorSetSymbol> errorSets = List<ErrorSetSymbol>()
    List<ErrorVariantSymbol> errorVariants = List<ErrorVariantSymbol>()
    List<TestSymbol> tests = List<TestSymbol>()
    List<EnumSymbol> enums = List<EnumSymbol>()
    List<EnumFieldSymbol> enumFields = List<EnumFieldSymbol>()
    List<EnumMemberSymbol> enumMembers = List<EnumMemberSymbol>()
    List<UnionSymbol> unions = List<UnionSymbol>()
    List<UnionVariantSymbol> unionVariants = List<UnionVariantSymbol>()
    List<TypeParam> typeParams = List<TypeParam>()
    List<AliasPlaceholder> aliases = List<AliasPlaceholder>()

    // ── T3: constructed-type arenas (one per constructed kind) ──
    List<Type> optionalTypes = List<Type>()
    List<SpanData> spanTypes = List<SpanData>()
    List<DynRefData> dynRefTypes = List<DynRefData>()
    List<Type> listTypes = List<Type>()
    List<MapData> mapTypes = List<MapData>()
    List<Type> ownedTypes = List<Type>()
    List<Type> untrustedTypes = List<Type>()
    List<ArrayData> arrayTypes = List<ArrayData>()
    List<Type> rangeTypes = List<Type>()
    List<List<TupleField>> tupleTypes = List<List<TupleField>>()
    List<FunctionData> functionTypes = List<FunctionData>()
    List<ResultData> resultTypes = List<ResultData>()
    List<StateData> stateTypes = List<StateData>()
    List<ErrorUnionData> errorUnionTypes = List<ErrorUnionData>()

    // ── T3: interning caches (one `Map` per constructed kind) ──
    Map<string, i64> optionalIntern = []
    Map<string, i64> spanIntern = []
    Map<string, i64> dynRefIntern = []
    Map<string, i64> listIntern = []
    Map<string, i64> mapIntern = []
    Map<string, i64> ownedIntern = []
    Map<string, i64> untrustedIntern = []
    Map<string, i64> arrayIntern = []
    Map<string, i64> rangeIntern = []
    Map<string, i64> tupleIntern = []
    Map<string, i64> functionIntern = []
    Map<string, i64> resultIntern = []
    Map<string, i64> stateIntern = []
    Map<string, i64> errorUnionIntern = []

    /// While set, declared types display with their module (`a.Point`); the C# `[ThreadStatic] QualifyModules`.
    bool qualifyModules = false
    /// Effect/verb/noun/adjective names (T6 fills them).
    List<string> lexiconVerbs = List<string>()
    List<string> lexiconNouns = List<string>()
    List<string> lexiconAdjectives = List<string>()

    // ── T3+: shared caches (the owner task fills them) ──
    /// T5: template handle -> instance handle.
    Map<i64, i64> instances = []
    /// T5: the instantiation worklist.
    List<Work> instantiationWork = List<Work>()
    List<Work> pendingKeys = List<Work>()
    List<Work> pendingConstraints = List<Work>()
    Map<i64, i64> states = []
    Map<i64, i64> distinct = []
    Map<i64, i64> positional = []
    Map<i64, i64> invokeSymbols = []
    Map<i64, i64> validationErrors = []
    Map<i64, i64> conformancesChecked = []

    // ── Bound arenas (T4): one per node struct of bound.byn, in `BoundKind` order ──
    List<BLiteral> bLiterals = List<BLiteral>()
    List<BSymbolLiteral> bSymbolLiterals = List<BSymbolLiteral>()
    List<BDefault> bDefaults = List<BDefault>()
    List<BLocal> bLocals = List<BLocal>()
    List<BThis> bThises = List<BThis>()
    List<BField> bFields = List<BField>()
    List<BTupleElement> bTupleElements = List<BTupleElement>()
    List<BCall> bCalls = List<BCall>()
    List<BBuiltinCall> bBuiltinCalls = List<BBuiltinCall>()
    List<BUnary> bUnaries = List<BUnary>()
    List<BBinary> bBinaries = List<BBinary>()
    List<BConversion> bConversions = List<BConversion>()
    List<BTryFrom> bTryFroms = List<BTryFrom>()
    List<BConditional> bConditionals = List<BConditional>()
    List<BCoalesce> bCoalesces = List<BCoalesce>()
    List<BStructLiteral> bStructLiterals = List<BStructLiteral>()
    List<BWith> bWiths = List<BWith>()
    List<BTuple> bTuples = List<BTuple>()
    List<BCollection> bCollections = List<BCollection>()
    List<BSpread> bSpreads = List<BSpread>()
    List<BIndex> bIndexes = List<BIndex>()
    List<BSlice> bSlices = List<BSlice>()
    List<BRange> bRanges = List<BRange>()
    List<BIs> bIses = List<BIs>()
    List<BSwitchExpr> bSwitchExprs = List<BSwitchExpr>()
    List<BInterpolated> bInterpolateds = List<BInterpolated>()
    List<BMove> bMoves = List<BMove>()
    List<BTry> bTries = List<BTry>()
    List<BCatch> bCatches = List<BCatch>()
    List<BJump> bJumps = List<BJump>()
    List<BBlockExpr> bBlockExprs = List<BBlockExpr>()
    List<BErrorVariant> bErrorVariants = List<BErrorVariant>()
    List<BEnumMember> bEnumMembers = List<BEnumMember>()
    List<BUnionNew> bUnionNews = List<BUnionNew>()
    List<BEnumValues> bEnumValues = List<BEnumValues>()
    List<BStaticArray> bStaticArrays = List<BStaticArray>()
    List<BStackalloc> bStackallocs = List<BStackalloc>()
    List<BErrorExpr> bErrorExprs = List<BErrorExpr>()
    List<BTypeRef> bTypeRefs = List<BTypeRef>()
    List<BModuleRef> bModuleRefs = List<BModuleRef>()
    List<BLambda> bLambdas = List<BLambda>()
    List<BFunctionRef> bFunctionRefs = List<BFunctionRef>()
    List<BBlock> bBlocks = List<BBlock>()
    List<BLocalDecl> bLocalDecls = List<BLocalDecl>()
    List<BExprStmt> bExprStmts = List<BExprStmt>()
    List<BAssign> bAssigns = List<BAssign>()
    List<BReturn> bReturns = List<BReturn>()
    List<BFail> bFails = List<BFail>()
    List<BBecome> bBecomes = List<BBecome>()
    List<BBreak> bBreaks = List<BBreak>()
    List<BContinue> bContinues = List<BContinue>()
    List<BIf> bIfs = List<BIf>()
    List<BWhile> bWhiles = List<BWhile>()
    List<BDoWhile> bDoWhiles = List<BDoWhile>()
    List<BFor> bFors = List<BFor>()
    List<BSwitch> bSwitches = List<BSwitch>()
    List<BDefer> bDefers = List<BDefer>()
    List<BAssert> bAsserts = List<BAssert>()
    List<BErrdefer> bErrdefers = List<BErrdefer>()
    List<BPanicDefer> bPanicDefers = List<BPanicDefer>()
    List<BSetOnPanic> bSetOnPanics = List<BSetOnPanic>()
    List<BContext> bContexts = List<BContext>()
    List<BErrorStmt> bErrorStmts = List<BErrorStmt>()
    List<BConstantPattern> bConstantPatterns = List<BConstantPattern>()
    List<BRelationalPattern> bRelationalPatterns = List<BRelationalPattern>()
    List<BRangePattern> bRangePatterns = List<BRangePattern>()
    List<BBindPattern> bBindPatterns = List<BBindPattern>()
    List<BNotPattern> bNotPatterns = List<BNotPattern>()
    List<BBinaryPattern> bBinaryPatterns = List<BBinaryPattern>()
    List<BPropertyPattern> bPropertyPatterns = List<BPropertyPattern>()
    List<BUnionField> bUnionFields = List<BUnionField>()
    List<BUnionPattern> bUnionPatterns = List<BUnionPattern>()
    List<BErrorField> bErrorFields = List<BErrorField>()
    List<BErrorPattern> bErrorPatterns = List<BErrorPattern>()
    List<BMethodGroup> bMethodGroups = List<BMethodGroup>()
    List<BVariantGroup> bVariantGroups = List<BVariantGroup>()
    List<BBuiltinGroup> bBuiltinGroups = List<BBuiltinGroup>()
    /// `break`/`continue` targets; `BBreak.target` and the loop/switch `target` fields index it.
    List<JumpTarget> jumpTargets = List<JumpTarget>()
    /// C# `BoundExpr.Constant`, by expression handle.
    Map<i64, Constant> constants = []
    /// The `syntax…` bits of bound.byn (what C# reads from `BoundNode.Syntax`), by node handle.
    Map<i64, i64> syntaxFlags = []
    /// C# `Compilation.Checks`: each struct's `requires` check; `checksOf` maps a `StructId` to its index.
    List<StructChecks> checks = List<StructChecks>()
    Map<StructId, i64> checksOf = []

    // ── Shared state (Q714): written by one task, read by another; only the dispatcher adds fields here.
    /// C# `_exitCodes` (T12 fills it in `declareVariants`, T13 `bindAll` binds each).
    List<ExitCodeRef> exitCodes = List<ExitCodeRef>()
    /// C# `_mainStatements` (T11 fills it in `declareFile`, T13 `bindFunction` binds them): the synthesized `main`, or -1,
    /// and its top-level statements in order.
    FuncId mainStatementsFn = -1
    List<SyntaxRef> mainStatements = List<SyntaxRef>()
    /// C# `_testBodies` (T11 fills it in `declareFile`, T13 `bindFunction` binds each).
    Map<FuncId, TestBody> testBodies = []
    /// C# `Options.IncludeTests` and `Options.SkipOwnershipCheck` (T11 sets them when it creates the compilation).
    bool includeTests = false
    bool skipOwnershipCheck = false

    // ── Per-task state (Q710). A task adds the C# fields it needs, with defaults, only under its own marker.
    // ── T10 state
    // ── T11 state
    /// C# `PackageRoot`: imports resolve under it.
    string packageRoot = ""
    /// C# `DisplayRoot`: imported files are named relative to it.
    string displayRoot = ""
    /// C# `Modules`: every loaded module, dependencies before dependents (`modules` also holds the builtin module).
    List<ModId> moduleOrder = List<ModId>()
    /// C# `EntryModule`.
    ModId entryModule = -1
    /// C# `_modulesByDir` and `_loading`.
    Map<string, ModId> modulesByDir = []
    List<ModId> loading = List<ModId>()
    /// C# `ParseTime` and `CheckTime`, in nanoseconds.
    i64 parseTime = 0
    i64 checkTime = 0
    /// C# `_aliases`: the aliases `addType` accepted, in declaration order.
    List<AliasId> aliasOrder = List<AliasId>()
    /// C# `_testCases`: the accepted cases of each test with `@cases`, by `declKey(file, declIndex)`.
    Map<i64, TestCases> testCases = []
    /// C# `_wheres` and `_associatedTypes` (key `"<owner> <name>"`).
    List<Work> wheres = List<Work>()
    Map<string, TypeParamId> associatedTypes = []
    /// C# `MembersDeclared`.
    bool membersDeclared = false
    // ── T12 state
    // ── T13 state
    /// C# `_instances` (Q581): `t13Key` of `(Generic, Args)` to the instance (a `FuncId` or a `Type`).
    Map<string, i64> instanceKeys = []
    /// C# `_instantiating`: depth of `Instantiating` calls.
    i64 instantiating = 0
    /// C# `_instantiationSite`: whether it is set, and its file and span.
    bool hasInstantiationSite = false
    FileId instantiationSiteFile = -1
    TextSpan instantiationSiteSpan = TextSpan { start: 0, length: 0 }
    /// C# `_instantiationErrors`: what instantiation reported that is not the user's.
    List<Diag> instantiationErrors = List<Diag>()
    /// C# `_instanceAnalysisSeen` (a set): `code|file|start|length` of each instance-analysis diagnostic kept.
    Map<string, i64> instanceAnalysisSeen = []
    /// C# `_firstPass`: a `firstPasses` index, or -1 for null.
    i64 firstPass = -1
    List<FirstPass> firstPasses = List<FirstPass>()
    /// C# `RequiresChecks`.
    List<RequiresCheck> requiresChecks = List<RequiresCheck>()
    /// C# `_interfaceMembersDeclared` and `_pendingInterfaces` (`Work { kind: .interfaceMembers }`).
    bool interfaceMembersDeclared = false
    List<Work> pendingInterfaces = List<Work>()
    // ── T14 state
    // ── T15 state
    // ── T16 state
    // ── T17 state
    // ── T18 state
    // ── T19 state
    // ── T20 state
    // ── T21 state
    // ── T22 state
    // ── T23 state
    // ── T24 state
    // ── T25 state
    // ── T26 state
    // ── T27 state
    // ── T28 state
    // ── T29 state
    // ── T30 state
    // ── T31 state
    // ── T32 state
    // ── T33 state
    // ── T34 state
    // ── T35 state
    // ── T36 state
    // ── T37 state
    // ── T38 state
    // ── T39 state
}

// ── The binder's cursors ──────────────────────────────────────────────────────

/// The C# `Binder`'s per-body state: the file and function being bound, the scopes, the jump targets
/// and the narrowing facts. Every field is a T1 handle or a parser type.
struct Binder {
    FileId file = -1
    FuncId fn = -1
    StructId owner = -1
    /// The receiver's type for `this`, or -1.
    Type thisType = -1
    i64 nextLocalId = 0
    /// The open scopes, innermost last.
    List<Map<string, LocalId>> scopes
    /// The enclosing loops and labeled statements.
    List<JumpTarget> targets
    i64 deferDepth = 0
    bool inPanicHandler = false
    /// The first statement of the body being bound, or -1.
    i64 firstStatement = -1
    bool onPanicSet = false
    /// A lambda's captured parameters, by the function it belongs to.
    List<(FuncId, List<BExpr>)> lambdas
    Map<FuncId, i64> lambdaCount
    i64 itDepth = 0
    i64 held = 0
    /// C# `_seeds`: the locals a re-bind starts from (`bindFunction`'s second pass), and their types.
    List<(i64, Type)> seeds
    /// Flow facts keyed by the `LocalDecl` span start.
    Map<i64, i64> pending
    Map<i64, i64> constraints
    Map<i64, i64> peers
    /// Locals known to be non-null, and their span start.
    List<(i64, LocalId)> nonNull
    List<(i64, LocalId, Type)> stateFacts
    /// The variant a local's error value was narrowed to.
    Map<LocalId, VariantId> errorNarrowed

    // ── Per-task binder state (Q710), as in `Ctx`.
    // ── T15 state
    /// The C# constructor's `typeArgs`, which `_types` resolves with before the function's or struct's map; null for none.
    Map<string, Type>? typeArgs = null
    /// The C# `_it`: the field whose own rule is being bound, or -1.
    FieldId itField = -1
    /// The C# `_thisFacts`: the fact key for `this`, made on first use; null until then.
    LocalId? thisFacts = null
    /// The C# `_types` map (see `typeArgs`), taken once by T15's `t15CaptureTypes`; `typesCaptured` says whether it was.
    Map<string, Type> types = []
    bool typesCaptured = false
    // ── T16 state
    // ── T17 state
    // ── T18 state
    // ── T19 state
    // ── T20 state
    // ── T21 state
    // ── T22 state
    // ── T23 state
    // ── T24 state
    // ── T25 state
    // ── T34 state
    // ── T35 state
    // ── T36 state
    // ── T37 state
    // ── T38 state
    // ── T39 state
}
