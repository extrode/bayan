// T16: Binder.cs ~500-979 (blocks, statement dispatch, assert, narrowing, while-let, for head).

import parser

// What `narrowedBegin` saved for `narrowedEnd`: the C# `Narrowed`'s `Func` split in two around the
// caller's bind. `mark` is the `nonNull` length to cut back to, `before` the state facts to keep and
// `learned` what `learnStates` added.
struct NarrowedScope {
    i64 mark
    List<(i64, LocalId, Type)> before
    List<(i64, LocalId, Type)> learned
}

