// T15: Binder.cs 1-~499 (state, scopes, locals, entry points).

import parser
import lexer

type CallExpr = parser.CallExpr
type NameExpr = parser.NameExpr
type Argument = parser.Argument

// ── Helpers ───────────────────────────────────────────────────────────────────

string t15Text(in Ctx c, from FileId f, at TextSpan span) => $"{getText(c.files[f].text.span, at: span)}"

Diag t15CloneDiag(in Diag d) {
    var rel = List<Related>()
    for r in d.related { rel.append(r) }
    return Diag {
        code: d.code,
        message: d.message,
        file: d.file,
        span: d.span,
        label: d.label,
        help: d.help,
        hasFix: d.hasFix,
        fixSpan: d.fixSpan,
        fixReplacement: d.fixReplacement,
        isWarning: d.isWarning,
        related: move rel,
    }
}

bool t15ContainsLocal(in List<LocalId> list, for LocalId id) {
    for x in list {
        if x == id { return true }
    }
    return false
}

TextSpan t15ExprSpan(in parser.Expr e) {
    switch e {
        case .literalExpr(let n): return n.value.span
        case .nameExpr(let n): return n.value.span
        case .binaryExpr(let n): return n.value.span
        case .unaryExpr(let n): return n.value.span
        case .callExpr(let n): return n.value.span
        case .parenExpr(let n): return n.value.span
        case .blockExpr(let n): return n.value.span
        case .collectionExpr(let n): return n.value.span
        case .switchExpr(let n): return n.value.span
        case .interpolatedExpr(let n): return n.value.span
        default: return TextSpan { start: 0, length: 0 }
    }
}

TextSpan t15ExpectsKeyword(in Ctx c, from FileId f, for in parser.FunctionDecl decl) {
    if decl.params.length > 0 {
        return decl.params[decl.params.length - 1].span
    }
    return decl.name
}

bool t15IsCollectionExpr(in parser.Expr e) {
    switch e {
        case .collectionExpr(let n): return true
        default: return false
    }
}

// ── Entry points ──────────────────────────────────────────────────────────────

// stub: T15 ports Binder.cs:40 BindFunctionBody
void bindFunctionBody(ref Binder b, through ref Ctx c, for in parser.FunctionDecl decl) {
    var pList = List<LocalId>()
    for i in 0..decl.params.length {
        let pType = resolveType(ref b, through: ref c, for: in decl.params[i].type)
        let loc = declareLocal(ref b, through: ref c, at: decl.params[i].name, as: pType, for: .letKeyword)
        pList.append(loc)
    }

    t15BindExpects(ref b, through: ref c, for: in decl, by: in pList)
    let checks = t15BindRequires(ref b, through: ref c, for: in decl)

    switch decl.body {
        case .blockStmt(let bNode):
            let oldThisType = b.thisType
            if b.owner >= 0 && b.owner < c.structs.length {
                b.thisType = structTypeOf(b.owner)
            }
            let block = bindBlock(ref b, through: ref c, for: in bNode.value)
            b.thisType = oldThisType
            if checks.length == 0 {
                if b.fn >= 0 { c.functions[b.fn].body = block }
            } else {
                var wrapped = List<BStmt>()
                for chk in checks { wrapped.append(chk) }
                wrapped.append(block)
                let fullBlock = addBlock(ref c, from: BBlock { span: bNode.value.span, statements: move wrapped })
                if b.fn >= 0 { c.functions[b.fn].body = fullBlock }
            }
        default:
            if decl.expressionBody is not .none {
                let exprBody = bindExpressionBody(ref b, through: ref c, for: in decl.expressionBody)
                let eSpan = t15ExprSpan(in decl.expressionBody)
                var wrapped = List<BStmt>()
                for chk in checks { wrapped.append(chk) }
                wrapped.append(exprBody)
                let fullBlock = addBlock(ref c, from: BBlock { span: eSpan, statements: move wrapped })
                if b.fn >= 0 { c.functions[b.fn].body = fullBlock }
            } else {
                let emptyBlock = addBlock(ref c, from: BBlock { span: decl.span, statements: List<BStmt>() })
                if b.fn >= 0 { c.functions[b.fn].body = emptyBlock }
            }
    }

    t15BindParameterDefaults(ref b, through: ref c, for: in pList)
}

void t15BindExpects(ref Binder b, through ref Ctx c, for in parser.FunctionDecl decl, by in List<LocalId> ps) {
    if decl.requiresKeyword.length == 0 { return }
    let hasThis = b.owner >= 0
    var reads = List<LocalId>()
    var readSpans = List<TextSpan>()
    for p in ps {
        reads.append(p)
        readSpans.append(c.locals[p].span)
    }

    for req in decl.requiresKeyword {
        let cond = bindExpr(ref b, through: ref c, for: in req, to: prim(PrimitiveKind.bool))
        let condType = exprType(in c, for: cond)
        if !isBool(condType) && !isError(condType) {
            let disp = typeDisplay(ref c, by: condType)
            report(ref b, through: ref c, for: .requiresNotBool, at: t15ExprSpan(in req), by: (disp, "", "", "", ""),
                help: "write a condition the arguments must meet, such as `count>0`")
        }
    }

    var seenUntrusted = List<LocalId>()
    for rIdx in 0..reads.length {
        let locId = reads[rIdx]
        let locType = c.locals[locId].type
        if kindOf(locType) == .untrusted && !t15ContainsLocal(in seenUntrusted, for: locId) {
            seenUntrusted.append(locId)
            let pName = c.locals[locId].name
            report(ref b, through: ref c, for: .expectsReadsUntrusted, at: readSpans[rIdx], by: (pName, "", "", "", ""),
                help: $"validate `{pName}` with a type that has `requires` before the call")
        }
    }
    var uniqueReads = List<LocalId>()
    for locId in reads {
        if !t15ContainsLocal(in uniqueReads, for: locId) { uniqueReads.append(locId) }
    }
    if uniqueReads.length == 1 && !hasThis {
        let pName = c.locals[uniqueReads[0]].name
        let kwSpan = t15ExpectsKeyword(in c, from: b.file, for: in decl)
        report(ref b, through: ref c, for: .expectsSingleParameter, at: kwSpan, by: (pName, "", "", "", ""),
            help: $"declare a type with `requires` for `{pName}`")
    }
}

List<BStmt> t15BindRequires(ref Binder b, through ref Ctx c, for in parser.FunctionDecl decl) {
    var conditions = List<BExpr>()
    var checks = List<BStmt>()
    for r in decl.requiresKeyword {
        let rSpan = t15ExprSpan(in r)
        let condition = bindExpr(ref b, through: ref c, for: in r, to: prim(PrimitiveKind.bool))
        let condType = exprType(in c, for: condition)
        if !isBool(condType) {
            if !isError(condType) {
                let disp = typeDisplay(ref c, by: condType)
                report(ref b, through: ref c, for: .requiresNotBool, at: rSpan, by: (disp, "", "", "", ""),
                    help: "write a condition the arguments must meet, such as `count>0`")
            }
            continue
        }
        conditions.append(condition)

        let panicArgs = List<BExpr>()
        let panicCall = addCall(ref c, from: BCall {
            span: rSpan,
            function: -1,
            receiver: -1,
            arguments: move panicArgs,
            type: prim(PrimitiveKind.neverKind),
        })
        let panicStmt = addExprStmt(ref c, from: BExprStmt { span: rSpan, expr: panicCall })
        let notCond = addUnary(ref c, from: BUnary { span: rSpan, op: .notKeyword, operand: condition, type: prim(PrimitiveKind.bool) })
        let ifStmt = addIf(ref c, from: BIf { span: rSpan, condition: notCond, then: panicStmt, elseBranch: -1 })
        checks.append(ifStmt)
    }
    return checks
}

void t15BindParameterDefaults(ref Binder b, through ref Ctx c, for in List<LocalId> pList) {
    if b.fn >= 0 && b.fn < c.functions.length {
        for p in pList {
            let _ = parameterDefault(ref c, for: b.fn, by: p)
        }
    }
}

// ── Pass control (Hold, Release) ──────────────────────────────────────────────

// stub: T15 ports Binder.cs:60 Hold
i64 hold(ref Binder b, through ref Ctx c) {
    c.bags.append(DiagBag { items: List<Diag>(), previous: c.sink })
    b.held = c.bags.length
    return b.held - 1
}

// stub: T15 ports Binder.cs:71 Release
List<(LocalId, Type)> release(ref Binder b, through ref Ctx c) {
    let bagIdx = b.held - 1
    b.held = 0
    if bagIdx < 0 || bagIdx >= c.bags.length { return List<(LocalId, Type)>() }
    var constrList = List<(i64, Type)>()
    for (decl, type) in b.constraints { constrList.append((decl, type)) }
    var groups = Map<i64, Type>()
    for (decl, type) in constrList {
        if isInteger(type) {
            let peer = findPeer(ref b, for: decl)
            if !groups.contains(peer) { groups[peer] = type }
        }
    }
    for (decl, type) in constrList {
        if !isInteger(type) {
            let peer = findPeer(ref b, for: decl)
            let _ = groups.remove(peer)
        }
    }
    var pendingList = List<(LocalId, i64)>()
    for (localId, decl) in b.pending { pendingList.append((localId, decl)) }
    var seeds = List<(LocalId, Type)>()
    for (localId, decl) in pendingList {
        let peer = findPeer(ref b, for: decl)
        if groups.contains(peer) {
            seeds.append((localId, groups[peer]))
        }
    }
    var hasNonI32 = false
    for (loc, t) in seeds {
        if isInteger(t) && t != prim(PrimitiveKind.i32) {
            hasNonI32 = true
            break
        }
    }
    if hasNonI32 {
        var instItems = List<Diag>()
        for i in 0..c.bags[bagIdx].items.length {
            if c.bags[bagIdx].items[i].label == "the generic code needs this of its type arguments" {
                instItems.append(t15CloneDiag(in c.bags[bagIdx].items[i]))
            }
        }
        reportHeld(ref c, for: in instItems)
        return seeds
    }
    var allHeldItems = List<Diag>()
    for i in 0..c.bags[bagIdx].items.length {
        allHeldItems.append(t15CloneDiag(in c.bags[bagIdx].items[i]))
    }
    reportHeld(ref c, for: in allHeldItems)
    return List<(LocalId, Type)>()
}

// ── Diagnostics & Reporting ───────────────────────────────────────────────────

// stub: T15 ports Binder.cs:112 Report
void report(ref Binder b, through ref Ctx c, for SemaCode code, at TextSpan span, by (string a0, string a1, string a2, string a3, string a4) args, string label = "", string help = "", bool hasFix = false, TextSpan? fixSpan = null, string fixReplacement = "") {
    let oldSink = c.sink
    if b.held > 0 { c.sink = b.held - 1 }
    report(ref c, for: code, from: b.file, at: span, by: args, label: label, help: help, hasFix: hasFix, fixSpan: fixSpan, fixReplacement: fixReplacement)
    c.sink = oldSink
}

// stub: T15 ports Binder.cs:120 ResolveType
Type resolveType(ref Binder b, through ref Ctx c, for in parser.TypeSyntax t) {
    var typeMap = Map<string, Type>()
    if b.fn >= 0 && b.fn < c.functions.length {
        for (k, v) in c.functions[b.fn].typeMap { typeMap[k] = v }
    } else if b.owner >= 0 && b.owner < c.structs.length {
        for (k, v) in c.structs[b.owner].typeMap { typeMap[k] = v }
    }
    let r = TypeResolver { file: b.file, container: b.owner, typeArgs: move typeMap }
    let oldSink = c.sink
    if b.held > 0 { c.sink = b.held - 1 }
    let res = resolve(ref c, through: in r, for: in t)
    c.sink = oldSink
    return res
}

// ── Scopes & Locals ───────────────────────────────────────────────────────────

// stub: T15 ports Binder.cs:131 PushScope
void pushScope(ref Binder b) {
    b.scopes.append(Map<string, LocalId>())
}

// stub: T15 ports Binder.cs:133 PopScope
void popScope(ref Binder b) {
    if b.scopes.length > 0 {
        b.scopes.remove(at: b.scopes.length - 1)
    }
}

// stub: T15 ports Binder.cs:135 DeclareLocal
LocalId declareLocal(ref Binder b, through ref Ctx c, at TextSpan name, as Type type, for LocalKind kind) {
    if kind != .temp {
        checkValueName(ref b, through: ref c, at: name)
    }
    let text = t15Text(in c, from: b.file, at: name)
    let locId = newLocal(ref c, by: LocalSymbol {
        name: text,
        nameSpan: name,
        span: name,
        type: type,
        kind: kind,
        id: b.nextLocalId,
    })
    b.nextLocalId += 1
    addLocal(ref b, through: ref c, at: name, for: locId)
    return locId
}

// stub: T15 ports Binder.cs:143 AddLocal
void addLocal(ref Binder b, through ref Ctx c, at TextSpan name, for LocalId local) {
    if b.fn >= 0 && b.fn < c.functions.length {
        c.functions[b.fn].locals.append(local)
    }
    let text = t15Text(in c, from: b.file, at: name)
    if text == "_" { return }
    if b.scopes.length == 0 {
        pushScope(ref b)
    }
    let topScopeIdx = b.scopes.length - 1
    let localKind = c.locals[local].kind
    let localType = c.locals[local].type
    if localKind == .letKeyword && b.scopes[topScopeIdx].contains(text) {
        let same = b.scopes[topScopeIdx][text]
        if c.locals[same].type == localType && !isError(localType) {
            let line = linePosition(c.files[b.file].text.span, at: c.locals[same].nameSpan.start).line
            let typeDisp = typeDisplay(ref c, by: localType)
            report(ref b, through: ref c, for: .sameTypeShadowing, at: name, by: (text, typeDisp, "", "", ""),
                label: $"`{text}` is declared on line {line}", help: "use the first one, or rename this one to say how it differs")
        }
    } else {
        var existingLoc: LocalId = -1
        var outerLevel = b.scopes.length - 2
        while outerLevel >= 0 {
            if b.scopes[outerLevel].contains(text) {
                existingLoc = b.scopes[outerLevel][text]
                break
            }
            outerLevel -= 1
        }
        if existingLoc >= 0 && !isError(localType) && !isError(c.locals[existingLoc].type) {
            let line = linePosition(c.files[b.file].text.span, at: c.locals[existingLoc].nameSpan.start).line
            let typeDisp = typeDisplay(ref c, by: c.locals[existingLoc].type)
            report(ref b, through: ref c, for: .shadowing, at: name, by: (text, typeDisp, "", "", ""),
                label: $"`{text}` is declared on line {line}", help: "use the first one, or rename this one to say how it differs")
        }
    }
    b.scopes[topScopeIdx][text] = local
}

// stub: T15 ports Binder.cs:118 CheckValueName
void checkValueName(ref Binder b, through ref Ctx c, at TextSpan name) {
    let text = t15Text(in c, from: b.file, at: name)
    if text == "_" { return }
    let oldSink = c.sink
    if b.held > 0 { c.sink = b.held - 1 }
    checkValue(ref c, from: b.file, at: name)
    c.sink = oldSink
}

// ── Checks and Defaults ───────────────────────────────────────────────────────

// stub: T15 ports Binder.cs:258 BindChecks
void bindChecks(ref Binder b, through ref Ctx c, for in StructChecks checks) {
    let s = b.owner
    if s < 0 || s >= c.structs.length { return }
    let file = c.structs[s].file
    let dIdx = c.structs[s].declIndex
    if file < 0 || file >= c.files.length || dIdx < 0 || dIdx >= c.files[file].unit.members.length { return }
    let sSpan = c.structs[s].span
    var valErr = validationErrorOf(ref c, for: structTypeOf(s))
    if valErr < 0 && c.validationErrors.contains(structTypeOf(s)) {
        valErr = c.validationErrors[structTypeOf(s)]
    }
    var invalidVar: VariantId = -1
    if valErr >= 0 && valErr < c.errorSets.length {
        for vId in c.errorSets[valErr].variants {
            if c.errorVariants[vId].name == "invalid" {
                invalidVar = vId
                break
            }
        }
    }
    var listType: Type = -1
    var listLocal: LocalId = -1
    if invalidVar >= 0 && c.errorVariants[invalidVar].fields.length > 0 {
        listType = c.locals[c.errorVariants[invalidVar].fields[0]].type
        listLocal = newLocal(ref c, by: LocalSymbol {
            name: "violations",
            nameSpan: sSpan,
            span: sSpan,
            type: listType,
            kind: .varKeyword,
            id: b.nextLocalId,
        })
        b.nextLocalId += 1
    }
    var statements = List<BStmt>()
    var flagDecls = List<BStmt>()
    if listLocal != -1 {
        var emptyColl = List<BExpr>()
        let coll = addCollection(ref c, from: BCollection { span: sSpan, elements: move emptyColl, type: listType })
        let declStmt = addLocalDecl(ref c, from: BLocalDecl { span: sSpan, local: listLocal, initializer: coll })
        statements.append(declStmt)
    }

    var broken = Map<FieldId, LocalId>()
    switch c.files[file].unit.members[dIdx] {
        case .structDecl(let sNode):
            for fIdx in 0..c.structs[s].fields.length {
                let fId = c.structs[s].fields[fIdx]
                let mIdx = c.fields[fId].memberIndex
                if mIdx >= 0 && mIdx < sNode.value.members.length {
                    switch sNode.value.members[mIdx] {
                        case .fieldDecl(let fNode):
                            for r in fNode.value.requiresKeyword {
                                b.itDepth = 1
                                let cond = bindExpr(ref b, through: ref c, for: in r.condition, to: prim(PrimitiveKind.bool))
                                b.itDepth = 0
                                let cType = exprType(in c, for: cond)
                                if !isBool(cType) {
                                    if !isError(cType) {
                                        report(ref b, through: ref c, for: .requiresNotBool, at: t15ExprSpan(in r.condition), by: (typeDisplay(ref c, by: cType), "", "", "", ""), help: "write a condition the value must meet, such as `it>0`")
                                    }
                                    continue
                                }
                                var failsCond = addUnary(ref c, from: BUnary { span: t15ExprSpan(in r.condition), op: .notKeyword, operand: cond, type: prim(PrimitiveKind.bool) })
                                if broken.contains(fId) {
                                    let flagLoc = broken[fId]
                                    let flagNode = addLocalNode(ref c, at: t15ExprSpan(in r.condition), for: flagLoc)
                                    let notFlag = addUnary(ref c, from: BUnary { span: t15ExprSpan(in r.condition), op: .notKeyword, operand: flagNode, type: prim(PrimitiveKind.bool) })
                                    failsCond = addBinary(ref c, from: BBinary { span: t15ExprSpan(in r.condition), op: .logicalAnd, left: notFlag, right: failsCond, type: prim(PrimitiveKind.bool) })
                                }
                                if listLocal < 0 {
                                    var errPayload = List<BExpr>()
                                    let err = addErrorVariant(ref c, from: BErrorVariant { span: t15ExprSpan(in r.condition), variant: invalidVar, payload: move errPayload, type: errorSetTypeOf(valErr) })
                                    let failStmt = addFail(ref c, from: BFail { span: t15ExprSpan(in r.condition), error: err })
                                    statements.append(addIf(ref c, from: BIf { span: t15ExprSpan(in r.condition), condition: failsCond, then: failStmt, elseBranch: -1 }))
                                } else {
                                    if !broken.contains(fId) {
                                        let flagLocal = newLocal(ref c, by: LocalSymbol {
                                            name: $"broken_{c.fields[fId].name}",
                                            nameSpan: sSpan,
                                            span: sSpan,
                                            type: prim(PrimitiveKind.bool),
                                            kind: .varKeyword,
                                            id: b.nextLocalId,
                                        })
                                        b.nextLocalId += 1
                                        broken[fId] = flagLocal
                                        let falseLit = addLiteral(ref c, from: BLiteral { span: sSpan, value: Constant { kind: .flag, flag: false }, type: prim(PrimitiveKind.bool) })
                                        let flagDecl = addLocalDecl(ref c, from: BLocalDecl { span: sSpan, local: flagLocal, initializer: falseLit })
                                        flagDecls.append(flagDecl)
                                    }
                                    let trueLit = addLiteral(ref c, from: BLiteral { span: t15ExprSpan(in r.condition), value: Constant { kind: .flag, flag: true }, type: prim(PrimitiveKind.bool) })
                                    let brokenTarget = addLocalNode(ref c, at: t15ExprSpan(in r.condition), for: broken[fId])
                                    let setFlag = addAssign(ref c, from: BAssign { span: t15ExprSpan(in r.condition), target: brokenTarget, value: trueLit })
                                    statements.append(addIf(ref c, from: BIf { span: t15ExprSpan(in r.condition), condition: failsCond, then: setFlag, elseBranch: -1 }))
                                }
                            }
                        default:
                            break
                    }
                }
            }
            for r in sNode.value.rules {
                if (r.at is { } atName) {
                    var foundField: FieldId = -1
                    let targetText = t15Text(in c, from: file, at: atName)
                    for f in c.structs[s].fields {
                        if c.fields[f].name == targetText {
                            foundField = f
                            break
                        }
                    }
                    if foundField < 0 {
                        report(ref b, through: ref c, for: .ruleTargetNotField, at: atName, by: (targetText, c.structs[s].name, "", "", ""), label: $"`.{targetText}`", help: $"name a field of `{c.structs[s].name}`")
                    }
                }
                b.itDepth = 0
                let cond = bindExpr(ref b, through: ref c, for: in r.condition, to: prim(PrimitiveKind.bool))
                let cType = exprType(in c, for: cond)
                if !isBool(cType) {
                    if !isError(cType) {
                        report(ref b, through: ref c, for: .requiresNotBool, at: t15ExprSpan(in r.condition), by: (typeDisplay(ref c, by: cType), "", "", "", ""), help: "write a condition the value must meet, such as `it>0`")
                    }
                    continue
                }
                let failsCond = addUnary(ref c, from: BUnary { span: t15ExprSpan(in r.condition), op: .notKeyword, operand: cond, type: prim(PrimitiveKind.bool) })
                var errPayload = List<BExpr>()
                if listLocal >= 0 {
                    let errLocNode = addLocalNode(ref c, at: t15ExprSpan(in r.condition), for: listLocal)
                    errPayload.append(errLocNode)
                }
                let err = addErrorVariant(ref c, from: BErrorVariant { span: t15ExprSpan(in r.condition), variant: invalidVar, payload: move errPayload, type: errorSetTypeOf(valErr) })
                let failStmt = addFail(ref c, from: BFail { span: t15ExprSpan(in r.condition), error: err })
                statements.append(addIf(ref c, from: BIf { span: t15ExprSpan(in r.condition), condition: failsCond, then: failStmt, elseBranch: -1 }))
            }
        default:
            break
    }

    if listLocal >= 0 {
        var emptyArgs = List<BExpr>()
        let recNode = addLocalNode(ref c, at: sSpan, for: listLocal)
        let isEmp = addBuiltinCall(ref c, from: BBuiltinCall { span: sSpan, member: .listIsEmpty, receiver: recNode, arguments: move emptyArgs, type: prim(PrimitiveKind.bool) })
        let anyFail = addUnary(ref c, from: BUnary { span: sSpan, op: .notKeyword, operand: isEmp, type: prim(PrimitiveKind.bool) })
        var errPayload = List<BExpr>()
        let errLocNode = addLocalNode(ref c, at: sSpan, for: listLocal)
        errPayload.append(errLocNode)
        let err = addErrorVariant(ref c, from: BErrorVariant { span: sSpan, variant: invalidVar, payload: move errPayload, type: errorSetTypeOf(valErr) })
        let failStmt = addFail(ref c, from: BFail { span: sSpan, error: err })
        statements.append(addIf(ref c, from: BIf { span: sSpan, condition: anyFail, then: failStmt, elseBranch: -1 }))
    }

    var allStmts = List<BStmt>()
    for fd in flagDecls { allStmts.append(fd) }
    for st in statements { allStmts.append(st) }
    let block = addBlock(ref c, from: BBlock { span: sSpan, statements: move allStmts })
    if b.fn >= 0 { c.functions[b.fn].body = block }
}

BExpr addLocalNode(ref Ctx c, at TextSpan span, for LocalId local) {
    return addLocal(ref c, from: BLocal { span: span, local: local, type: c.locals[local].type })
}

// stub: T15 ports Binder.cs:354 BindParameterDefault
BExpr bindParameterDefault(ref Binder b, through ref Ctx c, for LocalId p) {
    if p < 0 || p >= c.locals.length { return -1 }
    let d = c.locals[p].id
    let retType = c.locals[p].type
    let defaultExpr = parser.Expr.none
    let value = bindConverted(ref b, through: ref c, for: in defaultExpr, to: c.locals[p].type)
    return value
}

// stub: T15 ports Binder.cs:361 BindExpressionBody
BStmt bindExpressionBody(ref Binder b, through ref Ctx c, for in parser.Expr e) {
    let retType = b.fn >= 0 && b.fn < c.functions.length ? c.functions[b.fn].returnType : prim(PrimitiveKind.void)
    let eSpan = t15ExprSpan(in e)
    if isVoid(retType) {
        let value = bindStatementExpression(ref b, through: ref c, for: in e)
        return addExprStmt(ref c, from: BExprStmt { span: eSpan, expr: value })
    }
    let conv = bindConverted(ref b, through: ref c, for: in e, to: retType)
    return addReturn(ref c, from: BReturn { span: eSpan, value: conv })
}

// stub: T15 ports Binder.cs:370 BindGetter
void bindGetter(ref Binder b, through ref Ctx c, for in parser.PropertyDecl d) {
    pushScope(ref b)
    if d.body is not .none {
        let retType = b.fn >= 0 && b.fn < c.functions.length ? c.functions[b.fn].returnType : prim(PrimitiveKind.void)
        if isVoid(retType) {
            let value = bindStatementExpression(ref b, through: ref c, for: in d.body)
            let eStmt = addExprStmt(ref c, from: BExprStmt { span: d.span, expr: value })
            if b.fn >= 0 { c.functions[b.fn].body = eStmt }
        } else {
            let conv = bindConverted(ref b, through: ref c, for: in d.body, to: retType)
            let rStmt = addReturn(ref c, from: BReturn { span: d.span, value: conv })
            if b.fn >= 0 { c.functions[b.fn].body = rStmt }
        }
    } else {
        switch d.block {
            case .blockStmt(let bNode):
                let block = bindBlock(ref b, through: ref c, for: in bNode.value)
                if b.fn >= 0 { c.functions[b.fn].body = block }
            default:
                break
        }
    }
    popScope(ref b)
}

// stub: T15 ports Binder.cs:382 BindConstructor
void bindConstructor(ref Binder b, through ref Ctx c, for in parser.ConstructorDecl d) {
    pushScope(ref b)
    for i in 0..d.params.length {
        let pType = resolveType(ref b, through: ref c, for: in d.params[i].type)
        let _ = declareLocal(ref b, through: ref c, at: d.params[i].name, as: pType, for: .letKeyword)
    }
    switch d.body {
        case .blockStmt(let bNode):
            let block = bindBlock(ref b, through: ref c, for: in bNode.value)
            let finalBlock = block >= 0 ? block : addBlock(ref c, from: BBlock { span: bNode.value.span, statements: List<BStmt>() })
            if b.fn >= 0 { c.functions[b.fn].body = finalBlock }
        default:
            break
    }
    popScope(ref b)
}

// stub: T15 ports Binder.cs:388 BindMain
void bindMain(ref Binder b, through ref Ctx c, for in List<parser.GlobalStatement> statements) {
    if b.fn < 0 { return }
    c.functions[b.fn].infersErrors = true
    pushScope(ref b)
    var bound = List<BStmt>()
    for s in statements {
        let bs = bindStatement(ref b, through: ref c, for: in s.statement)
        bound.append(bs)
    }
    popScope(ref b)
    c.functions[b.fn].body = addBlock(ref c, from: BBlock { span: c.functions[b.fn].span, statements: move bound })
}

// stub: T15 ports Binder.cs:397 BindTest
void bindTest(ref Binder b, through ref Ctx c, for in parser.TestDecl d, by in List<parser.Expr> values) {
    if b.fn >= 0 && b.fn < c.functions.length { c.functions[b.fn].infersErrors = true }
    if values.length == 0 {
        switch d.body {
            case .blockStmt(let bNode):
                let block = bindBlock(ref b, through: ref c, for: in bNode.value)
                if b.fn >= 0 { c.functions[b.fn].body = block }
            default:
                break
        }
        return
    }
    var statements = List<BStmt>()
    let n = d.params.length < values.length ? d.params.length : values.length
    for i in 0..n {
        let type = resolveType(ref b, through: ref c, for: in d.params[i].type)
        let value = bindConverted(ref b, through: ref c, for: in values[i], to: type)
        let loc = declareLocal(ref b, through: ref c, at: d.params[i].name, as: type, for: .letKeyword)
        let locDecl = addLocalDecl(ref c, from: BLocalDecl { span: d.params[i].span, local: loc, initializer: value })
        statements.append(locDecl)
    }
    switch d.body {
        case .blockStmt(let bNode):
            statements.append(bindBlock(ref b, through: ref c, for: in bNode.value))
        default:
            break
    }
    let block = addBlock(ref c, from: BBlock { span: d.span, statements: move statements })
    if b.fn >= 0 { c.functions[b.fn].body = block }
}

// stub: T15 ports Binder.cs:417 BindFieldDefault
BExpr bindFieldDefault(ref Binder b, through ref Ctx c, for FieldId f) {
    if f < 0 || f >= c.fields.length { return -1 }
    let file = c.fields[f].file
    let s = c.fields[f].owner
    if s < 0 || s >= c.structs.length { return -1 }
    let dIdx = c.structs[s].declIndex
    if file < 0 || file >= c.files.length || dIdx < 0 || dIdx >= c.files[file].unit.members.length { return -1 }
    switch c.files[file].unit.members[dIdx] {
        case .structDecl(let sNode):
            let mIdx = c.fields[f].memberIndex
            if mIdx >= 0 && mIdx < sNode.value.members.length {
                switch sNode.value.members[mIdx] {
                    case .fieldDecl(let fNode):
                        return bindConverted(ref b, through: ref c, for: in fNode.value.defaultKeyword, to: c.fields[f].type)
                    default:
                        break
                }
            }
        default:
            break
    }
    return -1
}

// stub: T15 ports Binder.cs:422 BindEnumArguments
void bindEnumArguments(ref Binder b, through ref Ctx c, for EnumId e) {
    if e < 0 || e >= c.enums.length { return }
    let file = c.enums[e].file
    let dIdx = c.enums[e].declIndex
    if file < 0 || file >= c.files.length || dIdx < 0 || dIdx >= c.files[file].unit.members.length { return }
    switch c.files[file].unit.members[dIdx] {
        case .enumDecl(let eNode):
            var ps = List<LocalId>()
            var enumFieldIds = List<EnumFieldId>()
            for fId in c.enums[e].fields { enumFieldIds.append(fId) }
            for fId in enumFieldIds {
                let loc = newLocal(ref c, by: LocalSymbol {
                    name: c.enumFields[fId].name,
                    nameSpan: c.enumFields[fId].span,
                    span: c.enumFields[fId].span,
                    type: c.enumFields[fId].type,
                    kind: .letKeyword,
                    id: b.nextLocalId,
                })
                b.nextLocalId += 1
                ps.append(loc)
            }
            for d in eNode.value.members {
                let mName = t15Text(in c, from: file, at: d.name)
                var memberId: EnumMemberId = -1
                for mId in c.enums[e].members {
                    if c.enumMembers[mId].name == mName {
                        memberId = mId
                        break
                    }
                }
                if memberId < 0 { continue }
                if d.args is null && eNode.value.params is null { continue }
                let fullName = $"{c.enums[e].name}.{mName}"
                var callArgs = List<Argument>()
                let callExpr = CallExpr {
                    span: d.span,
                    callee: parser.Expr.nameExpr(Owned(NameExpr { span: d.name, name: d.name, typeArgs: List<parser.TypeSyntax>() })),
                    args: move callArgs,
                }
                let boundArgs = bindArguments(ref b, through: ref c, for: in callExpr, by: in ps, as: -1, enforceNames: false, displayName: fullName)
                var args = List<BExpr>()
                for a in boundArgs { args.append(a) }
                if args.length == 0 && ps.length > 0 {
                    for p in ps {
                        args.append(addLocal(ref c, from: BLocal { span: d.span, local: p, type: prim(PrimitiveKind.i32) }))
                    }
                }
                for i in 0..args.length {
                    let arg = args[i]
                    let aType = exprType(in c, for: arg)
                    if isError(aType) { continue }
                    if i < ps.length && isError(c.locals[ps[i]].type) { continue }
                    if c.constants.contains(arg) {
                        c.enumMembers[memberId].values.append(c.constants[arg])
                    } else {
                        let pName = i < ps.length ? c.locals[ps[i]].name : ""
                        let aSpan = nodeSpan(in c, for: arg)
                        report(ref b, through: ref c, for: .enumArgumentNotConstant, at: aSpan, by: (pName, fullName, "", "", ""),
                            label: "computed at run time", help: "use literals and `const`s only; enum data is static")
                    }
                }
            }
        default:
            break
    }
}

// stub: T15 ports Binder.cs:446 BindModuleConstant
void bindModuleConstant(ref Binder b, through ref Ctx c, for ConstId k) {
    if k < 0 || k >= c.consts.length { return }
    let file = c.consts[k].file
    let dIdx = c.consts[k].declIndex
    if file < 0 || file >= c.files.length || dIdx < 0 || dIdx >= c.files[file].unit.members.length { return }
    switch c.files[file].unit.members[dIdx] {
        case .globalStatement(let gs):
            switch gs.value.statement {
                case .localDecl(let locNode):
                    var declared: Type = -1
                    if locNode.value.type is not .none {
                        declared = resolveType(ref b, through: ref c, for: in locNode.value.type)
                        if functionTypeNotHere(ref c, for: declared, from: file, at: t8TypeSpan(in locNode.value.type), as: "a constant") {
                            declared = errorType()
                        }
                    }
                    if locNode.value.init is .none {
                        report(ref b, through: ref c, for: .missingInitializer, at: locNode.value.name, by: ("const", c.consts[k].name, "", "", ""))
                        c.consts[k].type = declared != -1 ? declared : errorType()
                        return
                    }
                    var value: BExpr = -1
                    if declared != -1 {
                        value = bindConverted(ref b, through: ref c, for: in locNode.value.init, to: declared)
                    } else {
                        let boundExpr = bindExpr(ref b, through: ref c, for: in locNode.value.init)
                        value = built(ref b, through: ref c, for: boundExpr, from: in locNode.value.init)
                    }
                    c.consts[k].type = declared != -1 ? declared : defaultType(ref b, through: ref c, for: value, from: in locNode.value.init)
                    if declared == -1 {
                        value = convert(ref b, through: ref c, for: value, to: c.consts[k].type, at: t15ExprSpan(in locNode.value.init))
                    }
                    let kType = c.consts[k].type
                    let isArrOrListOrSpan = kindOf(kType) == .array || kindOf(kType) == .list || kindOf(kType) == .span
                    if isArrOrListOrSpan || t15IsCollectionExpr(in locNode.value.init) {
                        t15BindStaticArray(ref b, through: ref c, for: k, by: in locNode.value, as: value)
                        return
                    }
                    if !checkUniqueConst(ref b, through: ref c, for: in locNode.value, as: kType) && !c.constants.contains(value) && !isError(exprType(in c, for: value)) {
                        report(ref b, through: ref c, for: .notConstant, at: t15ExprSpan(in locNode.value.init), by: ("a `const`", "", "", "", ""))
                    }
                    if c.constants.contains(value) {
                        c.consts[k].value = c.constants[value]
                    }
                    c.consts[k].bound = value
                default:
                    break
            }
        default:
            break
    }
}

void t15BindStaticArray(ref Binder b, through ref Ctx c, for ConstId k, by in parser.LocalDecl decl, as BExpr value) {
    c.consts[k].bound = value
    let vType = exprType(in c, for: value)
    if isError(vType) { return }
    let kType = c.consts[k].type
    let declName = c.consts[k].name
    let help = $"write `const T[N] {declName} = [ … ]` with `T` a number type, `bool`, `rune` or `string`, and only literals or constants inside"
    var isGoodArray = false
    if kindOf(kType) == .array {
        let elem = c.arrayTypes[typeIndex(kType)].element
        let isNum = isNumeric(elem)
        let isPrimOk = isNum || elem == prim(PrimitiveKind.bool) || elem == prim(PrimitiveKind.char) || elem == prim(PrimitiveKind.string)
        if isPrimOk { isGoodArray = true }
    }
    if !isGoodArray {
        let span = decl.type is not .none ? t8TypeSpan(in decl.type) : t15ExprSpan(in decl.init)
        report(ref b, through: ref c, for: .invalidConstArray, at: span, by: (declName, "", "", "", ""), help: help)
        return
    }
    if boundKind(value) != .collection {
        report(ref b, through: ref c, for: .invalidConstArray, at: t15ExprSpan(in decl.init), by: (declName, "", "", "", ""), help: help)
        return
    }
    let collIdx = boundIndex(value)
    var collElements = List<BExpr>()
    for elem in c.bCollections[collIdx].elements { collElements.append(elem) }
    for elem in collElements {
        if isError(exprType(in c, for: elem)) { return }
    }
    for elem in collElements {
        if !c.constants.contains(elem) {
            let eSpan = nodeSpan(in c, for: elem)
            report(ref b, through: ref c, for: .invalidConstArray, at: eSpan, by: (declName, "", "", "", ""), label: "not a constant", help: help)
            return
        }
    }
    c.consts[k].isStaticArray = true
    for elem in collElements {
        c.consts[k].elements.append(c.constants[elem])
    }
}

// stub: T15 ports Binder.cs:499 BindArraySize
i64 bindArraySize(ref Binder b, through ref Ctx c, for in parser.Expr size) {
    let value = bindConverted(ref b, through: ref c, for: in size, to: prim(PrimitiveKind.i64))
    let vType = exprType(in c, for: value)
    if isError(vType) { return -1 }
    let sSpan = t15ExprSpan(in size)
    if !c.constants.contains(value) {
        report(ref b, through: ref c, for: .notConstant, at: sSpan, by: ("an array length", "", "", "", ""))
        return -1
    }
    let constant = c.constants[value]
    let n = constant.integer
    if (n.hi & 0x8000000000000000) != 0 {
        report(ref b, through: ref c, for: .literalOutOfRange, at: sSpan, by: ($"{n.lo}", "an array length", "", "", ""))
        return -1
    }
    return i64(n.lo)
}
