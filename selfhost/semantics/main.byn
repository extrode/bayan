// bayan-check: the self-hosted checker. Ports the `check` and `types` subset of `CliApp` (CliApp.cs:141
// `Types`, :151 `ParseBuildOptions`, :259 `Compile`, :298 `Report`, :315 `TakeGlobalOptions`, :362 `IsScript`,
// :441 `Check`, :513 `Failed`, :528 `ProgramName` in json.byn), `DiagnosticJson` (json.byn) and the golden
// harness's compilation (DiagTests.cs:20-26). Plain style only: `--color` is checked but paints nothing, and
// the symbols are `Symbols.Unicode`, or `Symbols.Ascii` with `--ascii` (Q646).
//
//     bayan-check [--ascii] [--color <when>] [<check options>] [--spans] <path>
//                                    as `bayan check <path>` (R1); `--spans` also prints a
//                                    `span out of range:` line per diagnostic span outside its file (L023)
//     bayan-check [--ascii] [--color <when>] --types [<check options>] <path>
//                                    as `bayan types <path>` (R2)
//     bayan-check --golden [--tests] [--include-path] [--spans] --package <dir> <file>
//                                    `<file>` compiled alone with `<dir>` as package root, as `DiagTests`
//                                    does, and its diagnostics rendered uncapped to stdout; exit 0
//     bayan-check --many <dir>       `== <name>` and, for every `*.byn` in `<dir>` in name order, its
//                                    `--golden --package <dir>` output and `--spans` lines (corpora, L023)
//     bayan-check --time <path>      the nanoseconds `check` spends parsing and checking `<path>`, and
//                                    `parse … check …` on stderr (R7)
//     bayan-check --codes            `code\tmessage` for every `SemaCode`, in `DiagnosticCodes.cs` order
//
// `<check options>` are `ParseBuildOptions`'s with `allowOutput: false`: `--all`, `--mode <m>`,
// `--diagnostics json|text` and `-- <ignored>`. A mode flag is the first argument after the global
// options. Paths are absolute (R1): Bayan has no current directory (Q571).

import lexer
import parser

const exitOk: i32 = 0
const exitFailure: i32 = 1
const exitUsage: i32 = 2

/// CliApp.cs:296 `ErrorLimit`.
const errorLimit: i64 = 20

/// C# `int.MaxValue` as `RenderAll`'s uncapped limit.
const noLimit: i64 = 2147483647

/// The `Symbols` members the CLI prints (Style.cs:59-60).
struct T26Symbols {
    string dot
    string cross
    string ellipsis
}

/// The `BuildOptions` subset `check` and `types` read (CliApp.cs:149).
struct T26Options {
    string path
    bool json = false
    bool all = false
    bool spans = false
}

/// A reported diagnostic as `Failed` reads it: its sort key (path, start), code and severity.
struct T26Reported {
    string path
    i64 start
    string code
    bool isWarning
}

T26Symbols t26Symbols(bool ascii) =>
    ascii ? T26Symbols { dot: "*", cross: "x", ellipsis: "..." } : T26Symbols { dot: "◆", cross: "✗", ellipsis: "…" }

i32 usage() {
    Io.stderr.write("usage: bayan-check [--ascii] [--color <when>] [--types] [--all] [--mode <m>] [--diagnostics json|text] [--spans] <path> | --golden [--tests] [--include-path] [--spans] --package <dir> <file> | --many <dir> | --time <path> | --codes\n")
    return exitUsage
}

/// The C# `File.Exists`: `path` reads and is not a directory.
bool t26FileExists(string path) {
    if t11DirectoryExists(path) { return false }
    let _ = Io.readFile(path) catch return false
    return true
}

/// CliApp.cs:151 `ParseBuildOptions` (`allowOutput: false`): `--`, `--mode`, `--diagnostics`, `--all`, and
/// bayan-check's `--spans`. Null after reporting.
T26Options? t26ParseBuildOptions(in List<string> args, bool allowSpans) {
    var path: string? = null
    var json = false
    var all = false
    var spans = false
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        i += 1
        if a == "--" {
            // `programArgs`: `check` and `types` ignore them.
            break
        } else if a == "--mode" && i < args.length {
            // Toolchain.cs:68 `TryParseMode`; the mode itself does not change a check.
            let m = args[i]
            i += 1
            if m != "debug" && m != "safe" && m != "fast" {
                Io.stderr.write($"bayan: unknown mode `{m}` (expected debug, safe or fast)\n")
                return null
            }
        } else if a == "--diagnostics" && i < args.length {
            let format = args[i]
            i += 1
            if format == "json" {
                json = true
            } else if format == "text" {
                json = false
            } else {
                Io.stderr.write($"bayan: unknown diagnostics format `{format}` (expected json or text)\n")
                return null
            }
        } else if a == "--all" {
            all = true
        } else if a == "--spans" && allowSpans {
            spans = true
        } else {
            if path is not null || a.startsWith("-") {
                Io.stderr.write($"bayan: unexpected argument `{a}`\n")
                return null
            }
            path = a
        }
    }
    // `File.Exists("package.byn")` in the current directory has no Bayan form (Q571).
    if (path is { } p) {
        if !t26FileExists(p) && !t11DirectoryExists(p) {
            Io.stderr.write($"bayan: not found: {p}\n")
            return null
        }
        return T26Options { path: p, json: json, all: all, spans: spans }
    }
    Io.stderr.write("bayan: expected a file or directory (or run inside a project with a `package.byn`)\n")
    return null
}

/// A `Ctx` with nothing in it, standing for C#'s `null` `Compiled`.
Ctx t26EmptyCtx() => Ctx {
    files: List<SourceFile>(),
    modules: List<Mod>(),
    diagnostics: List<Diag>(),
    bags: List<DiagBag>(),
}

/// CliApp.cs:259 `Compile`: a project directory (one with `package.byn`), a script (a file starting with
/// `#!`, compiled alone) or a file or directory (the whole directory is the entry module). Prints
/// diagnostics and adds them to `reported`; `ok` is false where C# returns null.
Ctx t26Compile(in T26Options o, by in T26Symbols symbols, to ref List<T26Reported> reported, through ref bool ok) {
    ok = false
    let manifestPath = t11Combine(o.path, by: "package.byn")
    if t11DirectoryExists(o.path) && t26FileExists(manifestPath) {
        let root = t11FullPath(o.path)
        var manifest = manifestRead(t11Combine(root, by: "package.byn"))
        t26ReportManifest(in o, by: in symbols, for: in manifest, at: t11Combine(root, by: "package.byn"), to: ref reported)
        if manifestErrorCount(in manifest) > 0 { return t26EmptyCtx() }
        let entry = t10EntryModule(in manifest)
        unless t11DirectoryExists(t11Combine(t11Combine(root, by: "src"), by: entry)) {
            let kind = manifest.kind == .lib ? "a library" : "an app"
            Io.stderr.write($"bayan: `{manifest.name}` is {kind}, so its code goes in `src/{entry}/`, which doesn't exist\n")
            return t26EmptyCtx()
        }
        var capabilities: List<string>? = null
        if (manifest.capabilities is { } caps) { capabilities = copyStrings(in caps) }
        let options = CompilationOptions { library: manifest.kind == .lib, capabilities: move capabilities, packageName: manifest.name }
        var c = fromProject(root, for: entry, by: in options)
        c.manifest = move manifest
        t26Report(in o, by: in symbols, for: ref c, to: ref reported)
        ok = !t11HasErrors(in c)
        return c
    }
    let options = CompilationOptions {}
    var c = fromPath(o.path, by: in options, wholeDirectory: !t26IsScript(o.path))
    t26Report(in o, by: in symbols, for: ref c, to: ref reported)
    ok = !t11HasErrors(in c)
    return c
}

/// CliApp.cs:298 `Report` for the compilation's diagnostics.
void t26Report(in T26Options o, by in T26Symbols symbols, for ref Ctx c, to ref List<T26Reported> reported) {
    for d in c.diagnostics {
        reported.append(T26Reported { path: pathOf(in c, for: in d), start: d.span.start, code: d.code, isWarning: d.isWarning })
    }
    if c.diagnostics.length == 0 { return }
    if o.json {
        Io.stderr.write(t26DiagnosticJsonAll(in c, from: in c.diagnostics))
        return
    }
    var omitted: i64 = 0
    let rendered = renderAll(in c, from: in c.diagnostics, by: true, until: o.all ? noLimit : errorLimit, to: ref omitted)
    Io.stderr.write(rendered)
    if omitted > 0 { Io.stderr.write($"{capLine(symbols.ellipsis, by: omitted)}\n") }
}

/// CliApp.cs:298 `Report` for a manifest's diagnostics. They have no file (Q565), so they render against
/// a `Ctx` holding the manifest's text as file 0, named `package.byn` as `Manifest.Read` names it.
void t26ReportManifest(in T26Options o, by in T26Symbols symbols, for in Manifest m, at string path, to ref List<T26Reported> reported) {
    if m.diagnostics.length == 0 { return }
    var c = t26EmptyCtx()
    let text = Io.readFile(path) catch List<u8>()
    let empty = List<u8>()
    var p = parser.Parser.create(lexer.lex(lexer.SourceText.create("package.byn", from: move empty), by: lexer.Keywords.build()))
    let unit = parser.parseCompilationUnit(ref p)
    c.files.append(SourceFile { path: "package.byn", displayPath: "package.byn", text: move text, unit: move unit, imports: Map<string, i64>() })
    for d in m.diagnostics {
        var copy = t10CopyDiag(in d)
        copy.file = 0
        c.diagnostics.append(move copy)
    }
    t26Report(in o, by: in symbols, for: ref c, to: ref reported)
}

/// CliApp.cs:362 `IsScript`: a file whose first two bytes are `#!`.
bool t26IsScript(string path) {
    unless t26FileExists(path) { return false }
    let bytes = Io.readFile(path) catch return false
    return bytes.length >= 2 && bytes[0] == 0x23 && bytes[1] == 0x21
}

/// CliApp.cs:141 `Types`.
i32 types(in List<string> args, by in T26Symbols symbols) {
    let o = t26ParseBuildOptions(in args, allowSpans: false) ?? return exitUsage
    var reported = List<T26Reported>()
    var ok = false
    var c = t26Compile(in o, by: in symbols, to: ref reported, through: ref ok)
    unless ok { return exitFailure }
    Io.stdout.write(typedDump(ref c))
    return exitOk
}

/// CliApp.cs:441 `Check`.
i32 check(in List<string> args, by in T26Symbols symbols) {
    let clock = Io.monotonicNanos()
    let o = t26ParseBuildOptions(in args, allowSpans: true) ?? return exitUsage
    var reported = List<T26Reported>()
    var ok = false
    var c = t26Compile(in o, by: in symbols, to: ref reported, through: ref ok)
    if o.spans { t26CheckSpans(ref c) }
    unless ok { return t26Failed(in o, from: in reported, by: in symbols) }
    unless o.json { print(checkSummary(symbols.dot, for: programName(ref c, for: o.path), by: t26Seconds(Io.monotonicNanos() - clock))) }
    return exitOk
}

/// CliApp.cs:506 `Seconds`: `{0}s` with two decimals (`0.00` rounds half away from zero).
string t26Seconds(i64 nanos) {
    let hundredths = (nanos + 5000000) / 10000000
    let rest = hundredths % 100
    return rest < 10 ? $"{hundredths / 100}.0{rest}s" : $"{hundredths / 100}.{rest}s"
}

/// CliApp.cs:513 `Failed`: the footer after a failed compile; nothing in JSON mode, or when no error caused
/// the failure. The first error is the first of `DiagnosticRenderer.Sort` (path ordinal, then start; ties
/// keep order).
i32 t26Failed(in T26Options o, from in List<T26Reported> reported, by in T26Symbols symbols) {
    if o.json { return exitFailure }
    var first: i64 = -1
    var errors: i64 = 0
    var warnings: i64 = 0
    for i in 0..reported.length {
        if reported[i].isWarning {
            warnings += 1
            continue
        }
        errors += 1
        if first < 0 || pathLess(reported[i].path, by: reported[first].path) ||
            (reported[i].path == reported[first].path && reported[i].start < reported[first].start) {
            first = i
        }
    }
    if first < 0 { return exitFailure }
    Io.stderr.write("\n")
    Io.stderr.write($"{buildFailed(symbols.cross, by: errors, as: warnings)}\n")
    Io.stderr.write($"{buildExplain(reported[first].code)}\n")
    return exitFailure
}

/// L023's check (Bayan only): a `span out of range:` line for each diagnostic, related or fix span that
/// does not lie within its file.
void t26CheckSpans(ref Ctx c) {
    for d in c.diagnostics {
        if d.file < 0 { continue }
        let size = c.files[d.file].text.length
        let path = c.files[d.file].displayPath
        t26CheckSpan(d.span, until: size, for: d.code, at: path)
        for r in d.related { t26CheckSpan(r.span, until: size, for: d.code, at: path) }
        if d.hasFix { t26CheckSpan(d.fixSpan, until: size, for: d.code, at: path) }
    }
}

void t26CheckSpan(TextSpan span, until i64 size, for string code, at string path) {
    if span.start >= 0 && span.length >= 0 && span.end <= size { return }
    print($"span out of range: {code} {path} {span.start}..{span.end} (size {size})")
}

/// DiagTests.cs:20-26: `<file>` compiled alone with `<dir>` as root, tests included with `--tests`, the
/// capabilities and name of `<dir>/package.byn` when there is one, rendered by `RenderAll` uncapped.
i32 golden(in List<string> args) {
    var tests = false
    var includePath = false
    var spans = false
    var dir: string? = null
    var file: string? = null
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--tests" {
            tests = true
        } else if a == "--include-path" {
            includePath = true
        } else if a == "--spans" {
            spans = true
        } else if a == "--package" && i + 1 < args.length {
            i += 1
            dir = args[i]
        } else if file is null && !a.startsWith("-") {
            file = a
        } else {
            return usage()
        }
        i += 1
    }
    let root = dir ?? return usage()
    let path = file ?? return usage()
    var capabilities: List<string>? = null
    var packageName: string? = null
    let manifestPath = t11Combine(root, by: "package.byn")
    if t26FileExists(manifestPath) {
        let m = manifestRead(manifestPath)
        if (m.capabilities is { } caps) { capabilities = copyStrings(in caps) }
        packageName = m.name
    }
    let options = CompilationOptions { includeTests: tests, capabilities: move capabilities, packageName: packageName }
    // `Golden.Load` names the source by its file name.
    var sources = List<lexer.SourceText>()
    sources.append(lexer.SourceText.create(t26FileName(path), from: t11ReadAllBytes(path)))
    var c = create(from: move sources, at: root, by: in options)
    var omitted: i64 = 0
    Io.stdout.write(renderAll(in c, from: in c.diagnostics, by: includePath, until: noLimit, to: ref omitted))
    if spans { t26CheckSpans(ref c) }
    return exitOk
}

/// `--many`: every `*.byn` in `dir`, in name order, as `--golden --package <dir>` prints it, then its
/// `--spans` lines; the shape of `bayan-parse --many` (selfhost/parser/main.byn:58).
i32 many(string dir) {
    var names = Io.listDir(dir) catch return usage()
    names.sort()
    for name in names {
        unless name.endsWith(".byn") { continue }
        let path = t11Combine(dir, by: name)
        var args = List<string>()
        args.append("--package")
        args.append(dir)
        if name.endsWith(".test.byn") { args.append("--tests") }
        args.append("--spans")
        args.append(path)
        print($"== {name}")
        let _ = golden(in args)
    }
    return exitOk
}

/// `--time` (R7): `check`'s compile of `path`, timed by `Compilation.ParseTime`/`CheckTime`
/// (compile.byn:96, :107); the total on stdout as `bayan-parse --time` does (selfhost/parser/main.byn:80).
i32 timed(string path, by in T26Symbols symbols) {
    var args = List<string>()
    args.append(path)
    let o = t26ParseBuildOptions(in args, allowSpans: false) ?? return exitUsage
    var reported = List<T26Reported>()
    var ok = false
    let c = t26Compile(in o, by: in symbols, to: ref reported, through: ref ok)
    print($"{c.parseTime + c.checkTime}")
    Io.stderr.write($"parse {c.parseTime} check {c.checkTime}\n")
    return exitOk
}

/// `--codes`: `code\tmessage` for every `SemaCode` (codes.byn:785 `allSemaCodes`), as `bayan-parse --codes`
/// prints `ParseCode` (selfhost/parser/main.byn:99).
i32 printCodes() {
    for code in allSemaCodes() {
        print($"{codeText(code)}\t{messageFormat(code)}")
    }
    return exitOk
}

i32 main(ReadOnlySpan<string> args) {
    // CliApp.cs:315 `TakeGlobalOptions`: `--color` and `--ascii` come out of everything before a `--`. The
    // arguments are `check`'s (R1), so a command is always given and the script branch never applies.
    var ascii = false
    var rest = List<string>()
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--" {
            for k in i..args.length { rest.append(args[k]) }
            break
        }
        var value: string? = null
        if a == "--ascii" {
            ascii = true
        } else if a == "--color" && i + 1 < args.length {
            i += 1
            value = args[i]
        } else if a.startsWith("--color=") {
            value = a["--color=".length..a.length]
        } else if a == "--color" {
            value = ""
        } else {
            rest.append(a)
        }
        if (value is { } v) {
            if v != "auto" && v != "always" && v != "never" {
                Io.stderr.write($"bayan: unknown color setting `{v}` (expected auto, always or never)\n")
                return exitUsage
            }
        }
        i += 1
    }
    let symbols = t26Symbols(ascii)
    let mode = rest.length > 0 ? rest[0] : ""
    if mode == "--types" {
        rest.remove(at: 0)
        return types(in rest, by: in symbols)
    }
    if mode == "--golden" {
        rest.remove(at: 0)
        return golden(in rest)
    }
    if mode == "--many" { return rest.length == 2 ? many(rest[1]) : usage() }
    if mode == "--time" { return rest.length == 2 ? timed(rest[1], by: in symbols) : usage() }
    if mode == "--codes" { return rest.length == 1 ? printCodes() : usage() }
    return check(in rest, by: in symbols)
}
