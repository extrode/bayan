import parser

// What `instantiatingBegin` saved for `instantiatingEnd`: the C# `Instantiating`'s `Action` split in
// two around the caller's work. `outer` is the sink to restore, `bag` the scratch sink pushed.
struct InstantiatingScope {
    i64 outer
    i64 bag
    FileId site
    TextSpan span
}

