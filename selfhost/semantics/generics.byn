// stub: T13 ports Compilation.cs:1670 FieldDefault
BExpr fieldDefault(ref Ctx c, for StructId s, by FieldId f, from FileId site, at TextSpan span) {
    if f < 0 || f >= c.fields.length || s < 0 || s >= c.structs.length { return -1 }
    if c.fields[f].defaultValue == -1 && c.fields[f].hasDefault && c.structs[s].template >= 0 {
        let scope = instantiatingBegin(ref c, from: site, at: span)
        let file = c.structs[s].file
        var b = t13NewBinder(file, -1, s)
        let defVal = bindFieldDefault(ref b, through: ref c, for: f)
        if defVal >= 0 {
            c.fields[f].defaultValue = defVal
        }
        instantiatingEnd(ref c, by: scope)
    }
    return c.fields[f].defaultValue
}

// stub: T13 ports Compilation.cs:1912 ErrorSetsOf
List<ErrorSetId> errorSetsOf(ref Ctx c, for FuncId fn) {
    if fn < 0 || fn >= c.functions.length { return List<ErrorSetId>() }
    if c.functions[fn].infersErrors || c.functions[fn].kind == .main || c.functions[fn].kind == .testKeyword {
        return List<ErrorSetId>()
    }
    return copyIds(in c.functions[fn].errorSets)
}

// stub: T13 ports Compilation.cs:1796 TemplateOf
FuncId? templateOf(ref Ctx c, for FuncId f) {
    if f < 0 || f >= c.functions.length { return null }
    let t = c.functions[f].template
    return t >= 0 ? t : null
}

// stub: T13 ports Compilation.cs:1753 BindConstant
void bindConstant(ref Ctx c, for ConstId k) {
    if k < 0 || k >= c.consts.length { return }
    if c.consts[k].state == 2 { return }
    if c.consts[k].state == 1 {
        report(ref c, for: .circularConstant, from: c.consts[k].file, at: c.consts[k].nameSpan, by: (c.consts[k].name, "", "", "", ""))
        c.consts[k].type = errorType()
        c.consts[k].state = 2
        return
    }
    c.consts[k].state = 1
    var b = t13NewBinder(c.consts[k].file)
    bindModuleConstant(ref b, through: ref c, for: k)
    c.consts[k].state = 2
}

// stub: T13 ports Compilation.cs:1901 ParameterDefault
BExpr? parameterDefault(ref Ctx c, for FuncId f, by LocalId p) {
    if p < 0 || p >= c.locals.length { return null }
    if c.locals[p].defaultValue >= 0 {
        return c.locals[p].defaultValue
    }
    if f < 0 || f >= c.functions.length { return null }
    let fId = c.functions[f].file
    var b = t13NewBinder(fId, f, c.functions[f].owner)
    let d = bindParameterDefault(ref b, through: ref c, for: p)
    if d >= 0 {
        c.locals[p].defaultValue = d
        return d
    }
    return null
}

