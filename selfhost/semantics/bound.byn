}

/// C# `IterationKind`.
enum IterationKind {
    indexable
    enumerator
}

// ── Constants ──────────────────────────────────────────────────────────────────

/// What a `Constant` holds: C#'s boxed `Int128`, `double`, `bool`, `string` or `Rune` (Q536).
enum ConstantKind {
    integer
    real
    flag
    text
    rune
}

/// C# `ConstantValue`: only the field named by `kind` is meaningful.
struct Constant {
    ConstantKind kind
    Big integer = Big { lo: 0, hi: 0 }
    f64 real = 0.0
    bool flag = false
    string text = ""
    u32 rune = 0
}

/// `ConstantValue.ToString()`.
string constantText(in Constant k) {
    switch k.kind {
        case .integer: return bigText(k.integer)
        case .real: return realText(k.real)
        case .flag: return k.flag ? "true" : "false"
        case .text: return $"\"{k.text}\""
        case .rune: return $"{rune(k.rune)}"
    }
}

/// C#'s `double.ToString()` under the invariant culture: the shortest round-trip digits, in exponent form
/// `1E+20` / `1E-05` when the decimal exponent is at least 17 or below -4; `Infinity`, `-Infinity`, `NaN`.
string realText(f64 v) {
    if v != v { return "NaN" }
    let s = $"{v}"
    if s == "inf" { return "Infinity" }
    if s == "-inf" { return "-Infinity" }
    let b = s.bytes
    // Bayan prints the same shortest digits; re-lay them out C#'s way.
    var sb = StrBuf()
    var i = 0
    if i64(b[0]) == 45 {
        sb.append("-")
        i = 1
    }
    var d = List<i64>()
    var point = -1
    while i < b.length && i64(b[i]) != 101 {
        if i64(b[i]) == 46 {
            point = d.length
        } else {
            d.append(i64(b[i]) - 48)
        }
        i += 1
    }
    if point < 0 { point = d.length }
    var exp = 0
    if i < b.length {
        i += 1
        var negExp = false
        if i64(b[i]) == 45 {
            negExp = true
            i += 1
        }
        while i < b.length {
            exp = exp * 10 + i64(b[i]) - 48
            i += 1
        }
        if negExp { exp = -exp }
    }
    var lead = 0
    while lead < d.length && d[lead] == 0 { lead += 1 }
    if lead == d.length {
        sb.append("0")
        return $"{sb.finish()}"
    }
    var last = d.length - 1
    while d[last] == 0 { last -= 1 }
    // The decimal exponent of the first significant digit.
    let x = point - lead - 1 + exp
    if x >= 17 || x < -4 {
        sb.append($"{d[lead]}")
        if last > lead {
            sb.append(".")
            for j in lead + 1..last + 1 { sb.append($"{d[j]}") }
        }
        var ax = x
        if x < 0 {
            sb.append("E-")
            ax = -x
        } else {
            sb.append("E+")
        }
        if ax < 10 { sb.append("0") }
        sb.append($"{ax}")
        return $"{sb.finish()}"
    }
    if x < 0 {
        sb.append("0.")
        for j in 0..-x - 1 { sb.append("0") }
        for j in lead..last + 1 { sb.append($"{d[j]}") }
        return $"{sb.finish()}"
    }
    for j in 0..x + 1 {
        if lead + j <= last {
            sb.append($"{d[lead + j]}")
        } else {
            sb.append("0")
        }
    }
    if lead + x < last {
        sb.append(".")
        for j in lead + x + 1..last + 1 { sb.append($"{d[j]}") }
    }
    return $"{sb.finish()}"
}

// ── Handles ────────────────────────────────────────────────────────────────────

BNode makeBound(BoundKind kind, at i64 index) => (i64(kind.ordinal) << 32) | index

BoundKind boundKind(BNode n) => BoundKind.fromOrdinal(n >> 32) ?? .errorExpr

i64 boundIndex(BNode n) => n & 0xFFFFFFFF

bool isStmtKind(BoundKind k) => k.ordinal >= BoundKind.block.ordinal && k.ordinal <= BoundKind.errorStmt.ordinal

bool isPatternKind(BoundKind k) {
    switch k {
        case .constantPattern or .relationalPattern or .rangePattern or .bindPattern or .notPattern or .binaryPattern
            or .propertyPattern or .unionPattern or .errorPattern:
            return true
        default:
            return false
    }
}

bool isExprKind(BoundKind k) => !isStmtKind(k) && !isPatternKind(k)

// ── Constants and syntax facts keyed by handle ──────────────────────────────────

/// C# `BoundExpr.Constant`; null when `e` is not a compile-time constant.
Constant? exprConstant(in Ctx c, for BExpr e) => c.constants.tryGet(at: e)

void setConstant(ref Ctx c, for BExpr e, to Constant k) {
    c.constants[e] = k
}

/// `Syntax is LiteralExpr` (BinderExpressions.cs:94, :1496).
const syntaxLiteral: i64 = 1
/// `Syntax is UnaryExpr` (BinderExpressions.cs:1496).
const syntaxUnary: i64 = 2
/// `Syntax is Expr x && IsUntypedLiteral(x)` (BinderExpressions.cs:249).
const syntaxUntypedLiteral: i64 = 4
/// `Syntax is DiscardPattern` (BinderCalls.cs:1590).
const syntaxDiscard: i64 = 8
/// `Syntax is CallExpr` on a builtin method call (RegionAnalysis.cs:451: `sb.finish()`, not `sb.view`).
const syntaxCall: i64 = 16

/// The `syntax…` bits recorded for `n` (0 when none were).
i64 syntaxFlags(in Ctx c, for BNode n) => c.syntaxFlags.tryGet(at: n) ?? 0

/// Records the `syntax…` bits of the node C# would build from the same `Syntax`.
void setSyntaxFlags(ref Ctx c, for BNode n, to i64 flags) {
    c.syntaxFlags[n] = flags
}

bool hasSyntax(in Ctx c, for BNode n, by i64 flag) => (syntaxFlags(in c, for: n) & flag) != 0

// ── Records ────────────────────────────────────────────────────────────────────

struct BLiteral {
    TextSpan span
    Type type
    Constant value
}

struct BSymbolLiteral {
    TextSpan span
    string text
}

struct BDefault {
    TextSpan span
    Type type
}

struct BLocal {
    TextSpan span
    LocalId local
    Type type = -1
}

struct BThis {
    TextSpan span
    Type type
}

struct BField {
    TextSpan span
    BExpr receiver
    FieldId field
    Type type = -1
}

struct BTupleElement {
    TextSpan span
    BExpr receiver
    i64 index
    Type type
}

struct BCall {
    TextSpan span
    FuncId function
    BExpr receiver = -1
    List<BExpr> arguments = List<BExpr>()
    Type type
}

struct BBuiltinCall {
    TextSpan span
    BuiltinMember member
    BExpr receiver
    List<BExpr> arguments = List<BExpr>()
    Type type
}

struct BUnary {
    TextSpan span
    parser.UnaryOp op
    BExpr operand
    Type type
}

struct BBinary {
    TextSpan span
    parser.BinaryOp op
    BExpr left
    BExpr right
    Type type
}

struct BConversion {
    TextSpan span
    BExpr operand
    Type type
    ConversionKind kind
}

struct BTryFrom {
    TextSpan span
    BExpr operand
    Type target
    Type type
}

struct BConditional {
    TextSpan span
    BExpr condition
    BExpr whenTrue
    BExpr whenFalse
    Type type
}

struct BCoalesce {
    TextSpan span
    BExpr left
    BExpr right
    Type type
}

struct BStructLiteral {
    TextSpan span
    StructId structId
    List<BExpr> fields = List<BExpr>()
    VariantId state = -1
    List<BExpr> payload = List<BExpr>()
    Type type = -1
}

struct BWith {
    TextSpan span
    BExpr target
    List<BWithUpdate> updates = List<BWithUpdate>()
    Type type = -1
}

struct BTuple {
    TextSpan span
    Type tupleType
    List<BExpr> elements = List<BExpr>()
}

struct BCollection {
    TextSpan span
    Type type
    List<BExpr> elements = List<BExpr>()
}

struct BSpread {
    TextSpan span
    BExpr operand
    Type type
}

struct BIndex {
    TextSpan span
    BExpr target
    BExpr index
    bool fromEnd = false
    Type type
}

struct BSlice {
    TextSpan span
    BExpr target
    BExpr start = -1
    bool startFromEnd = false
    BExpr end = -1
    bool endFromEnd = false
    bool inclusive = false
    Type type
}

struct BRange {
    TextSpan span
    BExpr start
    BExpr end
    bool inclusive = false
    Type type
}

struct BIs {
    TextSpan span
    BExpr value
    BPattern pattern
}

struct BSwitchExpr {
    TextSpan span
    BExpr value
    List<BSwitchArm> arms = List<BSwitchArm>()
    Type type
}

struct BInterpolated {
    TextSpan span
    List<BInterpolationPart> parts = List<BInterpolationPart>()
}

struct BMove {
    TextSpan span
    BExpr operand
    Type type = -1
}

struct BTry {
    TextSpan span
    BExpr operand
    Type type
}

struct BCatch {
    TextSpan span
    BExpr operand
    LocalId binding = -1
    VariantId variant = -1
    BExpr handler
    Type type
}

struct BJump {
    TextSpan span
    BStmt jump
}

struct BBlockExpr {
    TextSpan span
    BStmt block
    Type type
}

struct BErrorVariant {
    TextSpan span
    VariantId variant
    List<BExpr> payload = List<BExpr>()
    Type type = -1
}

struct BEnumMember {
    TextSpan span
    EnumMemberId member
    Type type = -1
}

struct BUnionNew {
    TextSpan span
    VariantId variant
    List<BExpr> payload = List<BExpr>()
    Type type = -1
}

struct BEnumValues {
    TextSpan span
    EnumId enumId
    Type type
}

struct BStaticArray {
    TextSpan span
    ConstId constId
    Type type = -1
}

struct BStackalloc {
    TextSpan span
    Type element
    i64 count
    Type type
}

struct BErrorExpr {
    TextSpan span
}

struct BTypeRef {
    TextSpan span
    Type referenced
}

struct BModuleRef {
    TextSpan span
    ModId module
}

struct BLambda {
    TextSpan span
    FuncId lambda
    List<BExpr> captures = List<BExpr>()
    Type functionType
}

struct BFunctionRef {
    TextSpan span
    FuncId function
    Type functionType
}

struct BBlock {
    TextSpan span
    List<BStmt> statements = List<BStmt>()
}

struct BLocalDecl {
    TextSpan span
    LocalId local
    BExpr initializer = -1
}

struct BExprStmt {
    TextSpan span
    BExpr expr
}

struct BAssign {
    TextSpan span
    BExpr target
    BExpr value
    parser.BinaryOp? op = null
}

struct BReturn {
    TextSpan span
    BExpr value = -1
}

struct BFail {
    TextSpan span
    BExpr error
}

struct BBecome {
    TextSpan span
    VariantId state
    List<BExpr> payload = List<BExpr>()
}

