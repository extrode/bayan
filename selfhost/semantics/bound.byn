}

struct BPanicDefer {
    TextSpan span
    LocalId panic = -1
    BStmt body
}

struct BSetOnPanic {
    TextSpan span
    FuncId handler
}

struct BContext {
    TextSpan span
    BExpr allocator
    BStmt body
}

struct BErrorStmt {
    TextSpan span
}

struct BConstantPattern {
    TextSpan span
    Type inputType
    BExpr value
}

struct BRelationalPattern {
    TextSpan span
    Type inputType
    parser.BinaryOp op
    BExpr value
}

struct BRangePattern {
    TextSpan span
    Type inputType
    BExpr start
    BExpr end
    bool inclusive = false
}

struct BBindPattern {
    TextSpan span
    Type inputType
    LocalId local = -1
}

struct BNotPattern {
    TextSpan span
    Type inputType
    BPattern operand
}

struct BBinaryPattern {
    TextSpan span
    Type inputType
    bool isAnd = false
    BPattern left
    BPattern right
}

struct BPropertyPattern {
    TextSpan span
    Type inputType
    Type valueType
    List<BSubpattern> subpatterns = List<BSubpattern>()
    LocalId designation = -1
}

struct BUnionField {
    TextSpan span
    BExpr receiver
    VariantId variant
    i64 index
    Type type = -1
}

struct BUnionPattern {
    TextSpan span
    Type inputType
    VariantId variant
    List<BPattern> subpatterns = List<BPattern>()
    LocalId designation = -1
}

struct BErrorField {
    TextSpan span
    BExpr receiver
    VariantId variant
    i64 index
    Type type = -1
}

struct BErrorPattern {
    TextSpan span
    Type inputType
    VariantId variant
    List<BPattern> subpatterns = List<BPattern>()
}

struct BMethodGroup {
    TextSpan span
    BExpr receiver = -1
    FuncId function
    List<TextSpan> typeArgs = List<TextSpan>()
}

struct BVariantGroup {
    TextSpan span
    VariantId variant
}

struct BBuiltinGroup {
    TextSpan span
    BExpr receiver
    string name
}

struct BSwitchArm {
    TextSpan span
    BPattern pattern
    BExpr guard = -1
    BExpr value
}

struct BInterpolationPart {
    string? text = null
    BExpr value = -1
    BFormatSpec? spec = null
}

struct BFormatSpec {
    i64 radix = 0
    bool debug = false
    i64 width = 0
    u32 fill = 32
    i64 align = -1
    i64 digits = -1
}

struct UserIteration {
    IterationKind kind
    FuncId advance = -1
    FuncId item = -1
    LocalId spill = -1
    FieldId advanceField = -1
    FieldId itemField = -1
}

struct BSwitchSection {
    TextSpan span
    BPattern pattern = -1
    BExpr guard = -1
    List<BStmt> body = List<BStmt>()
}

struct BSubpattern {
    List<BMemberStep> path = List<BMemberStep>()
    BPattern pattern
}

struct BMemberStep {
    FieldId field = -1
    PropertyId propertyId = -1
    i64 tupleIndex = -1
    BuiltinMember? builtin = null
    Type type
}

struct StructChecks {
    FuncId check
    List<StructRule> rules = List<StructRule>()
}

struct StructRule {
    TextSpan span
    FieldId field = -1
    BExpr condition
    List<FieldId> reads = List<FieldId>()
}

struct BWithUpdate {
    FieldId field
    BExpr value
}

// ── Constructors ───────────────────────────────────────────────────────────────

BExpr addLiteral(ref Ctx c, from move BLiteral n) {
    c.bLiterals.append(move n)
    return makeBound(.literal, at: c.bLiterals.length - 1)
}

BExpr addSymbolLiteral(ref Ctx c, from move BSymbolLiteral n) {
    c.bSymbolLiterals.append(move n)
    return makeBound(.symbolLiteral, at: c.bSymbolLiterals.length - 1)
}

BExpr addDefault(ref Ctx c, from move BDefault n) {
    c.bDefaults.append(move n)
    return makeBound(.defaultValue, at: c.bDefaults.length - 1)
}

BExpr addLocal(ref Ctx c, from move BLocal n) {
    var m = move n
    // C# `new BoundLocal(n, local) { Type = known }` keeps a narrowed state type (BinderExpressions.cs:526).
    if m.type == -1 { m.type = c.locals[m.local].type }
    c.bLocals.append(move m)
    return makeBound(.local, at: c.bLocals.length - 1)
}

BExpr addThis(ref Ctx c, from move BThis n) {
    c.bThises.append(move n)
    return makeBound(.thisRef, at: c.bThises.length - 1)
}

BExpr addField(ref Ctx c, from move BField n) {
    var m = move n
    m.type = c.fields[m.field].type
    c.bFields.append(move m)
    return makeBound(.field, at: c.bFields.length - 1)
}

BExpr addTupleElement(ref Ctx c, from move BTupleElement n) {
    c.bTupleElements.append(move n)
    return makeBound(.tupleElement, at: c.bTupleElements.length - 1)
}

BExpr addCall(ref Ctx c, from move BCall n) {
    c.bCalls.append(move n)
    return makeBound(.call, at: c.bCalls.length - 1)
}

BExpr addBuiltinCall(ref Ctx c, from move BBuiltinCall n) {
    c.bBuiltinCalls.append(move n)
    return makeBound(.builtinCall, at: c.bBuiltinCalls.length - 1)
}

BExpr addUnary(ref Ctx c, from move BUnary n) {
    c.bUnaries.append(move n)
    return makeBound(.unary, at: c.bUnaries.length - 1)
}

BExpr addBinary(ref Ctx c, from move BBinary n) {
    c.bBinaries.append(move n)
    return makeBound(.binary, at: c.bBinaries.length - 1)
}

BExpr addConversion(ref Ctx c, from move BConversion n) {
    c.bConversions.append(move n)
    return makeBound(.conversion, at: c.bConversions.length - 1)
}

BExpr addTryFrom(ref Ctx c, from move BTryFrom n) {
    c.bTryFroms.append(move n)
    return makeBound(.tryFrom, at: c.bTryFroms.length - 1)
}

BExpr addConditional(ref Ctx c, from move BConditional n) {
    c.bConditionals.append(move n)
    return makeBound(.conditional, at: c.bConditionals.length - 1)
}

BExpr addCoalesce(ref Ctx c, from move BCoalesce n) {
    c.bCoalesces.append(move n)
    return makeBound(.coalesce, at: c.bCoalesces.length - 1)
}

BExpr addStructLiteral(ref Ctx c, from move BStructLiteral n) {
    var m = move n
    // A state literal `T.s { … }` is of type `T.s` (`literal with { State = state, Type = stateType }`, BinderExpressions.cs:1609).
    if m.state == -1 || m.type == -1 { m.type = makeType(.structType, at: m.structId) }
    c.bStructLiterals.append(move m)
    return makeBound(.structLiteral, at: c.bStructLiterals.length - 1)
}

BExpr addWith(ref Ctx c, from move BWith n) {
    var m = move n
    m.type = exprType(in c, for: m.target)
    c.bWiths.append(move m)
    return makeBound(.withExpr, at: c.bWiths.length - 1)
}

BExpr addTuple(ref Ctx c, from move BTuple n) {
    c.bTuples.append(move n)
    return makeBound(.tuple, at: c.bTuples.length - 1)
}

BExpr addCollection(ref Ctx c, from move BCollection n) {
    c.bCollections.append(move n)
    return makeBound(.collection, at: c.bCollections.length - 1)
}

BExpr addSpread(ref Ctx c, from move BSpread n) {
    c.bSpreads.append(move n)
    return makeBound(.spread, at: c.bSpreads.length - 1)
}

BExpr addIndex(ref Ctx c, from move BIndex n) {
    c.bIndexes.append(move n)
    return makeBound(.index, at: c.bIndexes.length - 1)
}

BExpr addSlice(ref Ctx c, from move BSlice n) {
    c.bSlices.append(move n)
    return makeBound(.slice, at: c.bSlices.length - 1)
}

BExpr addRange(ref Ctx c, from move BRange n) {
