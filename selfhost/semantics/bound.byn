    stringLines
    stringParts
    stringPartsRune
    runesTake
    runesSkip
    runesTakeLast
    utf16Copy
    textViewMore
    textViewNext
    spanLength
    spanIsEmpty
    spanCopy
    listCopy
    mapCopy
    strBufCopy
    listLength
    listIsEmpty
    listAdd
    listAsSpan
    listMutableSpan
    arrayMutableSpan
    listClear
    listRemoveLast
    listRemoveRange
    listRemoveThrough
    listRemoveAt
    listRemoveAtRange
    listReplace
    listSort
    listTryGet
