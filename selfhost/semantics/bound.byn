    mapTryGet
    mapContains
    mapRemove
    mapClear
    mapIndex
    mapIndexSet
    mapSlot
    mapSlotCount
    mapSlotLive
    mapSlotEntry
    arrayLength
    arrayAsSpan
    arenaReset
    strBufAppend
    strBufAppendRepeated
    strBufInsert
    strBufLength
    strBufAsString
    strBufClear
    symbolText
    listTake
    mapTake
    strBufTake
    optionalTake
    charValue
    intToString
    resultIsOk
    resultValue
    resultError
    ownedValue
    ioWrite
    ioReadAll
    enumName
    enumOrdinal
