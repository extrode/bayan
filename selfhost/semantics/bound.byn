}

struct BSwitch {
    TextSpan span
    BExpr value
    List<BSwitchSection> sections = List<BSwitchSection>()
    i64 target
    bool exhaustive = false
}

struct BDefer {
    TextSpan span
    BStmt body
}

struct BAssert {
    TextSpan span
    BExpr condition
    ErrorSetId failsWith = -1
    VariantId failsCase = -1
}

struct BErrdefer {
    TextSpan span
    LocalId error = -1
