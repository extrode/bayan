// bayan-emit: the self-hosted C emitter (spec 011). T1 is the skeleton: the arguments of `bayan-check` plus
// `--mode` and `--tests`, the shared CLI pieces of `semantics/cli.byn` (D2), then `lower` and `cprint.emit`,
// which are stubs until T2-T11. T12 owns the full CLI (`--package`, `--many`, `--time`).
//
//     bayan-emit [--ascii] [--color <when>] [--mode debug|safe|fast] [--tests] <path>
//                                    the C `bayan build --emit-c <path>` writes, on stdout

import semantics
import emitter.cprint

const exitOk: i32 = 0
const exitFailure: i32 = 1
const exitUsage: i32 = 2

i32 usage() {
    Io.stderr.write("usage: bayan-emit [--ascii] [--color <when>] [--mode debug|safe|fast] [--tests] <path>\n")
    return exitUsage
}

i32 main(ReadOnlySpan<string> args) {
    var ascii = false
    var mode = "safe"
    var tests = false
    var rest = List<string>()
    var i: i64 = 0
    while i < args.length {
        let a = args[i]
        if a == "--ascii" {
            ascii = true
        } else if a == "--color" && i + 1 < args.length {
            i += 1
        } else if a == "--mode" && i + 1 < args.length {
            i += 1
            mode = args[i]
        } else if a == "--tests" {
            tests = true
        } else {
            rest.append(a)
        }
        i += 1
    }
    if mode != "debug" && mode != "safe" && mode != "fast" {
        Io.stderr.write($"bayan: unknown mode `{mode}` (expected debug, safe or fast)\n")
        return exitUsage
    }
    let symbols = semantics.t26Symbols(ascii)
    let o = semantics.t26ParseBuildOptions(in rest, allowSpans: false) ?? return exitUsage
    var reported = List<semantics.T26Reported>()
    var ok = false
    var c = semantics.t26Compile(in o, by: in symbols, to: ref reported, through: ref ok)
    unless ok { return semantics.t26Failed(in o, from: in reported, by: in symbols) }
    var l = LCtx {}
    let program = lower(ref c, to: ref l)
    Io.stdout.write(cprint.emit(ref c, in l, in program, ownershipChecks: mode == "debug"))
    return exitOk
}
