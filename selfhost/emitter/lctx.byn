// T1: LoweredNodes.cs 1-127, Lowerer.cs 37-41 and 48-76 (state; 42-47 are D3's).
//
// The lowered tree shares the bound tree's handle space (bound.byn:3): a lowered node is
// `(LKind << 32) | index` into a per-kind arena on `LCtx`, -1 is null, and `LKind`'s ordinals start at 100,
// above `BoundKind`'s 77 members, so a `BStmt`/`BExpr` handle and a lowered one tell apart by kind without a
// tag. One struct per C# record, fields in C# order: `Node Syntax` is `TextSpan span`, a symbol is its
// semantics handle, `T[]` is a `List<T>`, and a base type computed from a field (`LOptionalValue`'s `Type`)
// is the field. The records that C# derives from `BoundStmt`/`BoundExpr` only for their `Syntax` and `Type`
// carry the same two facts: `span` and, where C# passes it, `type`. `LMutantIs` and `LCount` are D3's and
// not ported. Each task's `LCtx` fields live in its own `// ── Tn state` section.

import semantics

public type TextSpan = semantics.TextSpan
public type Type = semantics.Type
public type FuncId = semantics.FuncId
public type LocalId = semantics.LocalId
public type VariantId = semantics.VariantId
public type TestId = semantics.TestId
public type BExpr = semantics.BExpr
public type BStmt = semantics.BStmt
public type BPattern = semantics.BPattern
public type BInterpolationPart = semantics.BInterpolationPart

/// A lowered node, or a bound one: `(kind << 32) | index`; -1 is null.
public type LNode = i64

// ── Kinds ──────────────────────────────────────────────────────────────────────

/// The first `LKind` ordinal; `BoundKind` has 77 members (0..76).
const lKindBase: i64 = 100

/// `LoweredNodes.cs` order, minus D3's `LMutantIs` and `LCount`. The handle's kind is `lKindBase + ordinal`.
public enum LKind {
    label
    gotoStmt
    loop
    returnStmt
    returnError
    failingCall
    write
    panic
    setContext
    freeArena
    pushPanicHandler
    popPanicHandler
    claim
    optionalHas
    optionalValue
    unionTag
    unionField
    errorCode
    errorField
    assignExpr
    sequence
    indexUnchecked
    nextChar
    neverValue
    functionValue
    voidValue
}

/// `WriteSink`.
public enum WriteSink {
    print
    panic
    strBuf
    log
}

public LNode lNode(LKind kind, i64 index) => ((lKindBase + i64(kind)) << 32) | index

/// Whether `n` is a lowered handle rather than a bound one.
public bool isLowered(LNode n) => n >= 0 && (n >> 32) >= lKindBase

public LKind lKindOf(LNode n) => LKind.tryFrom((n >> 32) - lKindBase) ?? .voidValue

public i64 lIndexOf(LNode n) => n & 0xFFFFFFFF

// ── Lowered records ────────────────────────────────────────────────────────────

/// A jump target; emitted as `name:;`.
public struct LLabel {
    public TextSpan span
    public string name
}

public struct LGoto {
    public TextSpan span
    public string label
}

/// `for (;;) { body }`; leave it only through `LGoto`.
public struct LLoop {
    public TextSpan span
    public BStmt body
}

/// Returns normally. For a failing function the value goes to the result pointer and the error code is 0; a constructor returns its `this`. `value` -1 is C#'s null.
public struct LReturn {
    public TextSpan span
    public BExpr value = -1
}

/// Returns the error code in `code` (a local of an error type) from a failing function.
public struct LReturnError {
    public TextSpan span
    public BExpr code
}

/// `error = call(…, &result)` for a function that can fail.
public struct LFailingCall {
    public TextSpan span
    public LocalId error
    public BExpr call
    public LocalId result = -1
}

/// Formats `parts` into a stack buffer and sends it to the sink. A part with a `guards` entry (-1 for none) is written only when that condition holds.
public struct LWrite {
    public TextSpan span
    public WriteSink sink
    public BExpr target = -1
    public List<BInterpolationPart> parts
    public List<BExpr>? guards = null
}

/// Panics with a fixed message (failed `assert`, unmatched `switch`).
public struct LPanic {
    public TextSpan span
    public string message
}

/// Sets `context.allocator` to `arena`, saving the previous one in slot `slot`; with no arena, restores the saved allocator.
public struct LSetContext {
    public TextSpan span
    public BExpr arena = -1
    public i64 slot
}

/// Frees an arena declared with `using`.
public struct LFreeArena {
    public TextSpan span
    public BExpr arena
}

/// Registers the `defer panicking` handler in slot `slot`.
public struct LPushPanicHandler {
    public TextSpan span
    public i64 slot
    public LocalId panic = -1
    public BStmt body
}

/// Unregisters the handler in slot `slot` as its scope ends.
public struct LPopPanicHandler {
    public TextSpan span
    public i64 slot
}

/// Debug builds: a `switch move x` binding owns its storage once its arm is selected; nothing otherwise.
public struct LClaim {
    public TextSpan span
    public LocalId local
}

/// Whether an optional holds a value (type bool).
public struct LOptionalHas {
    public TextSpan span
    public BExpr optional
}

/// The value inside an optional already known to hold one.
public struct LOptionalValue {
    public TextSpan span
    public BExpr optional
    public Type type
}

/// A union's tag: its variant's declaration index (type i32).
public struct LUnionTag {
    public TextSpan span
    public BExpr unionValue
}

/// A payload field of a union already known to hold `variant`; its type is `variant`'s field `index`.
public struct LUnionField {
    public TextSpan span
    public BExpr unionValue
    public VariantId variant
    public i64 index
}

/// An error's code: its case's program-wide number, 0 for none (type u32).
public struct LErrorCode {
    public TextSpan span
    public BExpr error
}

/// A payload field of an error already known to be `variant`.
public struct LErrorField {
    public TextSpan span
    public BExpr error
    public VariantId variant
    public i64 index
}

/// `(target = value)` as an expression; used for pattern bindings.
public struct LAssignExpr {
    public TextSpan span
    public BExpr target
    public BExpr value
}

/// C's comma operator: evaluates `effects`, then `value`.
public struct LSequence {
    public TextSpan span
    public List<BExpr> effects
    public BExpr value
}

/// An element read whose index the compiler proved in range (loop over a sequence).
public struct LIndexUnchecked {
    public TextSpan span
    public BExpr target
    public BExpr index
    public Type type
}

/// The next char of `text` at byte offset `position` (a local), advancing it (type char).
public struct LNextChar {
    public TextSpan span
    public BExpr text
    public LocalId position
}

/// The value of an expression that never completes (it jumped, failed or panicked).
public struct LNever {
    public TextSpan span
    public Type type
}

/// A function value: `function`'s code with `env` (the captures tuple) or no environment.
// Q1: round 4 redoes this (the `env` field, LoweredNodes.cs:118).
public struct LFunctionValue {
    public TextSpan span
    public FuncId function
    public LocalId env = -1
    public Type functionType
}

/// The value of a `void` expression whose effects were already emitted.
public struct LVoid {
    public TextSpan span
}

// ── Program ────────────────────────────────────────────────────────────────────

/// `LoweredFunction`: a function body with every local (not parameter) it uses, in first-use order.
public struct LoweredFunction {
    public FuncId symbol
    public List<LocalId> locals
    public i64 contextSlots
    public i64 panicSlots
    public BStmt body
}

/// `LoweredProgram`, with a `Ctx` passed alongside instead of `Compilation`; no `mutants`/`coverage` (D3).
public struct LoweredProgram {
    public List<LoweredFunction> functions
    public FuncId main
    public List<TestId> tests
    public List<LoweredFunction> testFunctions
}

// ── Cleanups (Lowerer.cs:61-76) ────────────────────────────────────────────────

/// `Cleanup`: `DeferCleanup`, `ErrdeferCleanup`, `RestoreContext`, `FreeArena`, `PopPanicHandler`.
public union LCleanup {
    deferCleanup(BStmt body)
    errdeferCleanup(LocalId error, BStmt body)
    restoreContext(TextSpan span, i64 slot)
    freeArena(TextSpan span, LocalId arena)
    popPanicHandler(TextSpan span, i64 slot)
}

/// `Scope`.
public struct LScope {
    public List<LCleanup> cleanups = List<LCleanup>()
}

/// `_targets` value: the break label, the continue label and the cleanup depth of a jump target.
public struct LTarget {
    public string breakLabel
    public string? continueLabel = null
    public i64 depth
}

// ── The lowerer's state ────────────────────────────────────────────────────────

/// Everything the lowering reads and writes for one program: the arenas of the lowered kinds, then
/// `FunctionLowerer`'s fields. Each task adds its fields in its own `// ── Tn state` section.
public struct LCtx {
    // ── T1 state: arenas, one per `LKind`
    public List<LLabel> labels = List<LLabel>()
    public List<LGoto> gotoStmts = List<LGoto>()
    public List<LLoop> loops = List<LLoop>()
    public List<LReturn> returnStmts = List<LReturn>()
    public List<LReturnError> returnErrors = List<LReturnError>()
    public List<LFailingCall> failingCalls = List<LFailingCall>()
    public List<LWrite> writes = List<LWrite>()
    public List<LPanic> panics = List<LPanic>()
    public List<LSetContext> setContexts = List<LSetContext>()
    public List<LFreeArena> freeArenas = List<LFreeArena>()
    public List<LPushPanicHandler> pushPanicHandlers = List<LPushPanicHandler>()
    public List<LPopPanicHandler> popPanicHandlers = List<LPopPanicHandler>()
    public List<LClaim> claims = List<LClaim>()
    public List<LOptionalHas> optionalHass = List<LOptionalHas>()
    public List<LOptionalValue> optionalValues = List<LOptionalValue>()
    public List<LUnionTag> unionTags = List<LUnionTag>()
    public List<LUnionField> unionFields = List<LUnionField>()
    public List<LErrorCode> errorCodes = List<LErrorCode>()
    public List<LErrorField> errorFields = List<LErrorField>()
    public List<LAssignExpr> assignExprs = List<LAssignExpr>()
    public List<LSequence> sequences = List<LSequence>()
    public List<LIndexUnchecked> indexUncheckeds = List<LIndexUnchecked>()
    public List<LNextChar> nextChars = List<LNextChar>()
    public List<LNever> neverValues = List<LNever>()
    public List<LFunctionValue> functionValues = List<LFunctionValue>()
    public List<LVoid> voidValues = List<LVoid>()

    // ── T1 state: FunctionLowerer (Lowerer.cs:40-41, 48-59)
    /// `_fn`.
    public FuncId fn = -1
    /// `_out` and the capture stack (D5): the current output list is the last; `captureBegin` pushes, `captureEnd` pops.
    public List<List<BStmt>> outs = List<List<BStmt>>()
    /// `_locals`: the locals used, in first-use order.
    public List<LocalId> locals = List<LocalId>()
    /// `_seen`.
    public Map<LocalId, bool> seen = Map<LocalId, bool>()
    /// `_scopes`.
    public List<LScope> scopes = List<LScope>()
    /// `_targets`, keyed by `JumpTarget.id` (D6).
    public Map<i64, LTarget> targets = Map<i64, LTarget>()
    /// `_labels`.
    public i64 labelCount = 0
    /// `_contextSlots`.
    public i64 contextSlots = 0
    /// `_panicSlots`.
    public i64 panicSlots = 0
    /// `_shown != null`: while an `assert` condition is lowered.
    public bool showing = false
    /// `_shown`: the sub-expressions the assert shows, each with its stored value once lowered (-1 before).
    public Map<BExpr, BExpr> shown = Map<BExpr, BExpr>()
    /// `_ran`: the shown sub-expressions that may not run (a lazy side), each with the flag set when it does.
    public Map<BExpr, LocalId> ran = Map<BExpr, LocalId>()
}

// ── Constructors ───────────────────────────────────────────────────────────────

public LNode newLLabel(ref LCtx l, TextSpan span, string name) {
    l.labels.append(LLabel { span: span, name: name })
    return lNode(.label, l.labels.length - 1)
}

public LNode newLGoto(ref LCtx l, TextSpan span, string label) {
    l.gotoStmts.append(LGoto { span: span, label: label })
    return lNode(.gotoStmt, l.gotoStmts.length - 1)
}

public LNode newLLoop(ref LCtx l, TextSpan span, BStmt body) {
    l.loops.append(LLoop { span: span, body: body })
    return lNode(.loop, l.loops.length - 1)
}

public LNode newLReturn(ref LCtx l, TextSpan span, BExpr value = -1) {
    l.returnStmts.append(LReturn { span: span, value: value })
    return lNode(.returnStmt, l.returnStmts.length - 1)
}

public LNode newLReturnError(ref LCtx l, TextSpan span, BExpr code) {
    l.returnErrors.append(LReturnError { span: span, code: code })
    return lNode(.returnError, l.returnErrors.length - 1)
}

public LNode newLFailingCall(ref LCtx l, TextSpan span, LocalId error, BExpr call, LocalId result = -1) {
    l.failingCalls.append(LFailingCall { span: span, error: error, call: call, result: result })
    return lNode(.failingCall, l.failingCalls.length - 1)
}

public LNode newLWrite(ref LCtx l, TextSpan span, WriteSink sink, BExpr target = -1, move List<BInterpolationPart> parts, move List<BExpr>? guards) {
    l.writes.append(LWrite { span: span, sink: sink, target: target, parts: move parts, guards: move guards })
    return lNode(.write, l.writes.length - 1)
}

public LNode newLPanic(ref LCtx l, TextSpan span, string message) {
    l.panics.append(LPanic { span: span, message: message })
    return lNode(.panic, l.panics.length - 1)
}

public LNode newLSetContext(ref LCtx l, TextSpan span, BExpr arena = -1, i64 slot) {
    l.setContexts.append(LSetContext { span: span, arena: arena, slot: slot })
    return lNode(.setContext, l.setContexts.length - 1)
}

public LNode newLFreeArena(ref LCtx l, TextSpan span, BExpr arena) {
    l.freeArenas.append(LFreeArena { span: span, arena: arena })
    return lNode(.freeArena, l.freeArenas.length - 1)
}

public LNode newLPushPanicHandler(ref LCtx l, TextSpan span, i64 slot, LocalId panic = -1, BStmt body) {
    l.pushPanicHandlers.append(LPushPanicHandler { span: span, slot: slot, panic: panic, body: body })
    return lNode(.pushPanicHandler, l.pushPanicHandlers.length - 1)
}

public LNode newLPopPanicHandler(ref LCtx l, TextSpan span, i64 slot) {
    l.popPanicHandlers.append(LPopPanicHandler { span: span, slot: slot })
    return lNode(.popPanicHandler, l.popPanicHandlers.length - 1)
}

public LNode newLClaim(ref LCtx l, TextSpan span, LocalId local) {
    l.claims.append(LClaim { span: span, local: local })
    return lNode(.claim, l.claims.length - 1)
}

public LNode newLOptionalHas(ref LCtx l, TextSpan span, BExpr optional) {
    l.optionalHass.append(LOptionalHas { span: span, optional: optional })
    return lNode(.optionalHas, l.optionalHass.length - 1)
}

public LNode newLOptionalValue(ref LCtx l, TextSpan span, BExpr optional, Type type) {
    l.optionalValues.append(LOptionalValue { span: span, optional: optional, type: type })
    return lNode(.optionalValue, l.optionalValues.length - 1)
}

public LNode newLUnionTag(ref LCtx l, TextSpan span, BExpr unionValue) {
    l.unionTags.append(LUnionTag { span: span, unionValue: unionValue })
    return lNode(.unionTag, l.unionTags.length - 1)
}

public LNode newLUnionField(ref LCtx l, TextSpan span, BExpr unionValue, VariantId variant, i64 index) {
    l.unionFields.append(LUnionField { span: span, unionValue: unionValue, variant: variant, index: index })
    return lNode(.unionField, l.unionFields.length - 1)
}

public LNode newLErrorCode(ref LCtx l, TextSpan span, BExpr error) {
    l.errorCodes.append(LErrorCode { span: span, error: error })
    return lNode(.errorCode, l.errorCodes.length - 1)
}

public LNode newLErrorField(ref LCtx l, TextSpan span, BExpr error, VariantId variant, i64 index) {
    l.errorFields.append(LErrorField { span: span, error: error, variant: variant, index: index })
    return lNode(.errorField, l.errorFields.length - 1)
}

public LNode newLAssignExpr(ref LCtx l, TextSpan span, BExpr target, BExpr value) {
    l.assignExprs.append(LAssignExpr { span: span, target: target, value: value })
    return lNode(.assignExpr, l.assignExprs.length - 1)
}

public LNode newLSequence(ref LCtx l, TextSpan span, move List<BExpr> effects, BExpr value) {
    l.sequences.append(LSequence { span: span, effects: move effects, value: value })
    return lNode(.sequence, l.sequences.length - 1)
}

public LNode newLIndexUnchecked(ref LCtx l, TextSpan span, BExpr target, BExpr index, Type type) {
    l.indexUncheckeds.append(LIndexUnchecked { span: span, target: target, index: index, type: type })
    return lNode(.indexUnchecked, l.indexUncheckeds.length - 1)
}

public LNode newLNextChar(ref LCtx l, TextSpan span, BExpr text, LocalId position) {
    l.nextChars.append(LNextChar { span: span, text: text, position: position })
    return lNode(.nextChar, l.nextChars.length - 1)
}

public LNode newLNever(ref LCtx l, TextSpan span, Type type) {
    l.neverValues.append(LNever { span: span, type: type })
    return lNode(.neverValue, l.neverValues.length - 1)
}

public LNode newLFunctionValue(ref LCtx l, TextSpan span, FuncId function, LocalId env = -1, Type functionType) {
    l.functionValues.append(LFunctionValue { span: span, function: function, env: env, functionType: functionType })
    return lNode(.functionValue, l.functionValues.length - 1)
}

public LNode newLVoid(ref LCtx l, TextSpan span) {
    l.voidValues.append(LVoid { span: span })
    return lNode(.voidValue, l.voidValues.length - 1)
}
