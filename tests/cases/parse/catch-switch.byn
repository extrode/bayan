let resp = signUp(form) catch switch {
    EmailError => .badRequest("Invalid email"),
    DbError.timeout => .unavailable,
    DbError e => .serverError(e),
}
save(x) catch switch {
    IoError e => log(e),
    _ => log("other"),
}
let old = parse(s) catch switch {
    .empty => 0,
    _ => 1,
}
let n = parse(s) catch switch {
    ParseError e => fallback(e),
}
