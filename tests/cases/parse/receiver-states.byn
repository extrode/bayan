struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
        shipped
    }
    void pay(move this is .draft, i64 amount) becomes .paid {
        become .paid(amount)
    }
    void ship(move this) becomes .shipped {
        become .shipped
    }
    i64 total(this is .paid or .shipped) => id
}

void archive(Order order is .paid or .shipped) {
    print(order.id)
}

void refund(Order.paid order) {
    print(order.payment)
}
