CompilationUnit
  Struct Circle : IShape
    Field f32 r
    Function area() -> f32 => (* r r)
  Struct Wrapper<T> : IShape, m.IDescribe where T : IShape, IOrder<T>
    Field T inner
  Struct Stream : IEnumerator
    TypeAlias Item = Token
    Field i64 i
  Union Shape : IShape
    Variant circle(f32 r)
    Variant none
  Union Box<T> : IShape where T : IShape
    Variant full(T v)
    Variant empty
  Enum Color : IShape
    Member red
    Member green
  Enum Planet(f64 mass) : IShape where T : IShape
    Member earth(1.0)
    Member mars(0.1)
  Function max<T>(T a, T b) -> T where T : IOrder<T> => (? (call (. a less) b) b a)
  Function parse<T>(string s) -> T where T : IParse<T> fails
    Block
      Return (call (. T parse) s)
  Function read<T>(string s) -> T where T : IParse<T>, IShape where U : IShape expects (> (. s length) 0) fails IoError
    Block
      Return (call (. T parse) s)
