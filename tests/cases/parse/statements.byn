void main() {
    let a = 1
    var b = 2
    const c = 3
    let d: i64 = 4
    var e: u8 = 5
    let f: i64 = 6
    var m: Money
    using let arena = Arena()
    b = 7
    b += 1
    b -= 1
    b *= 2
    b /= 2
    b %= 3
    b <<= 1
    b >>= 1
    b &= 1
    b |= 2
    b ^= 3
    m.cents = 9
    xs[0] = 1
    b++
    b--
    ++b
    _ = f()
    if a > 0 { print("pos") } else if a < 0 { print("neg") } else { print("zero") }
    unless ok { retry() }
    while b > 0 { b-- }
    do { b++ } while b < 10
    for i in 0..10 { total += i }
    for x in xs { print(x) }
    for i64 i in 0..=n {}
    for y in ys {}
    outer: for row in grid {
        for cell in row {
            break outer if cell == 0
            continue outer
        }
    }
