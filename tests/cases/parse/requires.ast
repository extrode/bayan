CompilationUnit
  Function discount(i32 total, i32 percent) -> i32 expects (in percent (..= 0 100)) expects (>= total 0) => (- total (/ (* total percent) 100))
  Function check(i32 n) -> void expects (&& (in n (.. 1 10)) (!= n 5)) fails
    Block
      Expr (call print (interp (in n (..= 0 (* n 2)))))
