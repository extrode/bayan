interface IShape {
    f32 area()
    string name
    string describe() => $"area {area()}"
    string shout() {
        return name
    }
}

interface IEnumerator {
    type Item
    bool moveNext(ref this)
    Item current
}

interface IOrder<T> {
    bool less(T other)
    bool more(T other) => other.less(this)
}

interface IParse<T> where T : IOrder<T> {
    static T parse(string text)
    T get<U>()
}

extension Money : IShape, IOrder<Money> {
    f32 area() => 0
}

extension Cents : IShape
