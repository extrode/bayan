CompilationUnit
  Let ints = (list 42 1_000_000 0xFF 0b1010 5u 7ul)
  Let floats = (list 3.14 1e5 2.5e-3 1.50dec)
  Let chars = (list 'a' '\n' '\u{1F600}')
  Let strings = (list "text" c"cstr" u16"wide" "esc\t\"q\"")
  Let raw = "first\n  second"
  Let msg = (interp "total " sum " for " (. lines length) " lines, {braces}")
  Let nested = (interp "outer " (interp "inner " x))
  Let p = (struct Point (x 1) (y (- 2)))
  Let q = (with p (x 3))
  Let t = (tuple 1 "a")
  Let named = (tuple (x: 1) (y: 2))
  Let empty = (list)
  Let spread = (list (spread a) (spread b))
  Let cast = (cast u8 (paren (+ x 1)))
  Let neg = (- (paren (- a b)))
  Let bits = (| (& (~ a) 0xF) (<< b 2))
  Let r = (.. 0 n)
  Let ri = (..= 0 n)
  Let last = (index xs (^ 1))
  Let mid = (index xs (.. 1 (^ 1)))
  Let opt = (?? (?. a b) c)
  Let tern = (? (> a b) a b)
  Let tried = (try (call parse s))
  Let caught = (catch (call parse s) 0)
  Let early = (catch (call parse s) (return 1))
  Let handled = (catch (call parse s) (switch (caught) (.invalid => 1) (.tooPrecise => 2)))
  Let some = (catch (call parse s) (variant (. MoneyError invalid)) 0)
  Let found = (?? (call (. map get) k) (return))
  Let wrapped = (-% (+% a b) (*% c d))
  Let saturated = (-| (+| a b) (*| c d))
  Let gen = (call List<List<i64>>)
  Let buf = (stackalloc u8 64)
  Let ok = (&& true (! false))
  Let nothing = null
  Let me = this
  Let call = (call f x (y: 2) (ref z) (move w) (out v))
  Let chain = (. (index (. (call (. a b) c) d) e) f)
