Package {
    name: "local/shop",
    version: "0.1.0",
    edition: 2027,
    kind: .app,
    capabilities: [.net],
    deps: [],
    test: Tests { diffCoverage: 80, nightly: [.fuzz] },
    dist: Dist { targets: [.host], mode: .safe },
    style: Style {
        indent: 4,
        braces: .sameLine,
        maxLine: 100,
        trailingCommas: true,
    },
}
