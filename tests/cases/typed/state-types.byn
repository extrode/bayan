struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
        shipped
    }
    void pay(move this is .draft, i64 amount) becomes .paid {
        become .paid(amount)
    }
    i64 receipt(this is .paid or .shipped) => id
}

i64 archive(Order order is .paid or .shipped) => order.receipt()

i64 refund(Order.paid order) {
    let any: Order = order
    let done: Order is .paid or .shipped = order
    return archive(order) + done.id + any.id
}

let paid = Order.paid { id: 1, payment: 5 }
let draft: Order.draft = { id: 2 }
print($"{refund(paid)} {draft.id}")
