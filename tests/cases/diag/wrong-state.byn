struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
        shipped
    }
    i64 receipt(this is .paid) => id
    i64 total(this is .draft) => receipt()
}

i64 refund(Order.paid order) => order.id

i64 archive(Order order is .paid or .shipped) => order.id

let order = Order.draft { id: 1 }
let any: Order = order
let refunded = refund(any)
let archived = archive(order)
let receipt = order.receipt()
