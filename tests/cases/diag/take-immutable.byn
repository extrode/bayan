// `take()` writes its receiver, so the place must be writable (as for `clear()`).
struct Bag {
    List<i64> items
}

void readPlain(List<i64> plain) {
    let a = plain.take()
}

void readField(Bag bag) {
    let b = bag.items.take()
}

void readElement(ReadOnlySpan<List<i64>> view) {
    let c = view[0].take()
}

void main() {
    let items = List<i64>()
    let d = items.take()
}
