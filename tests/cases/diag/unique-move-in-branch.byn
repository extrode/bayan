// A move in one branch makes the local unusable after the branches join (BYN2781).
void consume(move List<i64> xs) {
    print($"{xs.count}");
}

void main(ReadOnlySpan<string> args) {
    let a = List<i64>();
    if args.count > 0 {
        consume(move a);
    } else {
        print("kept");
    }
    print($"{a.count}");
}
