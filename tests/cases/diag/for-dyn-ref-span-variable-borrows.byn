interface IThing {
    i64 get()
}

struct S : IThing {
    i64 n

    i64 get() => n
}

// The variable of `for dyn ref I x in span` points where the span points: kept past the loop, it borrows that list.
void main() {
    var keep = List<S>()
    keep.append(S { n: 7 })
    var xs = List<S>()
    xs.append(S { n: 1 })
    Span<S> sp = xs.asSpan()
    dyn ref IThing d = keep[0]
    for dyn ref IThing x in sp {
        d = x
    }
    xs.append(S { n: 2 })
    print($"{d.get()}")
}
