// A `ref this` call through a writable `dyn ref` local modifies what it borrows (BYN3004).
interface IReset { void reset(ref this); }
struct B : IReset {
    List<i64> items;
    void reset(ref this) { items.clear(); items.append(7); }
}
void main() {
    var b = B { items: List<i64>() };
    b.items.append(1);
    let s = b.items.asSpan();
    dyn ref IReset r = b;
    r.reset();
    print($"{s[0]}");
}
