// `switch (move …)` needs a local or a `move` parameter as its subject (BYN2789).
union Slot {
    Empty,
    Full(List<i64> items),
}

struct Box {
    Slot slot;
}

void inspect(Slot plain) {
    let box = Box { slot = Slot.Empty };
    let slots = List<Slot>();
    switch (move box.slot) {
        default:
    }
    switch (move slots[0]) {
        default:
    }
    switch (move plain) {
        default:
    }
}
