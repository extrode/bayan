struct Holder {
    List<i64> items;
}

void use(Arena a) {
    var lists = List<List<i64>>();
    let l = lists.copy(to: a);
    var maps = Map<string, StrBuf>();
    let m = maps.copy(to: a);
    var keyed = Map<i64, Holder>();
    let k = keyed.copy(to: a);
    var owned = List<Owned<i64>?>();
    let o = owned.copy(to: a);
    var fine = Map<string, i64[2]>();
    let f = fine.copy(to: a);
}
