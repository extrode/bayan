struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
    }
    void pay(ref this is .draft, i64 amount) becomes .paid {
        if amount <= 0 {
            return
        }
        become .paid(amount)
    }
    void settle(ref this is .draft, i64 amount) becomes .paid {
        if amount > 0 {
            become .paid(amount)
        }
    }
    void confirm(ref this is .draft, i64 amount) becomes .paid {
        if amount > 0 {
            become .paid(amount)
        } else {
            become .paid(0)
        }
        return
    }
}
