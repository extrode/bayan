// A pattern in `switch (move …)` may not bind the same storage twice (BYN2790).
struct Ledger {
    List<i64> items;
}

union Box {
    full(Ledger ledger),
    empty,
}

void keep(move List<i64> xs) { }

void inspect() {
    let a = List<i64>();
    switch (move a) {
        case let x and let y:
            keep(move x);
        default:
    }
    let l = Ledger { items = List<i64>() };
    switch (move l) {
        case Ledger { items: let it } whole:
            keep(move it);
        default:
    }
    let m = Ledger { items = List<i64>() };
    switch (move m) {
        case { items: let p, items: let q }:
            keep(move p);
            keep(move q);
        default:
    }
    let b = Box.full(Ledger { items = List<i64>() });
    switch (move b) {
        case .full({ items: let p, items: let q }):
            keep(move p);
            keep(move q);
        default:
    }
}
