void main() {
    var xs = List<i64>()
    xs.append(1)
    let view = xs.span
    xs.append(2)
    print($"{view[0]}")
    let again = xs.span
    xs.remove(from: 0, until: 1)
    print($"{again[0]}")
    for x in xs {
        xs.append(x)
    }
    using var arena = Arena()
    let name = "ann".copy(to: arena)
    arena.reset()
    print(name)
}
