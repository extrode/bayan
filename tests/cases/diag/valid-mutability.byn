struct Id {
    readonly i64 value
    required string label
}

void bump(ref i64 total, i64 by = 1) {
    total += by
}

void fill(out i64 result) {
    result = 7
}

var count: i64 = 0
count += 1
count++
bump(total: ref count)
bump(total: ref count, by: 3)
var later: i64
let ok = count > 2
if ok {
    later = 1
} else {
    later = 2
}
var filled: i64
fill(out filled)
let id = Id { value: 1, label: "a" }
print($"{count} {later} {filled} {id.value} {id.label}")
