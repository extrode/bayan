void clear(Span<u8> data) {
    data[0] = 0;
}

u8 first(ReadOnlySpan<u8> data) => data[0];

let s = "abc";
let b = s.bytes;
b[0] = 65;
let tail = s.bytes[1..];
tail[0] = 66;
let buffer = StrBuf(s.bytes);
clear(s.bytes);
let bytes = stackalloc u8[4];
clear(bytes);
print($"{first(s.bytes)} {first(s)} {first(bytes)} {b[0]} {tail.length}");
