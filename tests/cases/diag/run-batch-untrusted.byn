void main() fails IoError {
    let path: Untrusted<string> = Untrusted("./build.cmd")
    let name: Untrusted<string> = Untrusted("x")
    let many: List<Untrusted<string>> = List<Untrusted<string>>()
    let span: ReadOnlySpan<Untrusted<string>> = many.span
    let none: List<string> = List<string>()
    let _ = try Io.runBatch(path, none.span)
    let _ = try Io.runBatch("./build.cmd", ["a", name])
    let _ = try Io.runBatch("./build.cmd", many)
    let _ = try Io.runBatch("./build.cmd", span)
    let _ = try Io.runBatch("./build.cmd", [name.trustUnchecked() because "checked against the allow list"])
}
