interface IThing {
    i64 get()
}

struct S : IThing {
    i64 n

    i64 get() => n
}

void show(dyn ref IThing d, ref List<S> xs) {
    for i in 0..100 {
        xs.append(S { n: i })
    }
    print($"{d.get()}")
}

void main() {
    var xs = List<S>()
    xs.append(S { n: 1 })
    show(xs[0], ref xs)
}
