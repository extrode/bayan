enum Color { red, green }

struct Point {
    i64 x;
    i64 y = 0;
}

struct Origin {
    i64 x = 0;
    i64 y = 0;
}

void use() {
    var colors = Map<string, Color>();
    colors.slot("sky") = .red;
    var points = Map<i64, Point>();
    points.slot(1).y += 1;
    var lists = Map<i64, List<i64>>();
    lists.slot(1).append(2);
    var origins = Map<i64, Origin>();
    origins.slot(1).x += 1;
    var names = Map<i64, string?>();
    names.slot(1) = "one";
}
