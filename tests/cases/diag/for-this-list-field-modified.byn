struct S {
    i64 n;
}

struct B {
    List<S> items;

    // A loop over a field's list holds a loan on it, like a loop over a local list.
    void run(ref this) {
        for x in items {
            items.append(S { n: x.n });
        }
    }
}

void main() {
    var b = B { items: List<S>() };
    b.items.append(S { n: 1 });
    b.run();
}
