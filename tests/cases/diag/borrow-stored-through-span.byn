void fill(Span<string> dst) {
    let buf = stackalloc u8[16]
    var sb = StrBuf(buf)
    sb.append("hello")
    dst[0] = sb.finish()
}
var arr: string[1] = ["x"]
fill(arr.mutableSpan())
print(arr[0])

void either(Span<string> dst, bool useCaller) {
    let buf = stackalloc u8[16]
    var sb = StrBuf(buf)
    sb.append("hi")
    var mine: string[1] = ["y"]
    var view = mine.mutableSpan()
    if useCaller {
        view = dst
    }
    view[0] = sb.finish()
}
