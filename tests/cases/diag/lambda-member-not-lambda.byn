struct User {
    string name
}

List<string> names(List<User> users, by (User -> string) key) {
    var out: List<string> = []
    for u in users {
        out.add(key(u))
    }
    return out
}

void main() {
    let users: List<User> = [User { name: "a" }]
    let all = names(users, by: .name)
}
