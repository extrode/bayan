void main() fails IoError {
    var text = "";
    var bytes = List<u8>();
    {
        using let arena = Arena();
        context (allocator: arena) {
            let inside = try Io.readText("notes.txt");
            print(inside);
            text = try Io.readText("notes.txt");
            bytes = try Io.readFile("data.bin");
        }
    }
    print(text);
    print($"{bytes.length}");
}
