interface IHas {
    List<i64> items { get; }
}

struct H : IHas {
    List<i64> items;
}

void grow<T>(ref T h) where T : IHas {
    var mine = h.items;
    for i in 0..100 {
        mine.append(i);
    }
}

void main() {
    var l = List<i64>();
    l.append(5);
    var h = H { items: move l };
    grow(ref h);
    print($"{h.items[0]} {h.items.length}");
}
