// Revision 0011: a `catch switch` over several `ValidationError` instantiations is exhaustive by type (BYN2410).
struct Signup {
    string name
        requires it.runeCount >= 3
}

struct Address {
    string city
        requires it != ""
}

union error FormError = ValidationError<Signup>, ValidationError<Address>

void register(string name) fails FormError {
    let s = try Signup { name: name }
}

register("amira") catch switch {
    ValidationError<Signup> e => print("rejected"),
}
