// A generic that replaces a `ref T` whole changes the state of a `T` with states (revision 0010 rule C).
struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
    }
}

void put<T>(move T v, to ref T x) {
    x = move v
}

void main() {
    var o: Order = Order.paid { id: 1, payment: 5 }
    put(Order.draft { id: 2 }, to: ref o)
    print($"{o.id}")
}
