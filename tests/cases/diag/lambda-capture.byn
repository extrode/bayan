union Shape {
    case circle(i64 r)
    case square(i64 side)
}

i64 apply((i64 -> i64) f) => f(1)

i64 bump(ref i64 total) => apply(x => x + total)

struct Counter {
    i64 count

    i64 scaled(i64 by) {
        let a = apply(x => x * this.count)
        let b = apply(x => x * count)
        return a + b + apply(x => x * by)
    }
}

void main() {
    var step = 2
    let s = Shape.circle(3)
    let fixed = 5
    let a = apply(x => x + step)
    let b = apply(x => x + fixed)
    switch s {
        case .circle(var r) => print(apply(x => x + r))
        case .square(let side) => print(apply(x => x + side))
    }
}
