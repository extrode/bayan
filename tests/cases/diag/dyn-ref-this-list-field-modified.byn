interface IThing {
    i64 get();
}

struct S : IThing {
    i64 n;

    i64 get() => n;
}

struct B {
    List<S> items;

    // A `dyn ref` into a field's list borrows `this`: growing or shrinking the list while it is live is an error.
    void run(ref this) {
        dyn ref IThing d = items[0];
        for i in 0..100 {
            items.append(S { n: i });
        }
        print($"{d.get()}");
        dyn ref IThing e = items[0];
        items.removeLast();
        items.clear();
        print($"{e.get()}");
    }
}

void main() {
    var b = B { items: List<S>() };
    b.items.append(S { n: 1 });
    b.run();
}
