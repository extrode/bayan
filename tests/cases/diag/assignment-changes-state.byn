struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
        shipped(i64 payment, i64 tracking)
    }
    i64 clear(ref this is .paid) {
        fresh(out this)
        return payment
    }
}

void wipe(ref Order o) {
    o = Order.draft { id: o.id }
}

void restart(ref Order o is .paid or .shipped) {
    o = Order.paid { id: o.id, payment: 0 }
}

void refund(ref Order.paid o) {
    o = Order.paid { id: o.id, payment: 0 }
}

void unpay(ref Order.paid o) {
    o = Order.draft { id: o.id }
}

void renumber(ref Order o) {
    var copy = o
    copy = Order.draft { id: 1 }
}

void fresh(out Order o) {
    o = Order.draft { id: 0 }
}

void freshPaid(out Order.paid o) {
    o = Order.paid { id: 0, payment: 0 }
}

void wipeOut(ref Order o) {
    fresh(out o)
}

void refundOut(ref Order.paid o) {
    freshPaid(out o)
}
