error BYN2021: `string` has no parameter `as: .hex`

  5 │     print($"{s, as: .hex}")
    │                 ^^^

error BYN2203: 99 does not fit in a format spec's `digits` (0 to 15)

  6 │     print($"{1.5, digits: 99}")
    │                           ^^

error BYN2021: `i32` has no parameter `digits`

  7 │     print($"{7, digits: 2}")
    │                 ^^^^^^^

error BYN2219: a format spec's `width` must be a compile-time constant

  8 │     print($"{s, width: w}")
    │                        ^

error BYN2720: `middle` is not a member of `align`

  9 │     print($"{s, align: .middle}")
    │                        ^^^^^^^

error BYN2021: `string` has no parameter `color`

  10 │     print($"{s, color: .red}")
     │                 ^^^^^^

error BYN2303: `width` is passed twice

  11 │     print($"{s, width: 2, width: 3}")
     │                           ^^^^^^
