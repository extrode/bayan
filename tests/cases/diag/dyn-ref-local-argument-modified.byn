// Passing a writable `dyn ref` local on to a writable `dyn ref` parameter modifies what it borrows (BYN3004).
interface IReset { void reset(ref this) uses alloc }
struct B : IReset {
    List<i64> items
    void reset(ref this) {
        items.clear()
        items.append(7)
    }
}
void poke(dyn ref IReset r) { r.reset() }
void main() {
    var b = B { items: List<i64>() }
    b.items.append(1)
    let s = b.items.asSpan()
    let r: dyn ref IReset = b
    poke(r)
    print($"{s[0]}")
}
