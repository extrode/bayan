union error LexError {
    bad
}

union error ReadError {
    lost
}

bool isBig(i64 x) => x > 2

bool isChecked(i64 x) fails LexError {
    fail .bad if x < 0
    return true
}

bool isInferred(i64 x) fails {
    fail LexError.bad if x < 0
    return true
}

void bump(ref i64 x) {
    x += 1
}

bool keep((i64 -> bool) p) => true

bool keepVoid((i64 -> void) p) => true

bool keepChecked((i64 -> bool fails LexError) p) => true

bool keepRead((i64 -> bool fails ReadError) p) => true

void main() {
    let a = keep(isChecked)
    let b = keepChecked(isBig)
    let c = keepRead(isChecked)
    let d: i64 -> i64 = isBig
    let e = keepChecked(isInferred)
    let f = keepVoid(bump)
}
