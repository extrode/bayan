error enum ConfigError {
    [ExitCode(0)]
    /// Zero means success.
    zero,
    [ExitCode(300)]
    /// Too large.
    large,
    [ExitCode]
    /// No argument.
    missing,
    [ExitCode("x")]
    /// Not an integer.
    text,
    [ExitCode(1, 2)]
    /// Two arguments.
    two,
    [ExitCode(4)]
    [ExitCode(5)]
    /// Repeated.
    repeated,
}

void main() fails ConfigError {
    return .zero;
}
