union Shape { Circle(f32 r), Rect(f32 w, f32 h), None }

f32 area(Shape s) => s switch {
    .Circle(let r) => r * r,
};

void describe(Shape s) {
    switch (s) {
        case .Rect(let w, let h):
            print($"{w} {h}");
        case .Circle(1):
            print("unit circle");
    }
}

void covered(Shape s) {
    switch (s) {
        case .Circle(_):
            print("circle");
        default:
            print("other");
    }
}
