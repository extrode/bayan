// An optional or collection holding `Untrusted<T>` is not formattable: the label names the part (BYN2225).
// A struct without `formatInto` is not formattable whatever its fields hold, so `Box` gets no label.
struct Box {
    Untrusted<string> s
}

void main() {
    let b = Box { s: Untrusted("x") }
    print($"{b}")
    let o: Untrusted<string>? = null
    print($"{o}")
    let m = Map<string, Untrusted<string>>()
    print($"{m}")
    let xs = List<Untrusted<string>>()
    print($"{xs}")
}
