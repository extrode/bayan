// A struct, optional or collection holding `Untrusted<T>` is not formattable: the label names the part (BYN2225).
struct Box {
    Untrusted<string> s;
}

void main() {
    let b = Box { s = Untrusted("x") };
    print($"{b}");
    Untrusted<string>? o = null;
    print($"{o}");
    let m = Map<string, Untrusted<string>>();
    print($"{m}");
    let xs = List<Untrusted<string>>();
    print($"{xs}");
}
