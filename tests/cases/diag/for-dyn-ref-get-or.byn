// `getOr` returns a place in the map or the fallback: a writable `for dyn ref` over it is checked writable (BYN2106).
interface IC {
    void bump(ref this)
    i64 n
}
struct C : IC {
    i64 n
    void bump(ref this) { n += 1 }
}
void main() {
    var m = Map<string, List<C>>()
    var l = List<C>()
    l.append(C { n: 1 })
    m["a"] = move l
    let k = move m
    let e = List<C>()
    for x: dyn ref IC in k.tryGet(at: "a") ?? e { x.bump() }
    print($"{k["a"][0].n}")
}
