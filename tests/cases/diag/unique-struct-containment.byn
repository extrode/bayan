// A struct with a unique field is unique itself, so copying it is BYN2780.
struct Ledger {
    List<i64> xs;
}

struct Point {
    i64 x;
    i64 y;
}

void main() {
    var ledger = Ledger { xs = List<i64>() };
    var copy = ledger;
    var p = Point { x = 1, y = 2 };
    var q = p;
    print($"{copy.xs.length} {q.x}");
}
