struct Token {
    i64 kind;
}

struct Lexer {
    List<Token> toks;

    Span<Token> tokens() => toks.asSpan();

    void push(ref this, Token t) {
        toks.append(t);
    }

    (Span<Token>, i64) spanAndCount() => (toks.asSpan(), toks.length);

    Span<Token> scratch() {
        var local = List<Token>();
        local.append(Token { kind: 0 });
        return local.asSpan();
    }
}

void main() {
    var lexer = Lexer { toks: List<Token>() };
    let all = lexer.tokens();
    lexer.toks.append(Token { kind: 1 });
    lexer.push(Token { kind: 2 });
    print($"{all.length}");
    for t in lexer.toks {
        lexer.push(t);
    }
    Span<Token> kept = lexer.tokens();
    {
        let inner = Lexer { toks: List<Token>() };
        kept = inner.tokens();
    }
    print($"{kept.length}");
}

struct Writer {
    StrBuf text;

    string view() => text.finish();
}
