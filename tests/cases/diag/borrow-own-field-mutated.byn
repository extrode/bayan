struct Token {
    i64 kind;
}

struct Lexer {
    List<Token> toks;

    Span<Token> tokens() => toks.asSpan();

    void push(ref this, Token t) {
        toks.add(t);
    }

    (Span<Token>, i64) counted() => (toks.asSpan(), toks.length);

    Span<Token> scratch() {
        var local = List<Token>();
        local.add(Token { kind = 0 });
        return local.asSpan();
    }
}

void main() {
    var lexer = Lexer { toks = List<Token>() };
    let all = lexer.tokens();
    lexer.toks.add(Token { kind = 1 });
    lexer.push(Token { kind = 2 });
    print($"{all.length}");
    for (let t in lexer.toks) {
        lexer.push(t);
    }
    Span<Token> kept = lexer.tokens();
    {
        let inner = Lexer { toks = List<Token>() };
        kept = inner.tokens();
    }
    print($"{kept.length}");
}

struct Writer {
    StrBuf text;

    string view() => text.asString();
}
