Span<i64> tail(Span<i64> values) => values[1..];

List<i64> keep(Span<i64> values, Arena arena) => values.copy(to: arena);

string pick(string a, string b) => a.length > b.length ? a : b;

i64 total(Span<i64> values) {
    i64 sum = 0;
    for (let v in values) {
        sum += v;
    }
    return sum;
}

void main() {
    using var arena = Arena();
    var names = List<string>();
    names.add("ann");
    names.add("bob");
    let first = names[0];
    names.add("cy");
    print(first);
    var xs = List<i64>();
    xs.add(1);
    xs.add(2);
    print($"{total(xs)}");
    let view = xs.asSpan();
    print($"{view[0]}");
    xs.add(3);
    let longer = pick(a: names[0], b: names[1]);
    print(longer);
    context (allocator: arena) {
        var local = List<i64>();
        local.add(5);
        let copy = tail(local.asSpan()).copy(to: arena);
        print($"{copy.length}");
    }
    var kept = "";
    {
        kept = "static";
    }
    print(kept);
    i64[3] fixed = [1, 2, 3];
    let part = fixed.asSpan()[1..];
    print($"{part[0]}");
    fixed[0] = 9;
    let kept2 = keep(fixed.asSpan(), arena: arena);
    print($"{kept2.length}");
    arena.reset();
}

void fillLocal() {
    let buf = stackalloc u8[16];
    var sb = StrBuf(buf);
    sb.append("hi");
    string[1] names = ["x"];
    let view = names.asSpan();
    view[0] = sb.asString();
    print(names[0]);
}
