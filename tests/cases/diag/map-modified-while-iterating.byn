void modify() {
    var m = Map<string, i64>()
    m["a"] = 1
    for e in m {
        m[e.key] = e.value + 1
        let _ = m.remove(e.key)
    }
    for e in m { m.clear() }
}

void escape() {
    var outer = Map<i64, string>()
    {
        using var a = Arena()
        provide allocator: a {
            var inner = Map<i64, i64>()
            inner[1] = 2
            outer = Map<i64, string>()
        }
    }
}
