void main() {
    var text = "";
    var outer = StrBuf();
    {
        using let arena = Arena();
        context (allocator: arena) {
            var sb = StrBuf();
            sb.append("abc");
            print(sb.asString());
            text = sb.asString();
            outer = StrBuf();
        }
    }
    outer.append("ok");
    text = outer.asString();
    print(text);
}
