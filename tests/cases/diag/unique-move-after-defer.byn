// A local a `defer` uses runs at scope exit: moving it later in the scope is a use after move (BYN2781).
void consume(move List<i64> xs) {
    print($"{xs.count}");
}

void main() {
    let xs = List<i64>();
    defer print($"{xs.count}");
    consume(move xs);

    let ys = List<i64>();
    defer print($"{ys.count}");
    defer consume(move ys);
}

void movedFirst() {
    let zs = List<i64>();
    consume(move zs);
    defer print($"{zs.count}");
}
