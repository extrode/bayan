// A field stands for a getter, abstract or default.
interface ICount {
    i64 count { get; }
}

interface ISized {
    i64 size => 5;
    string show() => $"{size}";
}

struct Box : ICount, ISized {
    i64 count;
    i64 size;
}

struct Empty : ISized {
    i64 x;
}

let b = Box { count: 3, size: 4 };
print($"{b.count}");
print(b.show());
print(Empty { x: 1 }.show());
