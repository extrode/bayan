// A fresh `dyn ref` argument to a value holding no borrowable storage changes nothing a live span points into.
interface IC { void bump(ref this); }
struct C : IC { i64 n; void bump(ref this) { n += 1; } }
struct B { List<i64> items; C c; }
void poke(dyn ref IC r) { r.bump(); }
void main() {
    var b = B { items: List<i64>(), c: C { n: 0 } };
    b.items.append(1);
    let t = b.items.asSpan();
    poke(b.c);
    print($"{t[0]} {b.c.n}");
}
