// `write` adds no newline; stdout writes stay in order with `print`.
void main() {
    Io.stdout.write("one ")
    Io.stdout.write("two")
    print(" three")
    Io.stderr.write("to stderr, ")
    Io.stderr.write("no newline")
    Io.stdout.write("last, no newline")
    let start: i64 = Io.monotonicNanos()
    let end: i64 = Io.monotonicNanos()
    print("") if end < start
}
