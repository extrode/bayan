void show(string name, to ReadOnlySpan<i32> xs) {
    var sb = StrBuf()
    for x in xs { sb.append($" {x}") }
    print($"{name}:{sb.finish()} ({xs.length})")
}

// Map literals: insert, look up, count.
var stock: Map<string, i32> = ["A-1": 12, "B-2": 3]
stock["C-3"] = 7
stock["A-1"] += 1
print($"{stock} count={stock.length} A-1={stock["A-1"]} has B-2: {stock.contains("B-2")}")
var empty: Map<string, i64> = []
print($"empty: {empty} count={empty.length}")
empty["x"] = 1
print($"{empty}")

// No target type: a map of the first entry's types, a fixed array of the first element's type.
let headers = ["Accept": "*/*", "Host": "example.com"]
print($"{headers} {headers["Host"]}")
let fixed = [1, 2, 3]
show("fixed", to: fixed.asSpan())

// Spreads into a list, a fixed array and a span.
let xs: List<i32> = [1, 2]
let more: i32[2] = [5, 6]
let all: List<i32> = [..xs, ..more, 4]
show("list", to: all)
let arr: i32[5] = [..more, 0, ..more]
show("array", to: arr.asSpan())
let view: Span<i32> = [..more, 9]
show("span", to: view)
let grown = [..arr, 7]
show("inferred", to: grown.asSpan())

// A span literal lives on the stack.
var s: Span<i32> = [1, 2, 3]
s[0] = 10
show("stack", to: s)
