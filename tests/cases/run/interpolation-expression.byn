struct Label {
    string text
    i64 n
}

string describe(Label label) {
    return $"{label.text} x{label.n}"
}

i64 width(string s) {
    return s.length
}

void main() {
    let n = 3
    let msg = $"total {n}"
    print(msg)
    print(describe(Label { text: "pen", n: n }))
    print($"{width($"ab{n}")} {width(msg)}")
    let label = Label { text: $"#{n}", n: n }
    print($"{label.text} {label.n}")
    var s = ""
    for i in 0..3 {
        s = $"{s}{i},"
    }
    print(s)
    using let arena = Arena()
    provide allocator: arena {
        let inner = $"in arena {n * 2}"
        print(inner)
    }
}
