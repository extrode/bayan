// An index into a temporary is the loop's own: a writable `for dyn ref` over it needs no writable place.
interface IC {
    void bump(ref this)
    i64 n
}
struct C : IC {
    i64 n
    void bump(ref this) { n += 1 }
}
List<List<C>> make() {
    var l = List<C>()
    l.append(C { n: 1 })
    var ll = List<List<C>>()
    ll.append(move l)
    return ll
}
void main() {
    for x: dyn ref IC in make()[0] {
        x.bump()
        print($"{x.n}")
    }
}
