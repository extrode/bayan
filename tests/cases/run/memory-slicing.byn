i64[5] xs = [10, 20, 30, 40, 50]
let s = xs.asSpan()
let mid = s[1..^1]
print($"{mid.length} {mid[0]} {mid[^1]} {s[^1]} {s[^5]}")
let head = s[..2]
let tail = s[3..]
print($"{head.length} {head[1]} {tail.length} {tail[0]}")
let incl = s[1..=3]
print($"{incl.length} {incl[2]}")
let all = s[..]
print($"{all.length}")
let empty = s[2..2]
print($"{empty.length} {empty.isEmpty}")

let text = "héllo wörld"
print(text[0..1])
print(text[0..3])
print(text[7..])
print(text[^3..])
print($"{text.length}")

i64 total = 0
for x in s[2..] {
    total += x
}
print($"{total}")
let bad = 4
print($"{s[bad..2].length}")
