// Valid UTF-8 bytes decode into a fresh string that outlives the bytes.
string decode() fails Utf8Error {
    var bytes = List<u8>();
    bytes.append(0x68);
    bytes.append(0x69);
    let s = try string.from(bytes.asSpan());
    bytes.clear();
    return s;
}

void main() fails Utf8Error {
    u8[2] hi = [0x68, 0x69];
    print(try string.from(hi.asSpan()));
    let empty = try string.from(hi.asSpan()[0..0]);
    print($"empty: {empty.bytes.count} bytes, {empty == ""}");
    u8[9] multi = [0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80];
    let m = try string.from(multi.asSpan());
    print($"{m} {m.bytes.count} bytes");
    print(try decode());
    let t = string.tryFrom(hi.asSpan()) ?? "none";
    print($"tryFrom: {t}");
    let at = string.invalidUtf8At(multi.asSpan());
    print($"invalidUtf8At: {at == null}");
}
