// `for dyn ref I x in xs` over a fixed array or a List points at each element, so mutations through `x` persist.
interface IC {
    void bump(ref this)
    i64 n { get }
}

struct C : IC {
    i64 n
    void bump(ref this) {
        n += 1
    }
}

void main() {
    var a: C[2] = [C { n: 0 }, C { n: 0 }]
    for dyn ref IC x in a {
        x.bump()
    }
    var l = List<C>()
    l.append(C { n: 0 })
    for dyn ref IC x in l {
        x.bump()
    }
    print($"{a[0].n} {a[1].n} {l[0].n}")
}
