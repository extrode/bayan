// `for x: dyn ref I in xs` over a fixed array or a List points at each element, so mutations through `x` persist.
interface IC {
    void bump(ref this)
    i64 n
}

struct C : IC {
    i64 n
    void bump(ref this) {
        n += 1
    }
}

void main() {
    var a: C[2] = [C { n: 0 }, C { n: 0 }]
    for x: dyn ref IC in a {
        x.bump()
    }
    var l = List<C>()
    l.append(C { n: 0 })
    for x: dyn ref IC in l {
        x.bump()
    }
    print($"{a[0].n} {a[1].n} {l[0].n}")
}
