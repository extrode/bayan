struct Money {
    i64 cents = 0;

    void formatInto(ref StrBuf sb) {
        sb.append($"Money {{ cents: {cents} }}");
    }
}

struct LineItem {
    string name;
    Money unitPrice;
    i64 qty = 1;

    void formatInto(ref StrBuf sb) {
        sb.append($"LineItem {{ name: {name}, unitPrice: {unitPrice}, qty: {qty} }}");
    }
}

let item = LineItem { name: "tea", unitPrice: { cents: 250 }, qty: 2 };
print($"{item.name} {item.unitPrice.cents} {item.qty}");
let more = item with { name: "coffee", unitPrice: Money { cents: 300 } };
print($"{more.name} {more.unitPrice.cents} {more.qty}");
let zero = Money {};
print($"{zero.cents} {item.unitPrice == Money { cents: 250 }}");
print($"{more}");
