i32 discount(i32 total, by i32 percent)
    requires percent in 0..=100
    requires total >= 0
    => total - total * percent / 100

i32 firstDigit(i32 value) requires value in 0..10 {
    return value
}

let quarter = 25
print($"{discount(200, by: quarter)}")
print($"{firstDigit(9)}")
let scale = 7
print($"{discount(200, by: scale * 20)}")
