union error ReadError { broken }

/// Yields 1..limit; fails on the step after `failAt` when `failAt` is set.
struct Rows {
    i64 at
    i64 limit
    i64 failAt

    i64? next(ref this) fails ReadError {
        if failAt > 0 && at == failAt { return .broken }
        if at >= limit { return null }
        at += 1
        return at
    }
}

i64 total(i64 limit, i64 failAt) fails ReadError {
    var sum = 0
    for try row in (Rows { at: 0, limit: limit, failAt: failAt }) {
        print($"row {row}")
        continue if row == 2
        sum += row
    }
    return sum
}

print($"total {try total(limit: 4, failAt: 0)}")
let failed = total(limit: 4, failAt: 3) catch -1
print($"failed {failed}")
