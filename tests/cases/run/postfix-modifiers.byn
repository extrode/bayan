struct Counter {
    i64 calls = 0;

    i64 touch() {
        calls += 1;
        return calls;
    }
}

void check(i64 n) {
    return if n < 0;
    print($"checked {n}");
}

var counter = Counter();
print($"not run {counter.touch()}") if false;
print($"calls {counter.calls}");
print($"run {counter.touch()}") if true;
print($"calls {counter.calls}");
check(-1);
check(2);
for (let i in 0..10) {
    break if i == 3;
    print($"i {i}");
}
