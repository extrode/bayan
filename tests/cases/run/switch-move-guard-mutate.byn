// mode: debug
// A guard that grows its arm's binding (a mutating method call) does not make the binding an owner: when the guard
// fails, a later arm binding the same storage owns it, with no second-owner panic from the debug-build checker.
struct Bag {
    List<i64> items;

    public i64 grow() {
        this.items.add(1);
        return this.items.length;
    }
}

union Slot {
    Full(Bag b),
    Empty,
}

void main() {
    var a = List<i64>();
    a.add(1);
    a.add(2);
    a.add(3);
    let s = Slot.Full(Bag { items = move a });
    switch (move s) {
        case .Full(var x) when x.grow() > 5:
            print("big");
        case .Full(let y):
            print($"small {y.items.length}");
        default:
            print("empty");
    }
}
