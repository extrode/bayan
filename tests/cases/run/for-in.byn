let xs: List<i64> = [3, 1, 4]
for x in xs {
    print($"x {x}")
}
for i in 0..3 {
    print($"i {i}")
}
var prices = Map<string, i64>()
prices["tea"] = 3
prices["cake"] = 5
prices["jam"] = 2
let _ = prices.remove("cake")
for (item, price) in prices {
    print($"{item} costs {price}")
}
let grid: List<List<i64>> = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
outer: for row in grid {
    for cell in row {
        continue outer if cell == 2
        break outer if cell == 5
        print($"cell {cell}")
    }
}
print("done")
