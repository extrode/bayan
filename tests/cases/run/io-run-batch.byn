// os: unix
// `Io.runBatch` needs cmd.exe: elsewhere it is `unsupported`, before looking at the arguments.
string describe(string path) {
    let none: List<string> = List<string>()
    let r = Io.runBatch(path, none.span) catch switch {
        .unsupported => return "unsupported",
        .invalidInput => return "invalid input",
        _ => return "some other error",
    }
    return $"exit {r.exitCode}"
}

void main() {
    print(describe("echo.cmd"))
    print(describe("echo.exe"))
}
