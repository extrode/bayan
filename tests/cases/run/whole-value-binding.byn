// `.case name` binds the whole value narrowed to that case; its payload reads as `name.field`.
union Discount {
    percentOff(i64 rate)
    fixed(i64 cents, string label)
    none
}

i64 price(Discount d, i64 base) => d switch {
    .percentOff p => base - base * p.rate / 100,
    .fixed f when f.cents > base => 0,
    .fixed f => base - f.cents,
    .none n => base,
}

void show(Discount? d) {
    switch d {
        case .fixed f:
            print($"fixed {f.label} {f.cents} of {f}")
        case _:
            print("other")
    }
}

print($"{price(.percentOff(10), 200)} {price(.fixed(50, "x"), 200)} {price(.fixed(500, "y"), 200)} {price(.none, 200)}")
show(.fixed(5, "five"))
show(null)
