struct Point {
    i64 x;
    i64 y;

    void formatInto(ref StrBuf sb) {
        sb.append($"Point {{ x: {x}, y: {y} }}");
    }
}

T pick<T>(bool first, move T a, move T b) => first ? move a : move b;

string first<T>(ReadOnlySpan<T> xs) {
    if (xs.count == 0) return "null";
    return $"{xs[0]}";
}

bool same<T>(T a, T b) => a == b;

T twice<T>(move T x, move T y) => pick(first: false, a: move x, b: move y);

i64 countDown<T>(T x, i64 n) {
    if (n == 0) return 0;
    return 1 + countDown(x, n - 1);
}

i64 one = 1;
print($"{pick(first: true, a: one, b: 2)}");
print(pick(first: false, a: "left", b: "right"));
let p = pick(first: true, a: Point { x = 1, y = 2 }, b: Point { x = 3, y = 4 });
print($"{p}");
print($"{pick<i64>(first: false, a: 5, b: 6)}");

var xs = List<i64>();
xs.append(7);
xs.append(8);
print($"{first(xs)}");
let none = List<string>();
print($"{first(none)}");

print($"{same(a: 1, b: 1)} {same(a: "a", b: "b")} {same(a: p, b: Point { x = 1, y = 2 })}");
print(twice(x: "echo", y: "echo"));
print($"{countDown("x", 3)}");
