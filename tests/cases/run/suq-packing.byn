// suq-packing.byn — Sūq-0 slice 3: zero-allocation box packing, pick order, check digits
// All working storage is caller-owned (`stackalloc`); the packing loop allocates nothing.

public struct PackItem {
    public string sku
    public i64 grams
    public u8 aisle
    public u16 bay

    bool comesAfter(PackItem other) => aisle > other.aisle || (aisle == other.aisle && bay > other.bay)
}

public struct BoxSize {
    public string name
    public i64 capacity
    public i64 tare
}

BoxSize boxSizes(i64 i) => i switch {
    0 => BoxSize { name: "S", capacity: 2000, tare: 150 },
    1 => BoxSize { name: "M", capacity: 5000, tare: 300 },
    _ => BoxSize { name: "L", capacity: 12000, tare: 600 },
}

public union error PackError {
    /// an item is heavier than the largest box can hold
    tooHeavy
}

/// Index of the smallest box an item fits in on its own, or -1.
i32 findSmallestBox(i64 grams) {
    for i in 0..3 {
        return i if boxSizes(i).capacity - boxSizes(i).tare >= grams
    }
    return -1
}

public struct PackedBox {
    public i32 kind
    public i64 load
}

/// First-fit decreasing. Fills `boxes` (kind and load, which includes tare) and returns the number
/// of boxes. `order` is scratch. Ties keep input order.
public i32 pack(ReadOnlySpan<PackItem> items, by Span<i32> order, to Span<PackedBox> boxes) fails PackError {
    let n = items.length
    for i in 0..n {
        order[i] = (i32)i
    }
    // insertion sort, heaviest first; strict `<` keeps it stable
    for i in 1..n {
        let current = order[i]
        var j = i
        while j > 0 && items[order[j - 1]].grams < items[current].grams {
            order[j] = order[j - 1]
            j = j - 1
        }
        order[j] = current
    }

    var count = 0
    for k in 0..n {
        let i = order[k]
        let grams = items[i].grams
        let size = findSmallestBox(grams)
        return .tooHeavy if size < 0
        var box = -1
        for b in 0..count {
            if box < 0 && boxes[b].load + grams <= boxSizes(boxes[b].kind).capacity {
                box = b
            }
        }
        if box < 0 {
            box = count
            boxes[box] = PackedBox { kind: size, load: boxSizes(size).tare }
            count = count + 1
        }
        boxes[box].load = boxes[box].load + grams
    }
    return count
}

/// Pick order: by aisle, then bay; stable.
public void sortPicks(ReadOnlySpan<PackItem> items, to Span<i32> order) {
    for i in 0..items.length {
        order[i] = (i32)i
    }
    for i in 1..items.length {
        let current = order[i]
        var j = i
        while j > 0 && items[order[j - 1]].comesAfter(items[current]) {
            order[j] = order[j - 1]
            j = j - 1
        }
        order[j] = current
    }
}

/// FNV-1a reduced to one digit. Wrapping multiply is the algorithm, so `*%`.
public u8 computeCheckDigit(string text) {
    var h: u32 = 2166136261
    for c in text {
        h = (h ^ (u32)c) *% 16777619
    }
    return (u8)(h % 10)
}

void report(ReadOnlySpan<PackItem> items, as string name) {
    let order: Span<i32> = stackalloc i32[64]
    let boxes: Span<PackedBox> = stackalloc PackedBox[64]
    let count = pack(items, by: order, to: boxes) catch {
        print($"{name}: tooHeavy")
        return
    }
    print($"{name}: {count} boxes")
    for b in 0..count {
        print($"  box {b}: {boxSizes(boxes[b].kind).name} {boxes[b].load} g")
    }
}

let mixed: List<PackItem> = [
    PackItem { sku: "RUG-0001", grams: 4000, aisle: 3, bay: 1 },
    PackItem { sku: "TEA-0001", grams: 300, aisle: 1, bay: 4 },
    PackItem { sku: "MUG-0001", grams: 500, aisle: 1, bay: 2 },
]
let bed: List<PackItem> = [PackItem { sku: "BED-0001", grams: 15000, aisle: 9, bay: 1 }]

var sample: List<PackItem> = []
for i in 0..40 {
    sample.append(PackItem { sku: $"ITM-{1000 + i}", grams: 100 + (i * 37) % 900, aisle: (u8)(1 + i % 6), bay: (u16)(i % 20) })
}

report(mixed.asSpan(), as: "mixed")
report(bed.asSpan(), as: "bed")
report(sample.asSpan(), as: "sample")

let picks: Span<i32> = stackalloc i32[64]
sortPicks(sample.asSpan(), to: picks)
var first = StrBuf()
for k in 0..6 {
    first.append(" ")
    first.append(sample[picks[k]].sku)
}
print($"first picks:{first.finish()}")

print($"check digit EX123456789MY: {computeCheckDigit("EX123456789MY")}")
print($"check digit SUQ-42: {computeCheckDigit("SUQ-42")}")
var seq: u16 = 65534
seq = seq +% 1
seq = seq +% 1
print($"label seq wraps to {seq}")
let room: u32 = 100
print($"saturating u32 100 -| 250 = {room -| 250}")
let signedRoom: i64 = 100
print($"saturating i64 100 -| 250 = {signedRoom -| 250}")
