struct Order {
    i64 id
    states {
        draft
        paid(i64 payment)
        shipped(i64 payment, i64 tracking)
    }
    void pay(ref this is .draft, i64 amount) becomes .paid {
        become .paid(amount)
    }
    void ship(ref this is .paid, i64 tracking) becomes .shipped {
        become .shipped(payment, tracking)
    }
    i64 amount(this is .paid or .shipped) => payment
}

string describe(Order o) => o switch {
    .draft => "draft",
    .paid p => $"paid {p.payment}",
    .shipped(let payment, let tracking) => $"shipped {payment} as {tracking}",
}

i64 plainId(Order o) => o.id

var o = Order.draft { id: 7 }
print(describe(o))
o.pay(250)
print($"{o.payment} {o.amount()}")
print(describe(o))
o.ship(42)
print($"{o.amount()} {o.tracking}")
print(describe(o))
print($"{plainId(o)}")
let back = Order.paid { id: 8, payment: 5 }
if back is .paid {
    print($"{back.payment}")
}
let maybe: Order? = back
print($"{maybe is { }}")
