struct Tally {
    i64 hits = 0;
    string note = "new";

    void formatInto(ref StrBuf sb) {
        sb.append($"Tally {{ hits: {hits}, note: {note} }}");
    }
}

// `slot` inserts the default for a missing key, so counting needs no lookup first.
var words = Map<string, i64>();
string[7] text = ["the", "cat", "saw", "the", "dog", "the", "cat"];
for (let w in text) words.slot(w) += 1;
print($"{words} length={words.count}");

// `getOr` reads without inserting.
print($"cat {words.getOr("cat", 0)}, cow {words.getOr("cow", -1)}, length={words.count}");
print($"contains cow: {words.contains("cow")}, contains dog: {words.contains("dog")}");

// Writes and compound writes through `map[k]` (on a present key; `slot` inserts): an update keeps the key's position.
words["saw"] = 10;
words["the"] += 5;
words.slot("owl") += 2;
print($"{words}");

// A removed key goes to the end when inserted again.
print($"remove cat: {words.remove("cat")}, again: {words.remove("cat")}");
words.slot("cat") += 1;
for (let e in words) print($"  {e.key} = {e.value}");

// `ref map.slot(k)` and struct defaults from field initializers.
void bump(ref i64 n) {
    n += 100;
}
bump(ref words.slot("dog"));
bump(ref words.slot("eel"));
print($"dog {words["dog"]}, eel {words["eel"]}, length={words.count}");
var tallies = Map<char, Tally>();
for (let c in "abca") tallies.slot(c).hits += 1;
tallies.slot('z').note = "set";
print($"{tallies}");

words.clear();
print($"cleared: {words} length={words.count}");
