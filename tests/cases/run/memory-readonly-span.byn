i64 count(ReadOnlySpan<u8> data, u8 target) {
    i64 n = 0;
    for (let b in data) {
        n += b == target ? 1 : 0;
    }
    return n;
}

i64 sum(ReadOnlySpan<i64> values) {
    i64 total = 0;
    for (let v in values) {
        total += v;
    }
    return total;
}

let text = "banana";
let bytes = text.bytes;
ReadOnlySpan<u8> middle = bytes[1..^1];
var numbers = List<i64>();
numbers.append(4);
numbers.append(5);
i64[3] fixed = [1, 2, 3];
Span<i64> view = fixed.asSpan();
print($"{count(text, target: 'a')} {count(bytes, target: 'n')} {count(middle, target: 'a')} {middle.length}");
print($"{sum(numbers)} {sum(fixed)} {sum(view)} {sum(view[1..])}");
