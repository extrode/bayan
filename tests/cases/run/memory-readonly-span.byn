i64 count(ReadOnlySpan<u8> data, for u8 target) {
    var n: i64 = 0
    for b in data {
        n += b == target ? 1 : 0
    }
    return n
}

i64 sum(ReadOnlySpan<i64> values) {
    var total: i64 = 0
    for v in values {
        total += v
    }
    return total
}

let text = "banana"
let bytes = text.bytes
let middle: ReadOnlySpan<u8> = bytes[1..^1]
var numbers = List<i64>()
numbers.append(4)
numbers.append(5)
let fixed: i64[3] = [1, 2, 3]
let view: ReadOnlySpan<i64> = fixed.span
print($"{count(text, for: 'a')} {count(bytes, for: 'n')} {count(middle, for: 'a')} {middle.length}")
print($"{sum(numbers)} {sum(fixed)} {sum(view)} {sum(view[1..])}")
