// Moving unique values between owners: locals, a struct field, a list and a `move` parameter.
struct Bag {
    string name
    List<i64> items
}

i64 sum(move List<i64> xs) {
    var total: i64 = 0
    for x in xs { total += x }
    return total
}

void main() {
    var a = List<i64>()
    a.append(1)
    a.append(2)
    let b = move a
    print($"b {b.length}")

    var bag = Bag { name: "bag", items: move b }
    bag.items.append(3)
    print($"{bag.name} {bag.items.length}")

    var lists = List<List<i64>>()
    var c = List<i64>()
    c.append(4)
    lists.append(move c)
    print($"lists {lists.length} {lists[0].length}")

    var d = List<i64>()
    d.append(5)
    d.append(6)
    print($"sum {sum(move d)}")

    d = List<i64>()
    d.append(7)
    print($"d {d.length} {d[0]}")

    let n: i64 = 8
    let m = move n
    print($"{n} {m}")
}
