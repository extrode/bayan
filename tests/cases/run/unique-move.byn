// Moving unique values between owners: locals, a struct field, a list and a `move` parameter.
struct Bag {
    string name;
    List<i64> items;
}

i64 sum(move List<i64> xs) {
    i64 total = 0;
    for x in xs { total += x; }
    return total;
}

void main() {
    var a = List<i64>();
    a.append(1);
    a.append(2);
    let b = move a;
    print($"b {b.count}");

    var bag = Bag { name: "bag", items: move b };
    bag.items.append(3);
    print($"{bag.name} {bag.items.count}");

    var lists = List<List<i64>>();
    var c = List<i64>();
    c.append(4);
    lists.append(move c);
    print($"lists {lists.count} {lists[0].count}");

    var d = List<i64>();
    d.append(5);
    d.append(6);
    print($"sum {sum(move d)}");

    d = List<i64>();
    d.append(7);
    print($"d {d.count} {d[0]}");

    i64 n = 8;
    let m = move n;
    print($"{n} {m}");
}
