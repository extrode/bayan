void enumRow() {
    var source: Color = Color.red
    var held: () -> Color = () => Color.green
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"enum shadow {held()} {c}")
    }
    {
        let c: Color = Color.green
        print($"enum scope {held()} {c}")
    }
    source = Color.blue
    print($"enum reassigned {held()} {source}")
}

// A `let` of union copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void unionRow() {
    var source: Shape = Shape.circle(1)
    var held: () -> Shape = () => Shape.circle(2)
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"union shadow {held(), as: .debug} {c}")
    }
    {
        let c: Shape = Shape.circle(2)
        print($"union scope {held(), as: .debug} {c, as: .debug}")
    }
    source = Shape.square(3)
    print($"union reassigned {held(), as: .debug} {source, as: .debug}")
}

// A `let` of optional copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void optionalRow() {
    var source: i64? = 1
    var held: () -> i64? = () => 2
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"optional shadow {held()} {c}")
    }
    {
        let c: i64? = 2
        print($"optional scope {held()} {c}")
    }
    source = null
    print($"optional reassigned {held()} {source}")
}

// A `let` of tuple copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void tupleRow() {
    var source: (i64, string) = (1, "one")
    var held: () -> (i64, string) = () => (2, "two")
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"tuple shadow {held(), as: .debug} {c}")
    }
    {
        let c: (i64, string) = (2, "two")
        print($"tuple scope {held(), as: .debug} {c, as: .debug}")
    }
    source = (3, "three")
    print($"tuple reassigned {held(), as: .debug} {source, as: .debug}")
}

// A `let` of function copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void functionRow() {
    var source: i64 -> i64 = x => x + 1
    var held: () -> (i64 -> i64) = () => x => x + 2
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"function shadow {held()(10)} {c}")
    }
    {
        let c: i64 -> i64 = x => x + 2
        print($"function scope {held()(10)} {c(10)}")
    }
    source = x => x + 3
    print($"function reassigned {held()(10)} {source(10)}")
}

i64 call(() -> i64 f) => f()

// A plain parameter, read after a block ends and through a call.
void parameterRow(i64 p) {
    var held: () -> i64 = () => 0
    {
        held = () => p
    }
    print($"parameter scope {held()} {call(() => p)}")
}

void main() {
    i64Row()
    i32Row()
    u8Row()
    f64Row()
    boolRow()
    runeRow()
    stringRow()
    structRow()
    enumRow()
    unionRow()
    optionalRow()
    tupleRow()
    functionRow()
    var v: i64 = 7
    parameterRow(v)
    v = 8
    parameterRow(v)
}
