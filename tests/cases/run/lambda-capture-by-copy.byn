struct Point {
    i64 x
    i64 y
}

enum Color {
    red
    green
    blue
}

union Shape {
    circle(i64 r)
    square(i64 side)
}

// A `let` of i64 copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void i64Row() {
    var source: i64 = 1
    var held: () -> i64 = () => 2
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"i64 shadow {held()} {c}")
    }
    {
        let c: i64 = 2
        print($"i64 scope {held()} {c}")
    }
    source = 3
    print($"i64 reassigned {held()} {source}")
}

