// A `let` of rune copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void runeRow() {
    var source: rune = 'a'
    var held: () -> rune = () => 'b'
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"rune shadow {held()} {c}")
    }
    {
        let c: rune = 'b'
        print($"rune scope {held()} {c}")
    }
    source = 'c'
    print($"rune reassigned {held()} {source}")
}

// A `let` of string copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void stringRow() {
    var source: string = "one"
    var held: () -> string = () => "two"
    {
        let c = source
        held = () => c
        let c = 0
        print($"string shadow {held()} {c}")
    }
    {
        let c: string = "two"
        print($"string scope {held()} {c}")
    }
    source = "three"
    print($"string reassigned {held()} {source}")
}

// A `let` of struct copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void structRow() {
    var source: Point = Point { x: 1, y: 1 }
    var held: () -> Point = () => Point { x: 2, y: 2 }
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"struct shadow {held(), as: .debug} {c}")
    }
    {
        let c: Point = Point { x: 2, y: 2 }
        print($"struct scope {held(), as: .debug} {c, as: .debug}")
    }
    source = Point { x: 3, y: 3 }
    print($"struct reassigned {held(), as: .debug} {source, as: .debug}")
}

