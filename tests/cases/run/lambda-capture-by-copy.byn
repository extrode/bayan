// A `let` of bool copied from a `var`, read after a shadow, after its scope ends and after the `var` changes.
void boolRow() {
    var source: bool = true
    var held: () -> bool = () => false
    {
        let c = source
        held = () => c
        let c = "shadow"
        print($"bool shadow {held()} {c}")
    }
    {
        let c: bool = false
        print($"bool scope {held()} {c}")
    }
    source = false
    print($"bool reassigned {held()} {source}")
