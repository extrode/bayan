union Shape {
    circle(f32 r)
    rect(f32 w, f32 h)
    none
}

public union Token {
    number(i64 value)
    word(string text)
    end
}

struct Slot {
    string label
    Shape shape

    void formatInto(ref StrBuf sb) {
        sb.append($"Slot {{ label: {label}, shape: {shape} }}")
    }
}

f32 area(Shape s) => s switch {
    .circle(let r) => 3 * r * r,
    .rect(let w, let h) => w * h,
    .none => 0,
}

void describe(Shape s) {
    switch s {
        case Shape.circle(let r) when r > 10:
            print("big circle")
        case .circle(let r):
            print($"circle {r}")
        case .rect(let w, _):
            print($"rect of width {w}")
        case Shape.none:
            print("nothing")
    }
}

Shape square(f32 side) => .rect(side, side)

let c = Shape.circle(1)
let r = square(2)
let n: Shape = .none
print($"{c} {r} {n}")
print($"{Shape.rect(w: 2, h: 3)}")
print($"{area(c)} {area(r)} {area(n)}")
describe(c)
describe(Shape.circle(20))
describe(r)
describe(n)

print($"{c == Shape.circle(1)} {c == Shape.circle(2)} {c != r} {n == Shape.none} {r == .rect(2, 2)}")

if r is .rect(let rw, let rh) {
    print($"is rect {rw}x{rh}")
}
if c is .rect(_, _) {
    print("unreachable")
} else {
    print("c is not a rect")
}
print($"{n is .none} {c is Shape.circle(1)}")

var shapes = List<Shape>()
shapes.append(c)
shapes.append(.rect(1, 2))
shapes.append(Shape.none)
var total: f32 = 0
for s in shapes {
    total += area(s)
    print($"list {s}")
}
print($"total {total}")

let slot = Slot { label: "first", shape: .circle(3) }
print($"{slot}")
print($"{slot == Slot { label: "first", shape: Shape.circle(3) }}")

let maybe: Shape? = shapes[1]
let missing: Shape? = null
print($"{maybe} {missing}")
print(maybe switch { null => "none", .rect(let w, _) => $"rect {w}", _ => "other" })

var tokens = List<Token>()
tokens.append(Token.number(42))
tokens.append(.word("hi"))
tokens.append(.end)
for t in tokens {
    let text = t switch {
        .number(let v) => $"number {v}",
        .word(let w) => $"word {w}",
        .end => "end",
    }
    print($"{text} {t}")
}
