let below: f64 = 999999999999999.9
let boundary: f64 = 1e15
let smallest: f64 = 0.00001
let under: f64 = 0.0000099
let a: f64 = 0.1
let b: f64 = 0.2
let zero: f64 = 0.0
let negativeZero: f64 = -0.0
print($"{below} {boundary} {smallest} {under} {a + b} {negativeZero}")
print($"{zero / zero} {1.0 / zero} {-1.0 / zero}")
print($"{1.5e-7} {-2.25e20} {42.0} {1e300} {5e-324}")
let single: f32 = 0.00001
let singleUnder: f32 = 0.0000099
let singleLarge: f32 = 1e15
print($"{single} {singleUnder} {singleLarge} {(f32)0.1}")
