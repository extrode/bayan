// Uses of a `Map` that read it in place or move a fresh one: none is a copy (BYN2780).
struct Store {
    string name
    Map<string, i64> data

    void formatInto(ref StrBuf sb) {
        sb.append($"Store {{ name: {name}, data: {data} }}")
    }
}

union Slot {
    empty
    full(Map<string, i64> data)
}

Map<string, i64> fresh(i64 value, at string key) {
    var m = Map<string, i64>()
    m[key] = value
    return m
}

Map<string, i64> passThrough(move Map<string, i64> m) {
    return move m
}

i64 total(Map<string, i64> m) {
    var sum: i64 = 0
    for e in m { sum += e.value }
    return sum
}

void bump(ref Map<string, i64> m, at string key) {
    m[key] = m.getOr(key, 0) + 1
}

struct Counted {
    i64 n

    public Counted(ref Map<string, i64> m) {
        m["counted"] = 1
        this.n = m.length
    }
}

Result<Map<string, i64>, LookupError> found() => fresh(5, at: "r")

union error LookupError { missing }

var a = fresh(1, at: "x")
var b = Map<string, i64>()
b = fresh(2, at: "y")
var s = Store { name: "s", data: fresh(3, at: "z") }
s.data = fresh(4, at: "w")
let full = Slot.full(fresh(5, at: "v"))
var list = List<Map<string, i64>>()
list.append(fresh(6, at: "u"))
var nested = Map<i64, Map<string, i64>>()
nested[1] = fresh(7, at: "t")
var arr: Map<string, i64>[2] = [fresh(8, at: "q"), Map<string, i64>()]
let pair = (fresh(9, at: "p"), 1)
let o = Owned(fresh(10, at: "o"))
let r = found()
let maybe: Map<string, i64>? = fresh(11, at: "n")
let c = passThrough(fresh(12, at: "m"))

// Receivers, `for` sources, read-only and `ref` arguments, formatting.
a["x2"] = 2
s.data["z2"] = 30
arr[1]["k"] = 1
bump(ref a, at: "x")
bump(ref s.data, at: "z")
let counted = Counted(ref a)
print($"{counted.n} {a.length} {s.data.length} {arr[1].length} {o.value.length} {list[0].length}")
print($"{total(a)} {total(s.data)} {total(arr[0])} {total(o.value)} {total(pair.item1)}")
for e in s.data { print($"  {e.key} = {e.value}") }
for m in list { print($"list: {m}") }
print($"{a} {b} {c} {s} {pair}")
print($"{maybe} {r.value} {nested[1]}")
if full is .full(let d) { print($"full: {d.length}") }

struct Named {
    string name
    Map<i64, i64> m
}

let named = Named { name: "n", m: Map<i64, i64>() }
let renamed = named with { m: Map<i64, i64>() }
print($"{renamed.name} {renamed.m.length}")
