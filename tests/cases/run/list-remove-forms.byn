string show(List<i64> xs) {
    var line = StrBuf()
    for x in xs { line.append($" {x}") }
    return $"{xs.length}:{line.finish()}"
}

List<i64> make() {
    var xs = List<i64>()
    for i in 0..6 { xs.append(i * 10) }
    return xs
}

var through = make()
through.remove(from: 1, through: 3)
print($"through {show(through)}")

var last = make()
last.remove(from: 5, through: 5)
print($"last {show(last)}")

var at = make()
at.remove(at: 0)
at.remove(at: 4)
print($"at {show(at)}")

var exclusive = make()
exclusive.remove(at: 1..3)
print($"range {show(exclusive)}")

var inclusive = make()
inclusive.remove(at: 1..=3)
print($"inclusive {show(inclusive)}")

var held = make()
let r = 4..held.length
held.remove(at: r)
print($"held {show(held)}")
