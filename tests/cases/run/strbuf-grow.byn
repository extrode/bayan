i64 fill(ref StrBuf sb, to i64 n) {
    var sum: i64 = 0
    for i in 0..n {
        if i % 4 == 0 {
            sb.append("abc")
            sum += 3
        } else {
            sb.append($"{i % 10}")
            sum += 1
        }
    }
    return sum
}

void main() {
    {
        using let arena = Arena()
        provide allocator: arena {
            var sb = StrBuf()
            let sum = fill(ref sb, to: 100000)
            print($"{sb.length} {sum} {sb.length == sum}")
            print(sb.finish()[0..12])
            sb.clear()
            sb.append("again")
            print($"{sb.finish()} {sb.length}")
        }
    }
    var general = StrBuf()
    let sum = fill(ref general, to: 1000)
    print($"{general.length} {sum}")
}
