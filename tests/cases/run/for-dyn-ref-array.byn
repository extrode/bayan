// `for x: dyn ref readonly I in xs` over a fixed array converts each element.
interface IShape {
    i64 area()
}

struct Sq : IShape {
    i64 s
    i64 area() => s * s
}

let xs: Sq[2] = [Sq { s: 2 }, Sq { s: 3 }]
var sum = 0
for x: dyn ref readonly IShape in xs {
    sum += x.area()
}
print($"{sum}")
