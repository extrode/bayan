// mode: debug
// A `switch (move x)` binding is a fresh owner on every iteration: moving it again in the next one is legal.
union Slot {
    empty,
    full(List<i64> items),
}

void consume(move List<i64> xs) {
    print($"{xs.length}");
}

void main() {
    for (let i in 0..3) {
        var xs = List<i64>();
        for (let k in 0..i) xs.add(k);
        let s = Slot.full(move xs);
        switch (move s) {
            case .full(let items):
                consume(move items);
            default:
                print("empty");
        }
    }
    var j = 0;
    while (j < 2) {
        let s = Slot.full(List<i64>());
        let n = (move s) switch {
            .full(let items) => items.length,
            .empty => -1,
        };
        print($"{n}");
        j += 1;
    }
}
