// `for dyn ref readonly` reads through a `ReadOnlySpan`; a writable `for dyn ref` over a `Span` writes where the span points.
interface IC {
    void bump(ref this)
    i64 n { get }
}

struct C : IC {
    i64 n
    void bump(ref this) {
        n += 1
    }
}

void main() {
    var l = List<C>()
    l.append(C { n: 1 })
    l.append(C { n: 2 })
    let w: Span<C> = l.asSpan()
    for dyn ref IC x in w {
        x.bump()
    }
    let r: ReadOnlySpan<C> = l.asSpan()
    for dyn ref readonly IC x in r {
        print($"{x.n}")
    }
}
