// `Io.stdin.readAll()` returns the bytes as they arrive: CRLF stays, invalid UTF-8 is not checked.
let input = Io.stdin.readAll();
if !input.isOk {
    print("read failed");
} else {
    let text = input.value;
    print($"{text.bytes.count} bytes");
    i64 lines = 0;
    for b in text.bytes {
        if b == 0x0A { lines += 1; }
    }
    print($"{lines} lines, last byte {text.bytes[text.bytes.count - 1]}, third from last {text.bytes[text.bytes.count - 3]}");
}
