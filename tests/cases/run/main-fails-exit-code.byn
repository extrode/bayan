// A failing `main` exits with the variant's `[ExitCode(n)]`, or 1 without one.
error enum ConfigError {
    /// The configuration file is missing.
    missing
    /// The configuration is malformed.
    [ExitCode(3)]
    malformed
}

void load(bool broken) fails ConfigError {
    return .malformed if broken
}

void main() fails ConfigError {
    try load(broken: false)
    print("loaded once")
    try load(broken: true)
    print("not reached")
}
