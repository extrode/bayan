T echo<T>(move T x) => move x;

T pick<T>(bool first, move T a, move T b) => first ? move a : move b;

i64 sum(ReadOnlySpan<i64> xs) {
    var total = 0;
    var i = 0;
    while (i < xs.length) {
        total += xs[i];
        i = i + 1;
    }
    return echo(total);
}

u8 low(u8 b) => b;

var xs = List<i64>();
xs.add(3000000000);
xs.add(4000000000);
print($"{sum(xs)}");

var small = 7;
small += 1;
print($"{low(small)}");

var picked = 1;
print($"{echo(picked)}");
picked = picked * 2;
print($"{pick<i64>(first: true, a: picked, b: 2) + 5000000000}");

var k = 2147483647;
k = k +% 1;
print($"{k}");
