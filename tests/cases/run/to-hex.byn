let zero: i64 = 0
let small: i64 = 255
let big: i64 = 3735928559
print($"{zero.toHex()} {small.toHex()} {big.toHex()}")

let i8Max: i8 = 127
let i8Neg: i8 = -1
let i8Min: i8 = -128
print($"i8 {i8Max.toHex()} {i8Neg.toHex()} {i8Min.toHex()}")
let i16Max: i16 = 32767
let i16Neg: i16 = -2
print($"i16 {i16Max.toHex()} {i16Neg.toHex()}")
let i32Max: i32 = 2147483647
let i32Neg: i32 = -1
let i32Min: i32 = -2147483648
print($"i32 {i32Max.toHex()} {i32Neg.toHex()} {i32Min.toHex()}")
let i64Max: i64 = 9223372036854775807
let i64Neg: i64 = -1
let i64Min: i64 = -9223372036854775808
print($"i64 {i64Max.toHex()} {i64Neg.toHex()} {i64Min.toHex()}")
let isizeNeg: isize = -16
print($"isize {isizeNeg.toHex()}")

let u8Small: u8 = 10
let u8Max: u8 = 255
print($"u8 {u8Small.toHex()} {u8Max.toHex()}")
let u16Max: u16 = 65535
print($"u16 {u16Max.toHex()}")
let u32Max: u32 = 4294967295
print($"u32 {u32Max.toHex()}")
let u64Max: u64 = 18446744073709551615
print($"u64 {u64Max.toHex()}")
let usizeVal: usize = 4096
print($"usize {usizeVal.toHex()}")

using let arena = Arena()
provide allocator: arena {
    let hex = small.toHex()
    print($"arena {hex}")
}
