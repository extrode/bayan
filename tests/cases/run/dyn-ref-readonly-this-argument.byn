// Passing `this` as a `dyn ref readonly` changes nothing: a borrow of a field stays valid across the call.
interface ICount { i64 count(); }
struct B : ICount {
    List<i64> items;

    i64 count() => items.length;

    void run(ref this) {
        let s = items.asSpan();
        show(this);
        print($"{s[0]}");
    }
}

void show(dyn ref readonly ICount c) { print($"{c.count()}"); }

void main() {
    var b = B { items: List<i64>() };
    b.items.append(1);
    b.run();
}
