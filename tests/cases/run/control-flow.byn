i64 sum = 0;
for (let i in 0..5) {
    sum += i;
}
print($"sum {sum}");
for (let i in 1..=3) {
    print($"i {i}");
}
var n = 3;
while (n > 0) {
    n -= 1;
    continue if n == 1;
    print($"n {n}");
}
do {
    n += 1;
} while (n < 4);
print($"n {n}");
outer: for (let i in 0..4) {
    for (let j in 0..4) {
        continue outer if j > i;
        break outer if i == 3;
        print($"{i},{j}");
    }
}
i64[4] values = [4, 3, 2, 1];
for (let v in values) {
    print($"v {v}");
}
for (let ch in "héllo") {
    print($"{ch}");
}
if (sum > 100) {
    print("big");
} else if (sum > 5) {
    print("medium");
} else {
    print("small");
}
print(sum > 5 ? "yes" : "no");
