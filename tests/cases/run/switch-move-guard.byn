// mode: debug
// A `switch (move x)` arm whose guard or later subpattern fails gives up its bindings: a later arm binding the same
// storage owns it, with no second-owner panic from the debug-build checker.
union Slot {
    full(List<i64> items),
    empty,
}

struct Pair {
    List<i64> items;
    i64 n;
}

void main() {
    var a = List<i64>();
    a.append(1);
    let s = Slot.full(move a);
    switch move s {
        case .full(let x) when x.count > 5:
            print($"big {x.count}");
        case .full(let y):
            print($"small {y.count}");
        case .empty:
            print("empty");
    }

    var b = List<i64>();
    b.append(1);
    let t = Slot.full(move b);
    let n = (move t) switch {
        .full(let x) when x.count > 5 => x.count * 10,
        .full(let y) => y.count,
        .empty => 0,
    };
    print($"expression {n}");

    var c = List<i64>();
    c.append(1);
    c.append(2);
    let p = Pair { items: move c, n: 3 };
    switch move p {
        case { items: let x, n: 5 }:
            print($"five {x.count}");
        case { items: let y, n: _ }:
            print($"other {y.count}");
    }
}
