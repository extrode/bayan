// Writing a list element through `ref xs[i]` is not a structural change: allowed while the loop reads `xs`, as for an array.
void bump(ref i64 x) { x += 1 }

void main() {
    var xs = List<i64>()
    xs.append(1)
    xs.append(2)
    for x in xs {
        bump(ref xs[0])
    }
    var ys: i64[2] = [1, 2]
    for y in ys {
        bump(ref ys[0])
    }
    print($"{xs[0]} {ys[0]}")
}
