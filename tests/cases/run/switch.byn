string describe(i64 n) => n switch {
    < 0 => "negative",
    0 => "zero",
    1 or 2 => "small",
    >= 3 and < 10 => "medium",
    _ => "large",
}

for n in -1..12 {
    print($"{n} {describe(n)}")
}

void category(string s) {
    switch s {
        case "a" or "b":
            print("early")
        case let other when other.length > 3:
            print($"long {other}")
        default:
            print("other")
    }
}

category("a")
category("b")
category("hello")
category("z")

let maybe: i64? = 4
let missing: i64? = null
print(maybe switch { null => "none", let v => "some" })
let label = missing switch {
    null => "none",
    _ => "some",
}
print(label)
