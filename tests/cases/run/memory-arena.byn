struct Item {
    string name;
    i64 qty;
}

List<i64> squares(i64 n) {
    var xs = List<i64>();
    for (let i in 0..n) {
        xs.append(i * i);
    }
    return xs;
}

void main() {
    using var arena = Arena();
    context (allocator: arena) {
        var xs = squares(5);
        print($"{xs.count} {xs[4]} {xs.isEmpty}");
        xs.append(100);
        let last = xs.removeLast();
        print($"{last} {xs.count}");
        var items = List<Item>();
        items.append(Item { name = "pen", qty = 2 });
        items.append(Item { name = "ink", qty = 5 });
        i64 q = 0;
        for (let it in items) {
            q += it.qty;
        }
        print($"{items.count} {q} {items[1].name}");
        let copy = xs.asSpan()[1..3].copy(to: arena);
        print($"{copy.count} {copy[0]} {copy[1]}");
        xs.clear();
        print($"{xs.count} {copy.count}");
        let name = "temporary".copy(to: arena);
        print(name);
    }
    var many = List<i64>();
    for (let i in 0..1000) {
        many.append(i);
    }
    print($"{many.count} {many[999]}");
    arena.reset();
}
