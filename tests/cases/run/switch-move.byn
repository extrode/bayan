// `switch move x` moves `x` into the switch: the pattern bindings own their parts and may be moved or stored.
union Slot {
    empty,
    full(List<i64> items),
}

struct Holder {
    List<i64> items;
}

i64 keep(move List<i64> xs) {
    i64 total = 0;
    for x in xs { total += x; }
    return total;
}

i64 drain(move Slot slot) {
    switch move slot {
        case .full(let items):
            return keep(move items);
        default:
            return -1;
    }
}

void main() {
    var a = List<i64>();
    a.append(1);
    a.append(2);
    let s = Slot.full(move a);
    switch move s {
        case .full(var items):
            items.append(3);
            let h = Holder { items: move items };
            print($"stored {h.items.count}");
        case .empty:
            print("empty");
    }

    var b = List<i64>();
    b.append(4);
    print($"param {drain(Slot.full(move b))} {drain(Slot.empty)}");

    var c = List<i64>();
    c.append(5);
    c.append(6);
    let t = Slot.full(move c);
    let total = (move t) switch {
        .full(let items) => keep(move items),
        .empty => 0,
    };
    print($"expression {total}");

    let u = Slot.full(List<i64>());
    switch u {
        case .full(let items):
            print($"borrowed {items.count}");
        default:
    }
    switch move u {
        case .full(let items):
            print($"owned {keep(move items)}");
        default:
    }
}
