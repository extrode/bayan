// `switch (move x)` moves `x` into the switch: the pattern bindings own their parts and may be moved or stored.
union Slot {
    Empty,
    Full(List<i64> items),
}

struct Holder {
    List<i64> items;
}

i64 keep(move List<i64> xs) {
    i64 total = 0;
    for (let x in xs) total += x;
    return total;
}

i64 drain(move Slot slot) {
    switch (move slot) {
        case .Full(let items):
            return keep(move items);
        default:
            return -1;
    }
}

void main() {
    var a = List<i64>();
    a.add(1);
    a.add(2);
    let s = Slot.Full(move a);
    switch (move s) {
        case .Full(var items):
            items.add(3);
            let h = Holder { items = move items };
            print($"stored {h.items.length}");
        case .Empty:
            print("empty");
    }

    var b = List<i64>();
    b.add(4);
    print($"param {drain(Slot.Full(move b))} {drain(Slot.Empty)}");

    var c = List<i64>();
    c.add(5);
    c.add(6);
    let t = Slot.Full(move c);
    let total = (move t) switch {
        .Full(let items) => keep(move items),
        .Empty => 0,
    };
    print($"expression {total}");

    let u = Slot.Full(List<i64>());
    switch (u) {
        case .Full(let items):
            print($"borrowed {items.length}");
        default:
    }
    switch (move u) {
        case .Full(let items):
            print($"owned {keep(move items)}");
        default:
    }
}
