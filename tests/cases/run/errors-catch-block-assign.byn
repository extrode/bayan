error enum MkError { bad }

i32 mk(bool ok) fails MkError {
    return .bad if !ok
    return 7
}

void touch(bool ok) fails MkError {
    return .bad if !ok
}

i32 get(bool ok) {
    var failed = false
    let n = mk(ok) catch {
        failed = true
        return -1
    }
    return n
}

var hit = false
touch(ok: false) catch { hit = true }
print($"{get(ok: true)} {get(ok: false)} {hit}")
