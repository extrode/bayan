interface IStack {
    i64 count { get; }
    void push(ref this, i64 v);
    i64 top();
}

unique struct Stack : IStack {
    List<i64> items;

    i64 count => items.length;

    void push(ref this, i64 v) {
        items.add(v);
    }

    i64 top() => items[items.length - 1];
}

void fill(dyn ref IStack s) {
    s.push(1);
    s.push(2);
    s.push(3);
}

void report(dyn ref readonly IStack s) => print($"{s.count} items, top {s.top()}");

void main() {
    var s = Stack { items = List<i64>() };
    fill(s);
    report(s);
    fill(s);
    report(s);
    print($"still owned: {s.items.length}");
}
