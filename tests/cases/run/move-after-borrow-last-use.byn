// A value may be moved once every borrow into it has been used for the last time.
interface IThing {
    i64 get()
}

struct unique S : IThing {
    List<i64> xs

    i64 get() => xs[0]
}

void keep(move S s) {
    print($"kept {s.xs.length}")
}

void main() {
    var xs = List<i64>()
    xs.append(42)
    var s = S { xs: move xs }
    let d: dyn ref IThing = s
    let sp: ReadOnlySpan<i64> = s.xs.span
    print($"{d.get()} {sp[0]}")
    var t = move s
    t.xs.append(1)
    keep(move t)
    var ys = List<i64>()
    ys.append(7)
    let view: ReadOnlySpan<i64> = ys.span
    print($"{view[0]}")
    var zs = ys.take()
    zs.append(8)
    print($"{zs.length}")
}
