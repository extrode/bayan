struct Signup {
    string name
        requires it.runeCount >= 3
}

struct Address {
    string city
        requires it != ""
}

void register(string name, at string city) fails ValidationError<Signup>, ValidationError<Address> {
    let s = try Signup { name: name }
    let a = try Address { city: city }
    print($"registered {s.name} in {a.city}")
}

void attempt(string name, at string city) fails ValidationError<Address> {
    register(name, at: city) catch switch {
        ValidationError<Signup> e => print("signup rejected"),
        ValidationError<Address> e => fail e,
    }
}

void main() {
    attempt("ab", at: "Cairo") catch print("outer")
    attempt("amira", at: "") catch print("outer address")
}
