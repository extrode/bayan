<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bayan</AssemblyName>
    <RootNamespace>Bayan.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bayan.Syntax/Bayan.Syntax.csproj" />
    <ProjectReference Include="../Bayan.Semantics/Bayan.Semantics.csproj" />
    <ProjectReference Include="../Bayan.Lowering/Bayan.Lowering.csproj" />
    <ProjectReference Include="../Bayan.Backend.C/Bayan.Backend.C.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bayan.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/diagnostics/*.md" LogicalName="diagnostics/%(Filename).md" />
  </ItemGroup>
  <!-- The version line names the commit this was built from; "unknown" outside git. -->
  <Target Name="BayanBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short=12 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BayanCommit" />
      <Output TaskParameter="ExitCode" PropertyName="BayanGitExit" />
    </Exec>
    <PropertyGroup>
      <BayanCommit Condition="'$(BayanGitExit)' != '0'">unknown</BayanCommit>
      <BayanBuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BayanBuildInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(BayanBuildInfoFile)" Lines="namespace Bayan.Cli%3B;internal static class BuildInfo { public const string Commit = &quot;$(BayanCommit)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BayanBuildInfoFile)" />
      <FileWrites Include="$(BayanBuildInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
