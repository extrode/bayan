<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bayan</AssemblyName>
    <RootNamespace>Bayan.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bayan.Syntax/Bayan.Syntax.csproj" />
    <ProjectReference Include="../Bayan.Semantics/Bayan.Semantics.csproj" />
    <ProjectReference Include="../Bayan.Lowering/Bayan.Lowering.csproj" />
    <ProjectReference Include="../Bayan.Backend.C/Bayan.Backend.C.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bayan.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/diagnostics/*.md" LogicalName="diagnostics/%(Filename).md" />
  </ItemGroup>
</Project>
